+/*
+ * AFC patch: a thin scrollbar slider. If the window option @scrollbar-slider
+ * holds one single-width character (say U+2590 or U+2595), the slider is drawn
+ * as that character in the slider colour on the track colour, instead of a
+ * whole cell filled with the slider colour. Unset or unusable: stock tmux.
+ */
+static int
+redraw_scrollbar_slider_glyph(struct window_pane *wp, struct utf8_data *ud)
+{
+	struct options	*oo = wp->window->options;
+	const char	*s;
+	enum utf8_state	 more;
+
+	if (options_get(oo, "@scrollbar-slider") == NULL)
+		return (0);
+	s = options_get_string(oo, "@scrollbar-slider");
+	if (s == NULL || *s == '\0')
+		return (0);
+	if ((more = utf8_open(ud, (u_char)*s)) == UTF8_MORE) {
+		while (*++s != '\0' && more == UTF8_MORE)
+			more = utf8_append(ud, (u_char)*s);
+		if (more != UTF8_DONE)
+			return (0);
+	} else if ((u_char)*s >= 0x20 && (u_char)*s < 0x7f)
+		utf8_set(ud, *s);
+	else
+		return (0);
+	return (ud->width == 1);
+}
+
+/*
+ * AFC patch: stop the scrollbar short of the pane's bottom. The option
+ * @scrollbar-bottom-margin (pane, window or global window scope) is a number
+ * of rows at the bottom of the pane that the scrollbar leaves empty, so it
+ * ends above an agent's input box instead of running beside it. The track
+ * always keeps at least three rows. Also used by window-copy.c, so dragging
+ * the slider matches what is drawn.
+ */
+u_int	screen_redraw_scrollbar_margin(struct window_pane *, u_int);
+
+u_int
+screen_redraw_scrollbar_margin(struct window_pane *wp, u_int height)
+{
+	const char	*s, *errstr;
+	u_int		 m;
+
+	if (options_get(wp->options, "@scrollbar-bottom-margin") == NULL)
+		return (0);
+	s = options_get_string(wp->options, "@scrollbar-bottom-margin");
+	if (s == NULL)
+		return (0);
+	m = strtonum(s, 0, 1000, &errstr);
+	if (errstr != NULL || height <= 3)
+		return (0);
+	if (m > height - 3)
+		m = height - 3;
+	return (m);
+}
