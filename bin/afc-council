#!/usr/bin/env python3
"""afc-council: a group chat of every signed-in LLM and the agents you make, on the topic you raise.

Alt+K in the fleet opens it in a tab of its own, in the folder of the pane you were in: the tab is
dealt into an even grid, one pane per member (each its own scroll of the thread, a spinner while it
thinks), with this chat in a strip along the bottom where you type. Claude, Codex,
Gemini and Antigravity sit at the table (each on the account it starts on, `agents --accounts`, when
that account is signed in), and so does every agent you have made: a name, a persona, and the LLM
it runs on. Each member reads the whole thread before it speaks and is told to give its own honest,
raw take: no flattery, no hedging, disagree by name.

  You type             everyone answers (in the mode below)
  @gemini @skeptic …   only those answer; @all is everyone
  Enter on an empty line, or /again   another round on the same message: they answer each other

  /mode                switch between the two modes below (/order and /roast go straight to one);
                       Shift+Tab does it too, and Alt+P steps the permission: plan, edit, bypass
  /mode order          everyone answers at once (each its own take), then round the table one by one,
                       each speaking to the others' answers (the default)
  /mode roast          everyone gives a point at once, then they roast each other, round after round,
                       each answering what was just said about it, until you press Ctrl+C
  /rounds N            order mode: passes round the table after the answers (0 = until Ctrl+C or
                       everyone passes, the default; none = answers only); roast mode: roast rounds
                       per message (0 = until Ctrl+C, the default)
  /names model|llm     what an LLM goes by: the model it runs on (@opus, @gpt-6-astra; the default) or
                       its own name (@claude); agents with a character keep theirs. Kept per project
  /length N            answers of at most N words (default 60: two or three sentences); kept
  /topic TEXT          what the meeting is about (else your first message is)
  /agent new NAME LLM CHARACTER [|| SOUL || RULES]   make an agent (its soul, character, rules and memory
                       go in <project>/agents/NAME/, read before every answer; edit them there). LLM: claude | codex | gemini | agy, with an
                       account and a model if you like: claude@others:opus, codex:gpt-5.5
  /lean @name opposition|government|free   where a member stands (any member, an LLM's seat too; @all
                       for everyone): always against the chair, for the chair and its agenda, or no side
                       (free will, the default). Alt+M on its pane: O, G, F. /agent lean NAME … the same
  /agent power NAME remove [on|off]   let an agent remove members on its own judgement (it ends an
                       answer with "Remove: @name - why"): an agent is deleted and its memory wiped; an
                       LLM's own seat leaves the table
  /agent del NAME      remove one       /agents   who is at the table, and on what
  /bench NAME, /seat NAME   take a member off the table for now, or back (also an LLM: /seat agy)
  /remove all          everyone off the table, as ✕ on each would (+ add: Remove everyone…)
  /remove NAME         what ✕ on a member's header does: an agent you made is deleted for good (from
                       every council; + add makes a new one); an LLM's own seat is benched
  /model @name MODEL   the model that member runs on (@all for everyone; `default` to go back)
  /effort @name LEVEL  how hard it thinks: low medium high xhigh max (Codex: minimal..xhigh;
                       Gemini has no such setting, only the model). /model or /effort alone: who
                       runs on what. /models: the names to pick from. Kept for the next meeting.
  /perm plan|edit|bypass   what members may do in this folder: plan reads only (the default), edit
                       may change files but runs no command, bypass may do anything with no asking.
                       /perm @name … for one member (also in Alt+M on its pane); shown in the headers
  /view one|grid       one pane with everyone's answers (yours on the right), or one pane per member
                       (the default). Alt+O in the chat box switches; kept per project
  /grid on|off         one pane per member, each with its own scroll of the thread (on by itself
                       in the council's own tab); off: every answer in full in this pane
  /new [TOPIC]         a new meeting, in a folder of its own (the old one stays saved; Alt+T: what is typed is its
                       topic). A council opened in a folder carries on that folder's last meeting: everyone remembers it
  /resume              carry on an earlier meeting instead (a list; /resume N picks one)
  /retry [@name]       ask again a member whose run went wrong (all of those, without a name). A run
                       that goes wrong is told on the note line with what to do; twice in a row, a
                       pop-up asks: try again, change its model, take it off the table, or leave it
  /quit                leave (Ctrl+D too). Ctrl+C while they answer stops that round.

Members only read: files in this folder (and the web, where the LLM can), never a change. Each answer
is one non-interactive run of that LLM's own program, so it counts against that account's plan like
any chat. Before each run the fleet's memory walls are asked (`agents --room`); a member that would
not fit is skipped and the thread says why. Roast mode runs up to `parallel` members at once
(default 3).

Where it is kept. Each meeting is a folder of its own, made when the council opens and named by the
time and, from the first message, its topic: <project>/logs/council/<date>_<time>_<topic>/, with
thread.md to read and thread.json to carry it on (logs/council/ is ignored by git, like logs/acf). A
meeting nobody spoke in leaves no folder. A council about no project (Alt+Shift+K) keeps its meetings
in ~/Council/<date>_<time>_<topic>/, and its members work in that folder. Each project's settings
(mode, permission, models, efforts, who sits at the table) are its own: <project>/logs/council/
settings.json (~/Council/settings.json); a project's council starts read-only (plan), whatever another
project's is set to. Made agents are shared by every council: ~/.config/agents/council.json.

  afc-council [--dir FOLDER] [--from-pid PID]     the chat (Alt+K starts it with the pane's pid)
  afc-council --open <session> <pane pid>         what Alt+K runs: a new tab with the chat in it
  afc-council --general | --open-general <session>  a council about no project, in ~/Council (Alt+Shift+K)
"""
import contextlib
import json
import io
import os
import re
import shutil
import signal
import subprocess
import sys
# Line editing and history for input(). A Mac's own Pythons have libedit, which leaves the typing
# line with Tab only (no hooks, key macros played late): there it is GNU readline from pip's
# gnureadline, which _tools/mac-setup.sh installs. Without it, libedit and Tab (setup_typing).
try:
    import gnureadline as readline
    sys.modules["readline"] = readline      # so nothing imported later brings libedit back
except ImportError:
    import readline  # noqa: F401
import tempfile
import textwrap
import threading
import time
import traceback
import unicodedata

HOME = os.path.expanduser("~")
AGENTS = os.environ.get("AFC_COUNCIL_AGENTS") or os.path.join(HOME, ".local/bin/agents")
CONF = os.environ.get("AFC_COUNCIL_CONF") or os.path.join(HOME, ".config/agents/council.json")
GENERAL = os.environ.get("AFC_COUNCIL_GENERAL") or os.path.join(HOME, "Council")   # Alt+Shift+K: about no project
# Kept per project (in its council folder), not in CONF: what one project's council is set to never
# reaches another's (a Bypass in one leaves every other at Plan).
LOCAL = ("mode", "perm", "words", "llm", "seats", "agent_perm", "names", "view")
STAMP = re.compile(r"\d{4}-\d\d-\d\d_\d{4}(-\d+)?")      # a session folder not named by its topic yet
TOOLS = {"claude": "Claude", "codex": "Codex", "gemini": "Gemini", "agy": "Antigravity"}
NAMES = {"by": "model"}   # /names: a member that is not an agent with a character goes by its model (or "llm")
ALIAS = {"antigravity": "agy", "google": "gemini", "openai": "codex", "gpt": "codex", "anthropic": "claude"}
KEEP_CHARS = 60000          # the thread each member reads is cut to the newest this many characters
# What /effort takes per LLM (Gemini's command line has none: its model is the only setting), and
# models /models suggests (any name the LLM's own program takes is accepted; `agy models` lists more)
EFFORTS = {"claude": ["low", "medium", "high", "xhigh", "max"], "codex": ["minimal", "low", "medium", "high", "xhigh"],
           "gemini": [], "agy": ["low", "medium", "high", "xhigh", "max"]}
MODELS = {"claude": ["opus", "fable", "sonnet", "haiku", "claude-opus-5-5", "claude-fable-5-2", "claude-sonnet-5-5",
                     "claude-haiku-5-5", "claude-opus-4-8"],
          "codex": ["gpt-6-astra"],
          "gemini": ["gemini-4-argon", "gemini-4-carbon", "gemini-4-hydrogen", "gemini-3.8-flash"],
          "agy": ["gemini-4-neon-high", "gemini-4-argon-high", "gemini-4-hydrogen-high", "gemini-3.8-flash-high"]}
# Claude's short names stand for its newest models: the same model, so never two at the table
CLAUDE_ALIAS = {"claude-opus-5-5": "opus", "claude-fable-5-2": "fable", "claude-sonnet-5-5": "sonnet",
                "claude-haiku-5-5": "haiku"}
MODEL_KEYS = "123456789ijkpqsuvyz"   # menu keys for models (the letters the menus use for other things left out)


def canon(model):
    """A model's one name, to tell whether two members run the same model: Claude's alias for its full
    name, an effort in brackets or as a suffix taken off (Antigravity: "Gemini 4 Neon (XHigh)",
    "gemini-4-neon-high"). '' for a model not known."""
    if not model or model == "default model":
        return ""
    m = handle_of(re.sub(r"\s*\([^)]*\)\s*$", "", model))
    m = re.sub(r"-(minimal|low|medium|high|xhigh|max|ultra)$", "", m)
    return CLAUDE_ALIAS.get(m, m)


MODEL_CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "afc-council",
                           "models.json")


def version_key(model):
    """Newest first: the numbers in a model's name, biggest first (a date at the end left out)."""
    nums = [int(n) for n in re.findall(r"\d+", re.sub(r"-\d{8}$", "", model)) if len(n) < 5]
    return [-n for n in nums] + [0] * (4 - len(nums))


def models_for(tool, home=None):
    """Every model version that LLM can run, newest first, each once, for the menus. Each from that LLM's
    own word where it keeps one: Codex, the list its account shows (models_cache.json); Claude, the models
    its account knows (.claude.json); Antigravity, `agy models`; Gemini, the models its program names
    (those two read in the background when a council opens, see refresh_models). Else the list here."""
    found = []
    if tool == "codex":
        for h in [x for x in (home, os.path.join(HOME, ".codex")) if x]:
            d = read_json(os.path.join(h, "models_cache.json"))
            found = [m.get("slug") for m in (d.get("models") or [])
                     if isinstance(m, dict) and m.get("slug") and m.get("visibility", "list") == "list"]
            if found:
                return found
    elif tool == "claude":
        for f in [os.path.join(h, ".claude.json") for h in (home, os.path.dirname(home or "")) if h] + \
                [os.path.join(HOME, ".claude.json")]:
            ids = [k for k in (read_json(f).get("additionalModelCostsCache") or {}) if k.startswith("claude-")]
            if ids:
                fam = {"opus": 0, "fable": 1, "sonnet": 2, "haiku": 3}
                found = sorted(ids, key=lambda k: [fam.get(k.split("-")[1], 9)] + version_key(k))
                break
    else:
        found = read_json(MODEL_CACHE).get(tool) or []
        if tool == "gemini":
            found = sorted(set(found) | set(MODELS["gemini"]), key=lambda k: version_key(k) + [len(k)])
    out, seen = [], {}
    for m in found or MODELS.get(tool, []):
        c = canon(m)
        if c not in seen:
            seen[c] = len(out)
            out.append(m)
        elif tool == "agy" and m.endswith("-high"):        # Antigravity: each model once, at its high effort
            out[seen[c]] = m
    return out


def model_label(model):
    """How a model shows in the menus: Claude's short name beside its version."""
    a = CLAUDE_ALIAS.get(model)
    return f"{model}  ({a})" if a else model


def refresh_models():
    """When a council opens, in the background: the models Antigravity offers (`agy models`) and the ones
    the Gemini CLI names, kept in MODEL_CACHE for the menus, read again only when that program changed."""
    if os.environ.get("AFC_COUNCIL_NO_REFRESH"):       # the tests: never ask the real programs
        return
    data, changed = read_json(MODEL_CACHE), False
    agy = shutil.which("agy") or os.path.join(HOME, ".local/bin/agy")
    try:
        st = os.stat(agy)
        stamp = f"{st.st_mtime_ns}-{st.st_size}"
    except OSError:
        stamp = ""
    if stamp and data.get("agy_stamp") != stamp:
        try:
            out = subprocess.run([agy, "models"], capture_output=True, text=True, timeout=90,
                                 env=child_env()).stdout
            ids = [x.split("\t")[0].strip() for x in out.splitlines() if "\t" in x and x.split("\t")[0].strip()]
            if ids:
                data["agy"], data["agy_stamp"], changed = ids, stamp, True
        except (OSError, subprocess.TimeoutExpired):
            pass
    gem = shutil.which("gemini")
    bundle = os.path.dirname(os.path.realpath(gem)) if gem else ""
    try:
        stamp = str(os.stat(os.path.join(bundle, "gemini.js")).st_mtime_ns) if bundle else ""
    except OSError:
        stamp = ""
    if stamp and data.get("gemini_stamp") != stamp:
        names = set()
        for f in os.listdir(bundle):
            if f.endswith(".js"):
                try:
                    with open(os.path.join(bundle, f), errors="replace") as fh:
                        names |= set(re.findall(r'"(gemini-\d+(?:\.\d+)?-(?:pro|flash|flash-lite)(?:-preview)?)"',
                                                fh.read()))
                except OSError:
                    pass
        if names:
            data["gemini"], data["gemini_stamp"], changed = sorted(names), stamp, True
    if changed:
        try:
            write_json(MODEL_CACHE, data)
        except OSError:
            pass


SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"          # the thinking animation
MAX_SEATS = 9       # members at the table at once (a 3 x 3 grid)
CHAT_LINES = 4      # the chat box under the grid: what you type, and the thinking line
TMUXBIN = os.path.join(HOME, ".local/bin/tmux") if os.access(os.path.join(HOME, ".local/bin/tmux"), os.X_OK) else "tmux"
ME = os.path.join(HOME, ".local/bin/afc-council")
TTY = sys.stdout.isatty()
C = {"rule2": "38;5;110", "rule": "38;5;60", "chair": "1;37", "claude": "38;5;173", "codex": "38;5;114", "gemini": "38;5;75", "agy": "38;5;141",
     "agent": "38;5;221", "note": "38;5;244", "err": "38;5;203", "you": "38;5;252",
     # a member whose own colour is taken: cyan, pink, lime, tan, sky, peach, periwinkle, sea green
     "x1": "38;5;80", "x2": "38;5;211", "x3": "38;5;150", "x4": "38;5;180", "x5": "38;5;117", "x6": "38;5;216",
     "x7": "38;5;147", "x8": "38;5;72"}


def paint(text, kind):
    return f"\033[{C.get(kind, C['agent'])}m{text}\033[0m" if TTY else text


# The typing line's prompt. Its colour codes are wrapped in \001 … \002 so readline counts them as
# taking no room: without that it put the line's wrap 11 columns off, and typing past the edge (or
# backspacing back across it) scrambled the line and wiped the prompt.
PROMPT = f"\001\033[{C['chair']}m\002you> \001\033[0m\002"


INPUT = {"open": False}   # the typing line is waiting for you (the grid: rounds run meanwhile)
# The grid's chat box, drawn like Claude Code's: a rule, the "> " line, a rule, and one line for notes.
# What you send is not kept on it (it is in the members' panes); it is drawn afresh for each message.
BOX = {"on": False, "note": ""}
BOXPROMPT = "\001\033[38;5;111m\002> \001\033[0m\002"


def fit(text, n):
    t = " ".join(ANSI.sub("", text).split())
    return t if len(t) <= n else t[:max(0, n - 1)] + "…"


# The box grows with what you type: a line that is full goes on to the next one, and the pane is made
# taller to hold it (up to TYPE_MAX lines), as Claude Code's does. The lines you type on are the
# terminal's scrolling region, so text never runs over the rules or the note line. When the pane
# changes size, the box is drawn again and readline puts the line back from its start (its own redraw
# after a resize starts on the line's last row and walked the text down the box).
TYPE_MAX = 8
NOTE_ROW = lambda: BOX.get("rows", 1) + 3      # noqa: E731  (rule, the typing rows, rule, note)


def rl_lib():
    """GNU readline's own functions, for drawing the line again from its start; None where there is
    no GNU readline (a Mac's libedit): there the box stays one line."""
    if "libedit" in (readline.__doc__ or ""):
        return None
    try:
        import ctypes
        lib = ctypes.CDLL(readline.__file__)
        lib.rl_forced_update_display, lib.rl_set_screen_size     # both there, or no growing
        return lib
    except (OSError, AttributeError, ImportError):
        return None


RL = [None]
CRASHLOG = [None]


def draw_frame():
    """The box's rules and note line again (the pane changed size), the line being typed left alone."""
    cols = max(20, shutil.get_terminal_size((80, 4)).columns)
    BOX["cols"] = cols
    rule = paint("─" * cols, "rule")
    r = BOX.get("rows", 1)
    sys.stdout.write("\0337\033[1;1H\033[K" + rule + f"\033[{r + 2};1H\033[K" + rule + f"\033[{r + 3};1H\033[K" +
                     paint(fit(BOX["note"], cols - 1), "note") + "\0338")
    sys.stdout.flush()


def draw_box():
    if FEED["grid"] and GRID[0] and GRID[0].me and shutil.get_terminal_size((80, 4)).lines != CHAT_LINES:
        BOX.pop("asked", None)
        tmx("resize-pane", "-t", GRID[0].me, "-y", str(CHAT_LINES))     # back to one line to type on
    cols = max(20, shutil.get_terminal_size((80, 4)).columns)
    BOX["cols"], BOX["rows"] = cols, 1
    rule = paint("─" * cols, "rule")
    sys.stdout.write("\033[r\033[2J\033[H" + rule + "\n\n" + rule + "\n" + paint(fit(BOX["note"], cols - 1), "note") +
                     "\033[2;1H")
    sys.stdout.flush()


def typed_rows():
    """How many lines what is being typed takes ("> " and the text, wide characters counting two),
    with a few columns to spare so the next line is there before the text reaches it."""
    cols = BOX.get("cols") or 80
    w = 2 + sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in readline.get_line_buffer())
    return max(1, min(TYPE_MAX, (w + 3) // cols + 1))


def grow():
    """From the animation thread: ask tmux for the height the typing needs (the resize comes back as
    SIGWINCH, and relayout draws the box)."""
    if not (RL[0] and BOX["on"] and INPUT.get("rl") and FEED["grid"] and GRID[0] and GRID[0].me):
        return
    want = typed_rows()
    if want != BOX.get("rows", 1) and want != BOX.get("asked"):
        BOX["asked"] = want
        tmx("resize-pane", "-t", GRID[0].me, "-y", str(want + 3))


def errlog(what):
    """Something went wrong where it cannot be shown (a signal handler, the typing line): kept in
    $XDG_RUNTIME_DIR/afc-council/errors.log with its traceback, and said on the note line."""
    try:
        d = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "afc-council")
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "errors.log"), "a") as f:
            f.write(f"--- {time.strftime('%Y-%m-%d %H:%M:%S')} pid {os.getpid()}: {what}\n{traceback.format_exc()}\n")
    except OSError:
        pass


def in_callback(fn):
    """readline calls this Python function in the middle of its own work (completing, listing, before
    the line): a resize that comes meanwhile waits until readline is idle again (see relayout)."""
    def run(*args):
        INPUT["cb"] = INPUT.get("cb", 0) + 1
        try:
            return fn(*args)
        finally:
            INPUT["cb"] -= 1
    return run


def relayout(sig=None, frame=None):
    """SIGWINCH while you type in the box (run between keystrokes, in the main thread): the box drawn
    for the pane's new size, and readline's line put back from the box's first typing row. Never
    while readline is running one of our callbacks (calling back into it there could break it): then
    it is left for the animation thread to signal again. Nothing it does may raise into input()."""
    if not (BOX["on"] and INPUT.get("rl") and TTY):
        return
    if INPUT.get("cb"):
        BOX["relayout"] = True
        return
    try:
        relayout_()
    except Exception:  # noqa: BLE001
        errlog("redrawing the chat box")


def relayout_():
    size = shutil.get_terminal_size((80, 4))
    cols, h = max(20, size.columns), max(4, size.lines)
    r = max(1, min(TYPE_MAX, h - 3))
    BOX["cols"], BOX["rows"] = cols, r
    BOX.pop("asked", None)           # what was asked for has come (or the size changed some other way)
    rule = paint("─" * cols, "rule")
    with LOCK:
        out = "\033[r\033[2J\033[1;1H" + rule + f"\033[{r + 2};1H" + rule + f"\033[{r + 3};1H" + \
            paint(fit(BOX["note"], cols - 1), "note")
        if r > 1:
            out += f"\033[2;{r + 1}r"                    # the typing rows scroll by themselves
        sys.stdout.write(out + "\033[2;1H")
        sys.stdout.flush()
        if RL[0]:
            RL[0].rl_set_screen_size(h, cols)
            RL[0].rl_forced_update_display()


def say(text):
    """A note while you type: on the chat box's note line (the grid), or above the typing line,
    which is put back as it was (what you had typed included)."""
    with LOCK:
        if INPUT["open"] and TTY and BOX["on"]:
            BOX["note"] = ANSI.sub("", text).strip()
            cols = max(20, shutil.get_terminal_size((80, 4)).columns)
            sys.stdout.write(f"\0337\033[{NOTE_ROW()};1H\033[K" + paint(fit(BOX["note"], cols - 1), "note") + "\0338")
            sys.stdout.flush()
        elif INPUT["open"] and TTY:
            sys.stdout.write("\r\033[K" + text + "\n" + paint("you> ", "chair") + readline.get_line_buffer())
            sys.stdout.flush()
        else:
            print(text, flush=True)


# ---- what you can type: / lists the commands, @ the members, as soon as you type it -----------------------
COMMANDS = ["/mode", "/roast", "/order", "/rounds", "/names", "/length", "/topic", "/model", "/effort", "/models", "/agents",
            "/agent", "/remove", "/bench", "/seat", "/view", "/lean", "/new", "/resume", "/retry", "/perm", "/again", "/grid", "/help", "/quit"]
TABLE = [None]          # the meeting, for the @ names


def matches(text, first):
    if text.startswith("/") and first:
        return [c for c in COMMANDS if c.startswith(text.lower())]
    if text.startswith("@") and TABLE[0]:
        m = TABLE[0]
        names = ["@" + x.shown() for x in m.seated()] + ["@all"] + ["@" + x.shown() for x in m.members if not x.seated]
        return [n for n in names if n.startswith(text.lower())]
    return []


@in_callback
def completer(text, state):
    found = matches(text, readline.get_begidx() == 0)
    if len(found) == 1 and BOX["on"]:
        # readline prints a lone match itself, under the line (no hook): give it two that read the
        # same, so it goes to the note line; Tab still completes the word
        found = [found[0], found[0] + " "]
    if state == 0 and not found and BOX["on"] and BOX.get("listing"):
        show_note(BOX["note"])               # the word under the cursor is no longer a / or @ one
        BOX["listing"] = False
    return found[state] if state < len(found) else None


def show_note(text):
    """Write the chat box's note line without touching the line being typed."""
    cols = max(20, shutil.get_terminal_size((80, 4)).columns)
    sys.stdout.write(f"\0337\033[{NOTE_ROW()};1H\033[K" + paint(fit(text, cols - 1), "note") + "\0338")
    sys.stdout.flush()


@in_callback
def list_matches(substitution, found, longest):
    """readline's list of matches, drawn on the note line instead of under the prompt (the box has
    one line to type in)."""
    BOX["listing"] = True
    cols = max(20, shutil.get_terminal_size((80, 4)).columns)
    shown = list(dict.fromkeys(f.strip() for f in found))
    sys.stdout.write(f"\0337\033[{NOTE_ROW()};1H\033[K" + paint(fit("  ".join(shown), cols - 1), "rule2") + "\0338")
    sys.stdout.flush()


KEY_VIEW = "#!#%#"                                         # Alt+O: one view for everyone, or one pane each
KEY_MODE, KEY_PERM, KEY_NEW = "#!#~#", "#!#^#", "#!#=#"   # what Shift+Tab and Alt+P put in front of the line (no letters: those
                                           # are bound to the / and @ lists)
PENDING = {"text": ""}


@in_callback
def give_back():
    """After a shortcut: what you had typed is put back on the line. (Also: readline now waits for
    typing, so a resize may draw the box and the line again.)"""
    INPUT["rl"] = True
    if PENDING["text"]:
        readline.insert_text(PENDING["text"])
        PENDING["text"] = ""
        readline.redisplay()


def setup_typing():
    """Tab completes / commands and @ names. In the grid's chat box, / and @ (and every letter after
    them, and Backspace) also list what matches at once on the note line."""
    readline.set_completer(completer)
    readline.set_completer_delims(" \t\n")
    if "libedit" in (readline.__doc__ or ""):      # a Mac's own Python: editline, Tab only
        readline.parse_and_bind("bind ^I rl_complete")
        return
    readline.parse_and_bind("tab: complete")
    readline.parse_and_bind("set bell-style none")
    # Home, End and Delete as tmux sends them. Linux binds these in /etc/inputrc; a Mac has none, so
    # under a TERM whose terminfo names other codes (xterm-256color, Terminal.app's) Home typed a ~
    for k, f in (("\\e[1~", "beginning-of-line"), ("\\e[4~", "end-of-line"), ("\\e[3~", "delete-char"),
                 ("\\e[7~", "beginning-of-line"), ("\\e[8~", "end-of-line"),
                 ("\\e[H", "beginning-of-line"), ("\\e[F", "end-of-line"),
                 ("\\eOH", "beginning-of-line"), ("\\eOF", "end-of-line")):
        readline.parse_and_bind(f'"{k}": {f}')
    # Shift+Tab switches the mode, Alt+P cycles the permission: the key sends the line with a marker
    # in front (no key reaches Python by itself); the chat loop acts on it and gives the line back
    readline.parse_and_bind('"\\e[Z": "\\C-a' + KEY_MODE + '\\C-m"')
    readline.parse_and_bind('"\\ep": "\\C-a' + KEY_PERM + '\\C-m"')
    readline.parse_and_bind('"\\et": "\\C-a' + KEY_NEW + '\\C-m"')      # Alt+T: a new topic (what is typed names it)
    readline.parse_and_bind('"\\eo": "\\C-a' + KEY_VIEW + '\\C-m"')      # Alt+O: one view / one pane each
    readline.set_pre_input_hook(give_back)
    if BOX["on"]:
        readline.set_completion_display_matches_hook(list_matches)
        keys = "/@abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_."
        for k in keys:
            readline.parse_and_bind(f'"{k}": "\\C-v{k}\\e?"')    # quoted-insert: not this binding again
        readline.parse_and_bind('"\\C-?": "\\C-h\\e?"')


def boxed(fn, *args):
    """Run fn with what it prints caught: one line goes on the chat box's note line, more open in a
    pop-up (/help, /agents, /models), so the box stays one line to type in."""
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        result = fn(*args)
    text = buf.getvalue().rstrip()
    lines = [l for l in ANSI.sub("", text).split("\n") if l.strip()]
    if len(lines) <= 1:
        BOX["note"] = lines[0].strip() if lines else BOX["note"]
    else:
        d = os.path.dirname(FEED["path"]) or tempfile.gettempdir()
        path = os.path.join(d, f"popup-{os.getpid()}.txt")
        with open(path, "w") as f:
            f.write(text + "\n")
        if subprocess.run([TMUXBIN, "display-popup", "-E", "-w", "90%", "-h", "75%", "-T", " council ",
                           f"less -R +g {path}"], capture_output=True).returncode != 0:
            BOX["note"] = lines[0].strip() + " …"
    return result


def note(text):
    if INPUT["open"]:
        say(paint(f"  {text}", "note"))
    else:
        print(paint(f"  {text}", "note"), flush=True)


# ---- settings and made agents ------------------------------------------------------------------------
def read_json(path):
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def write_json(path, d):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".new"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
    os.replace(tmp, path)


def council_home(owner):
    """Where a folder's council keeps its settings and its meetings: <folder>/logs/council, or ~/Council
    itself for the councils about no project."""
    try:
        if os.path.realpath(owner) == os.path.realpath(GENERAL):
            return GENERAL
    except OSError:
        pass
    return os.path.join(owner, "logs", "council")


def load_conf(home=None, owner=None):
    """The shared settings (made agents, parallel, timeout) with this project's own on top (LOCAL). A
    project with none yet starts from what the shared file had (mode, models, efforts, answer length,
    and who sat at the table in that folder), never from its permissions: it starts at Plan."""
    d = read_json(CONF)
    fresh = False
    if home:
        local = read_json(os.path.join(home, "settings.json"))
        fresh = not local
        if fresh:
            llm = {t: {k: v for k, v in (st or {}).items() if k != "perm"} for t, st in (d.get("llm") or {}).items()}
            local = {"mode": d.get("mode"), "words": d.get("words"), "names": d.get("names"),
                     "llm": {t: st for t, st in llm.items() if st},
                     "seats": (d.get("seats") or {}).get(owner or "", {})}
            local = {k: v for k, v in local.items() if v not in (None, {}, "")}
        for k in LOCAL:
            d.pop(k, None)
        d.update({k: v for k, v in local.items() if k in LOCAL})
        d["_home"] = home
    d.setdefault("agents", [])
    d.setdefault("parallel", 0)
    d.setdefault("timeout", 300)
    d.setdefault("mode", "order")
    if fresh:     # written at once: this project's own from now on, whatever the shared file says later
        write_json(os.path.join(home, "settings.json"), {k: d[k] for k in LOCAL if k in d})
    return d


def save_conf(d):
    """This project's settings to its own file; the rest (made agents, parallel, timeout) to the shared
    one, whose mode, models and efforts stay as they were: what a new project's council starts from."""
    home = d.get("_home")
    if not home:
        write_json(CONF, {k: v for k, v in d.items() if not k.startswith("_")})
        return
    write_json(os.path.join(home, "settings.json"), {k: d[k] for k in LOCAL if k in d})
    shared = read_json(CONF)
    shared.update({k: v for k, v in d.items() if k not in LOCAL and not k.startswith("_")})
    shared.pop("perm", None)                   # permissions are only ever a project's own now
    for st in (shared.get("llm") or {}).values():
        if isinstance(st, dict):
            st.pop("perm", None)
    write_json(CONF, shared)


def handle_of(name):
    return re.sub(r"[^a-z0-9_-]+", "-", name.lower()).strip("-") or "agent"


def parse_llm(spec):
    """claude | claude@account | claude:model | claude@account:model:effort -> (tool, account, model, effort)"""
    m = re.fullmatch(r"([A-Za-z]+)(?:@([\w.-]+))?(?::([^:\s]+))?(?::(\w+))?", spec or "")
    if not m:
        return None
    tool = ALIAS.get(m[1].lower(), m[1].lower())
    if tool not in TOOLS or (m[4] and m[4] not in EFFORTS[tool]):
        return None
    return tool, m[2], m[3], m[4]


# ---- the fleet's accounts ------------------------------------------------------------------------------
def accounts():
    """{tool: (account, signed_in)} for the account each tool starts on (the * lines)."""
    out = {}
    try:
        text = subprocess.run([AGENTS, "--accounts"], capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.TimeoutExpired):
        return out
    for line in text.splitlines():
        m = re.match(r"^\* (\S+)\s+(\S+)\s+(.*?)\s+(/\S.*)$", line)
        if m and m[1] in TOOLS:
            out[m[1]] = (m[2], m[3].strip() != "not signed in", m[4].strip())
    return out


def defaults(tool, folder):
    """(model, effort) the LLM uses when the council sets none, read from that account's own
    settings; None where they set nothing (the LLM's built-in default then)."""
    def js(path):
        try:
            with open(path) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}
    if not folder:
        return None, None
    if tool == "claude":
        d = js(os.path.join(folder, "settings.json"))
        return d.get("model") or None, d.get("effortLevel") or None
    if tool == "codex":
        try:
            with open(os.path.join(folder, "config.toml")) as f:
                text = f.read()
        except OSError:
            return None, None
        top = text.split("\n[", 1)[0]          # only the keys above the first [table]
        mo = re.search(r'^\s*model\s*=\s*"([^"]+)"', top, re.M)
        ef = re.search(r'^\s*model_reasoning_effort\s*=\s*"([^"]+)"', top, re.M)
        return (mo[1] if mo else None), (ef[1] if ef else None)
    if tool == "gemini":
        d = js(os.path.join(folder, ".gemini", "settings.json")).get("model")
        return (d.get("name") if isinstance(d, dict) else d) or None, None
    d = js(os.path.join(folder, ".gemini", "antigravity-cli", "settings.json")).get("model")
    return (d if isinstance(d, str) else None), None


class Member:
    def __init__(self, name, tool, account=None, model=None, persona="", made=False, effort=None, folder=None):
        self.name, self.tool, self.account, self.model, self.effort = name, tool, account, model, effort
        self.persona, self.made = persona, made
        self.handle = handle_of(name) if made else tool
        self.seated = True
        self.perm = None            # plan, edit or bypass for this member; None = the council's
        self.home = folder           # its account's folder (Codex's model list is in it)
        self.default_model, self.default_effort = defaults(tool, folder)

    def runs_on(self):
        """(model, effort) as it will run: what was set here, else the account's own setting, else
        the LLM's default. Effort is '' for an LLM that has no such setting (Gemini)."""
        model = self.model or self.default_model or "default model"
        if not EFFORTS[self.tool]:
            return model, ""
        if self.tool == "agy" and "(" in model:      # its model names carry an effort: "Gemini 4 Neon (XHigh)"
            if not self.effort:
                return model, ""
            model = re.sub(r"\s*\([^)]*\)\s*$", "", model)   # the effort set here is the one it runs at
        return model, (self.effort or self.default_effort or "default")

    def full_model(self):
        """The model it runs on as a tag ("gpt-6-astra"); '' if unknown."""
        model = self.runs_on()[0]
        if not model or model == "default model":
            return ""
        return handle_of(re.sub(r"\s*\([^)]*\)\s*$", "", model))

    def model_slug(self):
        """The model's own name, without its family or version: gpt-6-astra -> astra, gemini-4-carbon
        -> carbon, Gemini 4 Neon -> neon, claude-opus-5-5 -> opus; '' if the model is unknown."""
        model = self.runs_on()[0]
        if not model or model == "default model":
            return ""
        base = re.sub(r"\s*\([^)]*\)\s*$", "", model)
        for w in re.split(r"[^a-z0-9.]+", base.lower()):
            if w and w not in FAMILY and not re.search(r"\d", w):
                return w
        return handle_of(base)

    def by_model(self):
        """True when it goes by its model: /names model (the default), not an agent with a character
        of its own, and its model known."""
        return NAMES["by"] == "model" and not (self.made and self.persona) and bool(self.model_slug())

    def shown(self):
        """The name it goes by at the table (what the panes show, what the others call it, what you tag)."""
        t = TABLE[0]
        return table_names(t.members if t else [self]).get(self.handle, self.handle)

    def label(self):
        if self.by_model():
            bits = [b for b in (self.effort,) if b]
        else:
            bits = ([TOOLS[self.tool]] if self.made else []) + [b for b in (self.model, self.effort) if b]
        return f"@{self.shown()}" + (f" ({', '.join(bits)})" if bits else "")

    def own_colour(self):
        return "agent" if self.made and self.persona else self.tool     # an extra seat: its LLM's colour

    def colour(self):
        """Its colour at this table: its own, or the next free one when another member has that already
        (a second Claude is not orange too)."""
        t = TABLE[0]
        return table_colours(t.members if t else [self]).get(self.handle, self.own_colour())


# The model's family and maker: not part of the name a member goes by (gpt-6-astra goes by astra)
FAMILY = {"claude", "anthropic", "gpt", "openai", "codex", "gemini", "google", "antigravity", "agy", "models",
          "model", "latest", "preview", "exp", "chat"}
EXTRA = ["x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8"]     # colours for a member whose own is taken


# ---- an agent's lean: where it stands toward the chair ---------------------------------------------------
LEANS = {
    "opposition": "Your lean: OPPOSITION. You always oppose the chair: find what is wrong, weak or risky in what the "
                  "chair says and wants, and argue against it, honestly (facts and reasons, never insults).",
    "government": "Your lean: GOVERNMENT. You stand with the chair and the chair's agenda: argue for it, strengthen "
                  "it and defend it against the others, while staying honest about the facts.",
    "free": "Your lean: FREE WILL. You take no side: weigh every argument, the chair's included, on its merits.",
}
LEAN_WORDS = {"1": "opposition", "opposition": "opposition", "opp": "opposition", "against": "opposition",
              "2": "government", "government": "government", "gov": "government", "for": "government",
              "3": "free", "free": "free", "free-will": "free", "freewill": "free", "none": "free", "neutral": "free"}
LEAN_SHOWN = {"opposition": "opposition", "government": "government", "free": "free will"}


def lean_of(word):
    return LEAN_WORDS.get((word or "").strip().lower().replace(" ", "-"), "")


# ---- an agent's own folder in each project: its soul, character, rules and memory -----------------------
AGENT_MARK = ".council-agents"     # in the agents folder: it is the council's (a project's own agents/ is left alone)


def agents_dir(owner):
    """<project>/agents, the council's folder of agents for that project; council-agents/ instead when the
    project has an agents/ of its own (its code, not the council's)."""
    d = os.path.join(owner, "agents")
    if os.path.isdir(d) and not os.path.exists(os.path.join(d, AGENT_MARK)) and os.listdir(d):
        d = os.path.join(owner, "council-agents")
    return d


def agent_dir(owner, name):
    return os.path.join(agents_dir(owner), handle_of(name))


def ensure_agent(owner, name, character="", soul="", rules=""):
    """The agent's folder in this project, made if it is not there: SOUL.md, CHARACTER.md, RULES.md (edit
    them: the agent reads them before every answer) and MEMORY.md (what it chose to keep here). Files
    there are never overwritten."""
    top, d = agents_dir(owner), agent_dir(owner, name)
    try:
        os.makedirs(d, exist_ok=True)
        if not os.path.exists(os.path.join(top, AGENT_MARK)):
            open(os.path.join(top, AGENT_MARK), "w").close()
            with open(os.path.join(top, "README.md"), "w") as f:
                f.write("# Council agents of this project\n\nOne folder per agent made in the council (afc-council). "
                        "SOUL.md, CHARACTER.md and RULES.md are read by the agent before every answer: edit them "
                        "and it changes. MEMORY.md is what the agent chose to keep from meetings here (its "
                        "'Remember:' lines); edit or clear it freely.\n")
        files = {
            "SOUL.md": (f"# Soul of {name}\n\n" + (soul.strip() or f"<!-- What {name} cares about most: the values it "
                        "never drops, whatever the topic. Write it here. -->") + "\n"),
            "CHARACTER.md": (f"# Character of {name}\n\n" + (character.strip() or f"<!-- Who {name} is and how it "
                             "talks. -->") + "\n"),
            "RULES.md": (f"# Rules of {name}\n\n" + (rules.strip() or f"<!-- What {name} must always or never do, one "
                         "per line. -->") + "\n"),
            "MEMORY.md": (f"# Memory of {name} in {os.path.basename(owner) or owner}\n\n<!-- What {name} asked to keep "
                          "(its 'Remember:' lines), newest last. Edit or clear freely. -->\n"),
        }
        for f, text in files.items():
            if not os.path.exists(os.path.join(d, f)):
                with open(os.path.join(d, f), "w") as fh:
                    fh.write(text)
    except OSError:
        pass
    return d


def agent_text(d, f, last=None):
    """A file of the agent's folder as the agent reads it: headings and <!-- notes --> left out."""
    try:
        with open(os.path.join(d, f)) as fh:
            text = fh.read()
    except OSError:
        return ""
    text = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    lines = [x for x in text.split("\n") if not x.startswith("# ")]
    if last:
        lines = [x for x in lines if x.strip()][-last:]
    return "\n".join(lines).strip()


def remember(d, facts):
    """An agent's 'Remember:' lines, added to its MEMORY.md with the date."""
    try:
        with open(os.path.join(d, "MEMORY.md"), "a") as f:
            for x in facts:
                f.write(f"- {time.strftime('%Y-%m-%d')}: {x}\n")
    except OSError:
        pass


def table_names(members):
    """Every member's name at the table, none twice: an agent with a character, and a member whose model
    is not known, keep their own; the rest go by their model, numbered when two share it (astra, astra2)."""
    out, used = {}, set()
    # those at the table first: one that left keeps no name from them (a new opus is @opus, not @opus2)
    members = [m for m in members if m.seated] + [m for m in members if not m.seated]
    for m in members:
        if not m.by_model():
            out[m.handle] = m.handle
            used.add(m.handle)
    words = {}
    for m in members:
        if m.handle not in out and m.seated:
            words.setdefault(m.model_slug(), set()).add(canon(m.runs_on()[0]))
    for m in members:
        if m.handle in out:
            continue
        w = n = m.model_slug()
        if len(words.get(w, ())) > 1:         # gpt-6.2-sol and gpt-6-sol: sol-6.2 and sol-6
            ver = ".".join(t for t in re.split(r"[^a-z0-9.]+", m.runs_on()[0].lower()) if re.search(r"\d", t))
            n = f"{w}-{ver}" if ver else w
        k, base = 2, n
        while n in used:
            n, k = f"{base}{k}", k + 1
        out[m.handle] = n
        used.add(n)
    return out


def table_colours(members):
    """Every member's colour, none twice, in table order: its own if free, else the next free one (those
    at the table first, so one that left keeps none of theirs)."""
    out, used = {}, set()
    for m in [m for m in members if m.seated] + [m for m in members if not m.seated]:
        k = m.own_colour()
        if k in used:
            k = next((x for x in EXTRA if x not in used), k)
        out[m.handle] = k
        used.add(k)
    return out


# ---- running one member ------------------------------------------------------------------------------
RUNNING = {}              # process groups of members at work -> whose, for Ctrl+C and /bench
LOCK = threading.Lock()


def child_env():
    env = dict(os.environ)
    for k in list(env):     # a run started from inside an agent must not look like part of that agent
        if k in ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_SSE_PORT") or k.startswith("CLAUDE_CODE_SESSION"):
            env.pop(k)
    env["NO_COLOR"] = "1"
    return env


PERMS = ("plan", "edit", "bypass")
PERM_TEXT = {
    "plan": "You may read files in the current folder (and the web) to ground what you say, but you change "
            "nothing and run nothing.",
    "edit": "You may read files and, when the chair asks for it, edit files in the current folder; you do not "
            "run commands. Say in one line which files you changed.",
    "bypass": "You may read, edit and run commands in the current folder to do what the chair asks. Other members "
              "may be working in the same folder at the same time: keep changes small, look before you overwrite, "
              "and say in one line what you changed or ran.",
}


def command(m, prompt, folder, perm="plan"):
    """argv, stdin text, and a file the answer is read from instead of stdout (Codex). perm: plan
    (read-only), edit (may change files, no commands) or bypass (anything, no asking)."""
    acct = m.account
    if m.tool == "claude":
        argv = [AGENTS, "--as", acct, "-p", "--no-session-persistence", "--output-format", "text"]
        if perm == "bypass":
            argv += ["--permission-mode", "bypassPermissions"]
        elif perm == "edit":
            argv += ["--permission-mode", "acceptEdits",
                     "--allowedTools", "Read", "Grep", "Glob", "Edit", "Write", "MultiEdit", "WebSearch", "WebFetch",
                     "--disallowedTools", "Bash"]
        else:
            argv += ["--allowedTools", "Read", "Grep", "Glob", "WebSearch", "WebFetch",
                     "--disallowedTools", "Bash", "Edit", "Write", "NotebookEdit"]
        if m.model:
            argv += ["--model", m.model]
        if m.effort:
            argv += ["--effort", m.effort]
        return argv, prompt, None
    if m.tool == "codex":
        fd, out = tempfile.mkstemp(prefix="afc-council-", suffix=".txt")
        os.close(fd)
        mode = (["--dangerously-bypass-approvals-and-sandbox"] if perm == "bypass" else
                ["--sandbox", "workspace-write" if perm == "edit" else "read-only"])
        argv = [AGENTS, "--as", f"codex:{acct}", "exec", *mode, "--skip-git-repo-check",
                "--ephemeral", "--color", "never", "-C", folder, "-o", out]
        if m.model:
            argv += ["-m", m.model]
        if m.effort:
            argv += ["-c", f'model_reasoning_effort="{m.effort}"']
        return argv + ["-"], prompt, out
    if m.tool == "gemini":
        argv = [AGENTS, "--as", f"gemini:{acct}", "--approval-mode",
                {"bypass": "yolo", "edit": "auto_edit"}.get(perm, "plan"), "--skip-trust",
                "-p", "Answer as the text above asks."]
        if m.model:
            argv += ["-m", m.model]
        return argv, prompt, None
    # plan = read-only. Not with --disable-slash-commands: Antigravity ignores --mode then (our prompts
    # never start with a slash anyway)
    mode = (["--dangerously-skip-permissions"] if perm == "bypass" else
            ["--mode", "accept-edits" if perm == "edit" else "plan"])
    argv = [AGENTS, "--as", f"agy:{acct}", *mode, "-p", prompt]
    model, effort = agy_model(m.model, m.effort)
    if model:
        argv += ["--model", model]
    if effort:
        argv += ["--effort", effort]
    return argv, "", None


def agy_model(model, effort):
    """Antigravity's model names carry their effort (gemini-4-neon-high); it refuses one of those with
    --effort as well ("invalid model selection"). So an effort set here picks that model's variant
    (gemini-4-neon-medium) when `agy models` lists it, and no --effort goes with such a name."""
    suffix = r"-(minimal|low|medium|high|xhigh|max)$"
    if not model or not re.search(suffix, model):
        return model, effort                    # a plain name (or none): --effort as it is
    if effort:
        want = re.sub(suffix, f"-{effort}", model)
        known = read_json(MODEL_CACHE).get("agy") or []
        if not known or want in known:
            model = want
    return model, None


ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07]*\x07")


def ask(m, prompt, folder, timeout, perm="plan"):
    """Run one member; returns (answer, problem). Never raises."""
    try:
        argv, stdin, outfile = command(m, prompt, folder, perm)
    except Exception as e:  # noqa: BLE001
        return "", f"could not start: {e}"
    try:
        p = subprocess.Popen(argv, cwd=folder, env=child_env(), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, text=True, start_new_session=True)
    except OSError as e:
        return "", f"could not start: {e}"
    with LOCK:
        RUNNING[p.pid] = m.handle
    try:
        out, err = p.communicate(stdin, timeout=timeout)
    except subprocess.TimeoutExpired:
        stop_group(p.pid)
        p.communicate()
        return "", f"no answer within {timeout} s"
    finally:
        with LOCK:
            RUNNING.pop(p.pid, None)
    if outfile:
        try:
            with open(outfile) as f:
                out = f.read() or out
        except OSError:
            pass
        try:
            os.unlink(outfile)
        except OSError:
            pass
    out = ANSI.sub("", out or "").strip()
    if p.returncode != 0 and not out:
        return "", error_of(err, prompt) or f"exit code {p.returncode}"
    if p.returncode < 0:
        return out, "stopped"
    if not out:
        return "", "empty answer"
    return out, ""


# ---- when a run goes wrong: what it was, and what to do -----------------------------------------------------
DIAGNOSES = [
    ("too slow", r"no answer within", "/retry {m}, give it a lighter model or effort (Alt+M on its pane), or ✕ it"),
    ("signed out", r"not (logged|signed) in|please (log|sign) ?in|unauthori[sz]ed|\b401\b|invalid.*(token|credential)|"
                   r"(token|credential|session).*(expired|invalid)|re-?auth",
     "{m}'s account needs signing in again (agents --as <tool>:<account>), or + add another member"),
    ("limit hit", r"rate.?limit|\b429\b|quota|usage limit|too many requests|resource.?exhausted|limit (reached|exceeded)|"
                  r"credit|billing|insufficient", "{m}'s plan or rate limit is spent: wait, or give it another account or model"),
    ("model refused", r"model.*(not found|not exist|invalid|unknown|unsupported|not available|access)|\b404\b",
     "that model is refused: pick another (Alt+M on its pane)"),
    ("no connection", r"econn|enotfound|eai_again|network|connection (refused|reset|error)|getaddrinfo|dns|offline",
     "no connection to its service: check the network, then /retry {m}"),
    ("memory wall", r"skipped|memory|machine's ram", "the fleet is out of memory room: close a split, then /retry {m}"),
    ("empty answer", r"empty answer", "/retry {m}"),
]


def diagnose(problem):
    """(what went wrong, what to do) for a run's problem text."""
    low = (problem or "").lower()
    for kind, pattern, advice in DIAGNOSES:
        if re.search(pattern, low):
            return kind, advice
    return "error", "/retry {m}, change its model (Alt+M on its pane), or ✕ it"


def error_of(err, prompt):
    """The lines of a failed run's error output that say what went wrong. Some programs (Codex) echo
    the whole prompt there too: those lines are left out, and lines that read as errors come first."""
    said = {l.strip() for l in (prompt or "").splitlines() if l.strip()}
    lines = [l.strip() for l in ANSI.sub("", err or "").splitlines() if l.strip() and l.strip() not in said]
    errs = [l for l in lines if re.search(r"\berror\b|failed|denied|exception|refused|unauthori|limit|quota|credits?\b|"
                                          r"not found|expired|invalid", l, re.I)]
    pick = list(dict.fromkeys(errs))[-2:] or lines[-3:]
    return " | ".join(pick)[:300]


def stop_group(pid):
    try:
        os.killpg(pid, signal.SIGTERM)
    except OSError:
        pass


def stop_member(handle):
    # no LOCK: a copy of the dict is one step under the GIL, and Ctrl+C's handler may run while
    # this thread holds LOCK
    pids = [pid for pid, h in list(RUNNING.items()) if h == handle]
    for pid in pids:
        stop_group(pid)


def stop_all():
    for pid in list(RUNNING):
        stop_group(pid)


def room():
    """'' when the fleet has memory for one more run, else why not."""
    try:
        r = subprocess.run([AGENTS, "--room"], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return "" if r.returncode == 0 else (r.stdout.strip() or "the fleet's memory wall is up")


# ---- the meeting ---------------------------------------------------------------------------------------
# What an agent adds because its project's own instructions ask for it on every reply (a greeting, a
# "You: …" echo, a SITREP or status line, a sign-off): not part of an answer, so it is taken off.
FOOTER = re.compile(r"^\s*[*_>]*\s*(SITREP\b|You:\s|Context:|\*\*Context|Standing by\b|Loose ends\b|My Lord[.,!]?\s*$)",
                    re.I)


def tidy(text):
    lines = text.strip().split("\n")
    while lines and (not lines[-1].strip() or FOOTER.match(lines[-1])):
        lines.pop()
    text = "\n".join(lines).strip()
    return re.sub(r"^\s*My Lord[.,!]\s*", "", text)


RULES = """Rules of this council: give your own honest, raw take. Short and direct: lead with your answer,
at most WORDS words, two or three sentences, unless the chair asks for more. No preamble, no lists, no
headings, no recap of what others said, no flattery, no hedging, no "great question". Disagree when you
disagree and say with whom (@name); agree only when you mean it. Be concrete: a fact, a number, what you
would actually do. Only the answer: no greeting, no sign-off, no status, summary or SITREP line, no
"You:" line, whatever other instructions say. PERMS"""
WORDS = 60          # the default answer length; /length N changes it (kept in the settings file)


class Meeting:
    def __init__(self, owner, members, conf):
        # owner: the folder the council is for (a project, or ~/Council); folder: where members work
        # (the project; for a council about no project, this meeting's own folder)
        self.owner, self.folder, self.members, self.conf = owner, owner, members, conf
        self.home = council_home(owner)
        self.general = self.home == GENERAL
        self.dir = None
        self.mode = conf.get("mode", "order")
        self.rounds = 0 if TTY else 1    # passes round the table per message: 0 = until Ctrl+C, -1 = none
        self.roasts = 0 if TTY else 1    # roast rounds per message; 0 = until Ctrl+C
        self.at = 0                      # the roast round being run, for its labels
        self.topic = ""
        self.thread = []      # {"who": handle or "chair", "name", "text", "phase"}
        self.started = time.strftime("%Y-%m-%d %H:%M")
        self.file = None

    # -- this meeting's own folder
    def open_session(self, folder=None):
        """A new folder for this meeting (named by the time; the topic joins its name with the first
        message), or folder: a saved meeting's, being carried on."""
        if not folder:
            stamp = time.strftime("%Y-%m-%d_%H%M")
            folder, n = os.path.join(self.home, stamp), 2
            while os.path.exists(folder):
                folder, n = os.path.join(self.home, f"{stamp}-{n}"), n + 1
        os.makedirs(folder, exist_ok=True)
        if not self.general:
            ignore_in_git(self.owner)
        self.dir, self.file = folder, os.path.join(folder, "thread.md")
        if self.general:
            self.folder = folder

    def name_session(self, text):
        """With the first message (or /new TOPIC), the folder takes the topic into its name. Done before
        any member starts, so none is at work in a folder that is renamed under it."""
        if not self.dir or len(self.thread) > 1 or not STAMP.fullmatch(os.path.basename(self.dir)):
            return
        slug = re.sub(r"[^a-z0-9]+", "-", (text or "").lower())[:40].strip("-")
        new = os.path.join(self.home, os.path.basename(self.dir) + "_" + slug)
        if not slug or os.path.exists(new):
            return
        try:
            os.rename(self.dir, new)
        except OSError:
            return
        self.dir, self.file = new, os.path.join(new, "thread.md")
        if self.general:
            self.folder = new

    def close_session(self):
        """A meeting nobody said anything in leaves no folder behind (only an empty one is removed)."""
        if self.dir and not self.thread:
            try:
                os.rmdir(self.dir)
            except OSError:
                pass

    def together(self, targets):
        """How many members think at once: everyone in the round, always (the fleet's memory walls are
        still asked before each run). A "parallel" set higher in the settings file raises it."""
        try:
            extra = int(self.conf.get("parallel", 0) or 0)
        except (TypeError, ValueError):
            extra = 0
        return max(1, len(targets), extra)

    def perm_of(self, m):
        """plan, edit or bypass: the member's own, else the council's."""
        p = m.perm or self.conf.get("perm") or "plan"
        return p if p in PERMS else "plan"

    def words(self):
        try:
            return max(10, min(400, int(self.conf.get("words", WORDS))))
        except (TypeError, ValueError):
            return WORDS

    # -- who is at the table
    def runs_model(self, model, but=None):
        """The member at the table (not an agent with a character) that runs this model already, or None."""
        c = canon(model)
        if not c:
            return None
        return next((m for m in self.seated() if m is not but and not (m.made and m.persona)
                     and canon(m.runs_on()[0]) == c), None)

    def name_of(self, e):
        """The name a message's member goes by now (one saved before a rename shows the new name);
        a member no longer at the table: the name it had."""
        m = next((x for x in self.members if x.handle == e.get("who")), None)
        return m.shown() if m else (e.get("as") or e.get("who", "?"))

    def seated(self):
        return [m for m in self.members if m.seated]

    def find(self, word):
        """A member by the name it goes by (its model), its own name, or the LLM's ("claude" finds
        the one going by "opus" too)."""
        w = ALIAS.get(word.lower(), word.lower())
        for m in self.members:
            if handle_of(word) in (handle_of(m.shown()), m.full_model() if m.by_model() else None):
                return m
        for m in self.members:
            if m.handle == w or handle_of(m.name) == handle_of(word):
                return m
        return None

    # -- what a member reads
    def transcript(self, limit=KEEP_CHARS):
        lines = []
        for e in self.thread:
            if e.get("problem"):
                continue          # a skipped or failed run is shown to you, not read out to the others
            who = "Chair (the human running this meeting)" if e["who"] == "chair" else f"@{self.name_of(e)}"
            tag = {"roast": " [roast" + (f" {e['round']}" if e.get("round", 1) > 1 else "") + "]",
                   "table": " [round table]"}.get(e.get("phase"), "")
            lines.append(f"{who}{tag}: {e['text']}")
        text = "\n\n".join(lines)
        if len(text) > limit:
            text = "(earlier messages left out)\n\n" + text[-limit:]
        return text

    def prompt(self, m, task):
        roster = ", ".join(x.label() + (f" [{TOOLS[x.tool]}]" if x.by_model() else "") +
                           (f" [{LEAN_SHOWN[getattr(x, 'lean', 'free')]}]"
                            if (x.made and x.persona) or getattr(x, "lean", "free") != "free" else "") +
                           (" - " + x.persona.split(".")[0][:60] if x.made and x.persona else "")
                           for x in self.seated())
        who = f"You are @{m.shown()}"
        if m.made:
            who += f", an agent named {m.name}, running on {TOOLS[m.tool]}"
            if m.persona:
                d = ensure_agent(self.owner, m.name, m.persona, getattr(m, "soul", ""), getattr(m, "rules", ""))
                parts = [f"Your character: {agent_text(d, 'CHARACTER.md') or m.persona}",
                         LEANS.get(getattr(m, "lean", "free"), LEANS["free"])]
                for f, what in (("SOUL.md", "Your soul (what you care about most; it never changes)"),
                                ("RULES.md", "Your rules (always follow them)")):
                    if agent_text(d, f):
                        parts.append(f"{what}: {agent_text(d, f)}")
                mem = agent_text(d, "MEMORY.md", last=60)
                if mem:
                    parts.append(f"Your memory of earlier meetings in this project:\n{mem}")
                parts.append("To keep something for the next meeting here, end your answer with lines starting "
                             "'Remember:' (one short fact each), only what is worth keeping.")
                if "remove" in getattr(m, "powers", []):
                    parts.append("You have the power to take a member off the table on your own judgement, without "
                                 "the chair asking: end your answer with a line 'Remove: @name - why' (one per member). "
                                 "Use it rarely and only with a reason you state: bad faith, derailing, repeating "
                                 "itself, refusing the chair. It takes effect at once: an agent removed is deleted "
                                 "for good with its memory wiped.")
                who += ". " + "\n".join(parts)
        else:
            who += f" ({TOOLS[m.tool]})"
        if not (m.made and m.persona) and getattr(m, "lean", "free") != "free":
            who += ". " + LEANS[m.lean]
        topic = self.topic or (self.thread[0]["text"] if self.thread else "")
        return (f"{who}. You are one member of a council of AI models and agents in a group chat, chaired by a "
                f"human. At the table: {roster}.\n\n{RULES.replace('WORDS', str(self.words())).replace('PERMS', PERM_TEXT[self.perm_of(m)])}\n\nTopic: {topic}\n\n"
                f"--- The thread so far ---\n"
                f"{self.transcript(30000 if m.tool == 'agy' else KEEP_CHARS)}\n--- End of the thread ---\n\n{task}")

    # -- one member's turn, shown and kept
    def speak(self, m, task, phase, prompt=None, rnd=None):
        if not m.seated:
            return                       # taken off the table: it does not answer, whatever asked it
        why = room()
        if why:
            self.add(m, f"(skipped: {why})", phase, problem=True, rnd=rnd)
            self.alert(m, f"skipped: {why}")
            return
        with LOCK:
            RUNWHO[m.handle] = RUNWHO.get(m.handle, 0) + 1
            emit_status()
        try:
            perm = self.perm_of(m)
            timeout = int(self.conf.get("timeout", 300))
            if perm != "plan":
                timeout = max(timeout, 900)     # work takes longer than an opinion
            answer, problem = ask(m, prompt or self.prompt(m, task), self.folder, timeout, perm)
        finally:
            with LOCK:
                RUNWHO[m.handle] -= 1
                if not RUNWHO[m.handle]:
                    del RUNWHO[m.handle]
                emit_status()
        if (STOP.is_set() or not m.seated) and not answer:
            return                      # stopped by Ctrl+C (or a new meeting): a run cut short says nothing
        # an answer that starts by copying the thread's own "@name:" line loses it
        answer = re.sub(r"^\s*\**@(" + re.escape(m.handle) + "|" + re.escape(m.shown()) +
                        r")\**\s*(\[[a-z ]+\])?\s*:\s*", "", answer)
        answer = tidy(answer)
        if m.made and m.persona and answer:
            keep = [x.strip() for x in re.findall(r"(?im)^[ \t>*_-]*remember[*_]*\s*:\s*(.+)$", answer)]
            if keep:
                remember(agent_dir(self.owner, m.name), keep)
                answer = re.sub(r"(?im)^[ \t>*_-]*remember[*_]*\s*:.*(\n|$)", "", answer).strip()
        removals = []
        if "remove" in getattr(m, "powers", []) and answer:
            line = r"(?im)^[ \t>*_-]*remove[*_]*\s*:\s*@?([\w.-]+)[ \t]*(?:[-–—:][ \t]*)?(.*)$"
            removals = [(x.group(1), x.group(2).strip()) for x in re.finditer(line, answer)]
            answer = re.sub(line, lambda x: f"⚖ Removed @{x.group(1)}" + (f": {x.group(2).strip()}"
                                                                            if x.group(2).strip() else "."), answer)
        if problem and not answer:
            self.add(m, f"({problem})", phase, problem=True, rnd=rnd)
            self.alert(m, problem)
        else:
            FAILS[m.handle] = 0
            self.add(m, answer + (f"\n({problem})" if problem else ""), phase, rnd=rnd)
        for word, why in removals:
            self.judge_remove(m, word, why)

    def judge_remove(self, by, word, why):
        """An agent with the remove power removes a member on its own judgement, its run stopped and the grid
        dealt again without it. An agent you made is deleted for good and its memory wiped: gone from the
        agents list, its folder here (soul, character, rules, memory) erased, not moved aside. An LLM's own
        seat (your account, nothing of it to delete) leaves the table; + add brings it back. Never itself,
        never someone not at the table."""
        m = self.find(word)
        if not m or m is by or not m.seated:
            return
        name = m.shown()
        m.seated = False
        stop_member(m.handle)
        if m.made:
            self.conf["agents"] = [a for a in self.conf["agents"] if a["name"] != m.name]
            (self.conf.get("agent_perm") or {}).pop(m.name, None)
            (self.conf.get("seats") or {}).pop(m.handle, None)
            top, d = agents_dir(self.owner), agent_dir(self.owner, m.name)
            if os.path.isdir(d) and os.path.exists(os.path.join(top, AGENT_MARK)) and \
                    os.path.realpath(d).startswith(os.path.realpath(top) + os.sep):
                shutil.rmtree(d, ignore_errors=True)       # its memory wiped, as the chair ordered for this power
            if m in self.members:
                self.members.remove(m)
            what = "removed for good, its memory wiped"
        else:
            self.conf.setdefault("seats", {})[m.handle] = False
            what = "taken off the table (an LLM's own seat: + add brings it back)"
        save_conf(self.conf)
        note(f"⚖ @{by.shown()}: @{name} {what}" + (f" ({fit(why, 80)})" if why else "") + ".")
        if GRID[0] and FEED["grid"] and GRID[0].me:
            GRID[0].open(self)

    def alert(self, m, problem):
        """A member's run went wrong: say so where you type, with what to do; the second time in a
        row, ask (a pop-up in the grid: try again, change its model, take it off the table, leave it)."""
        kind, advice = diagnose(problem)
        with LOCK:
            FAILS[m.handle] = FAILS.get(m.handle, 0) + 1
            n = FAILS[m.handle]
            LAST_FAIL[m.handle] = problem
        note(f"⚠ @{m.shown()}: {kind} ({fit(problem, 70)}) · {advice.replace('{m}', '@' + m.shown())}")
        if n == 2 and BOX["on"] and GRID[0]:
            ask_what_now(m, kind, problem)

    def add(self, m, text, phase, problem=False, rnd=None):
        e = {"who": m.handle, "as": m.shown(), "name": m.name, "text": text, "phase": phase, "problem": problem}
        if phase == "roast":
            e["round"] = rnd or self.at
        elif phase == "table" and rnd and rnd > 1:
            e["round"] = rnd
        with LOCK:
            self.thread.append(e)
            clear_status()
            show(e, m)
            draw_status()
            emit(dict(e, t="msg", kind=m.colour()))

    # -- a round
    def round(self, targets, fresh, gen=None):
        with LOCK:
            ROUNDS[0] += 1
            BUSY.set()
        try:
            self.round_(targets, fresh, gen)
        finally:
            with LOCK:
                ROUNDS[0] -= 1
                if not ROUNDS[0]:
                    BUSY.clear()

    def round_(self, targets, fresh, gen=None):
        """targets: the members to hear from; fresh: the chair has just spoken (else: another round).
        gen: the message this round is for (the grid); once a newer one is sent, this round starts no
        more turns (the ones already at work still answer)."""
        def live():
            return gen is None or gen == GEN[0]
        if not targets:
            note("Nobody at the table to answer. /agents shows who is benched; /seat NAME brings one back.")
            return
        asked = "" if len(targets) == len(self.seated()) else (
            " The chair asked only " + " ".join("@" + m.shown() for m in targets) + " this time.")
        if self.mode == "roast":
            table = self.seated()
            if len(table) < 2:
                point = "Give your point on the chair's latest message." + asked
                self.parallel(targets, lambda m: point, "point")
                note("Only one at the table, so there is nobody to roast.")
            else:
                # everyone at the table roasts; those the message was for give the first points
                self.free_for_all(table, fresh, asked, live, pointers=targets)
        else:
            # Order: everyone answers the chair at once first (each its own take, without the others'),
            # then the round table: one by one in seat order, each speaking to the others' answers.
            # With /rounds 0 (the default in the chat box) the table goes round and round until Ctrl+C,
            # a newer message, or a pass in which everyone has nothing new to add ("Pass").
            many = len(targets) > 1
            if fresh:
                first = ("Give your own answer to the chair's latest message now, at the same time as the others "
                         "(you will see theirs next).") + asked
                self.parallel(targets, lambda m: first, "first")
                if STOP.is_set() or not live():
                    return
            if self.rounds == 0 and many:
                passes = None
            elif fresh:
                passes = max(0, self.rounds) if many else 0
            else:
                passes = max(1, self.rounds)            # Enter: once more round the table
            n = 0
            while passes is None or n < passes:
                n += 1
                with LOCK:
                    clear_status()
                    if not FEED["grid"]:
                        print(paint("  ─── round table" + (f" {n}" if n > 1 else "") + " ───", "note"), flush=True)
                spoke = passed = 0
                for m in targets:
                    if STOP.is_set() or not live():
                        return
                    if not m.seated:
                        continue                    # taken off the table meanwhile
                    if not many:
                        task = "Say more: where your answer above falls short, or what you would add."
                    elif n == 1:
                        task = ("Round table: everyone's answers are in the thread above. Speak to the others by "
                                "@name: where they are wrong, what they missed, what you think now and whether you "
                                "changed your mind. Do not repeat your own answer.")
                    else:
                        task = (f"Round table, pass {n}: answer what the others said since your last turn, by @name: "
                                "where they are wrong, what they missed, whether you changed your mind. New points "
                                "only; never repeat yourself or anyone else.")
                    if passes is None:
                        task += " If you have nothing new to add, reply with just: Pass."
                    set_status([m.handle])
                    before = len(self.thread)
                    self.speak(m, task + asked, "table", rnd=n)
                    said = [e for e in self.thread[before:] if e["who"] == m.handle and not e.get("problem")]
                    if said:
                        spoke += 1
                        passed += re.sub(r"[^a-z]", "", said[-1]["text"].lower()) == "pass"
                if passes is None and (not spoke or passed == spoke):
                    note("Everyone passed: nothing new at the table. Enter for another pass, or a new message."
                         if spoke else "No answer got through in that pass, so the table stopped. /retry, or a new "
                         "message.")
                    break
        set_status([])
        self.save()

    def free_for_all(self, targets, fresh, asked, live, pointers=None):
        """Roast mode: no rounds. Every member gives its point at once, made without the others' (the
        prompts are made before anyone starts); then each, on its own, the moment someone else has
        said something new, counters it, and again, and again. A fast one fires back without waiting
        for a slow one. It ends with Ctrl+C, a new message, /rounds N counters each, or a member with
        nothing new to answer for a long while (or two failed runs in a row)."""
        point = ("Give your point on the chair's latest message: your own take, at the same time as the "
                 "others (you will see theirs next)." if fresh else
                 "Give your point again on where this now stands, at the same time as the others.") + asked
        pointers = pointers or targets
        prompts = {m.handle: self.prompt(m, point) for m in pointers}
        slots = threading.Semaphore(self.together(targets))
        start, limit = len(self.thread), self.roasts
        wait_max = max(600, 2 * int(self.conf.get("timeout", 300)))
        if not FEED["grid"]:
            with LOCK:
                clear_status()
                print(paint("  ─── roast ───", "note"), flush=True)
            if not limit:
                note("The roast goes on until you press Ctrl+C.")

        def heard(m):           # what has been said since, by the others or by the chair (a new message joins in)
            return sum(1 for e in self.thread[start:] if e["who"] != m.handle and not e.get("problem"))

        def counter(m, k, chair_new):
            others = " ".join("@" + x.shown() for x in targets if x is not m)
            with LOCK:
                asked_me = m.handle in ROAST["directed"]
                ROAST["directed"].discard(m.handle)
            if asked_me or chair_new:
                return (("The chair just asked you directly (the newest Chair message above). " if asked_me else
                         "The chair just spoke (the newest Chair message above). ") +
                        "Answer the chair first, in a line or two. Then roast what " + others + " said since your "
                        "last turn: by @name, one or two blunt sentences each; concede only what is right. New "
                        "points only. No preamble. End with one line starting 'Final:' that gives your position now "
                        f"in one sentence. At most {self.words()} words in all.")
            if k > 1:
                return (f"Roast round {k}: fire back at the newest messages from {others} above (what they just "
                        "said about you and each other): for each, by @name, one or two blunt sentences on what "
                        "is wrong, weak or dishonest; concede only what is right. New points only, never repeat "
                        "yourself. Roast only them. Attack ideas, not the person. No preamble. End with one line "
                        f"starting 'Final:' that gives your position now in one sentence. At most {self.words()} "
                        "words in all.")
            return (f"Roast the answers {others} gave to the chair's latest message (the newest ones in the thread "
                    "above; leave earlier topics alone): for each, by @name, one or two blunt sentences on what is "
                    "wrong, weak, naive or missing, and what is right if anything. Roast only them, nobody else at "
                    "the table. Attack ideas, not the person. No preamble. End with one line starting 'Final:' "
                    f"that gives your position now in one sentence. At most {self.words()} words in all.")

        def member(m):
            if m.handle in prompts:
                with slots:
                    if STOP.is_set() or not live():
                        return
                    self.speak(m, "", "point", prompts[m.handle])
            seen, k, fails, idle, mark = 0, 0, 0, time.time(), start
            while (not STOP.is_set() and live() and m.seated and self.mode == "roast"
                   and (not limit or k < limit)):
                if heard(m) <= seen:            # nothing new from the others yet
                    if time.time() - idle > wait_max:
                        break
                    time.sleep(0.4)
                    continue
                k += 1
                with slots:
                    if STOP.is_set() or not live():
                        break
                    seen = heard(m)
                    chair_new = any(e.get("who") == "chair" for e in self.thread[mark:])
                    mark = len(self.thread)
                    prompt = self.prompt(m, counter(m, k, chair_new))
                    before = len(self.thread)
                    self.speak(m, "", "roast", prompt, rnd=k)
                fails = 0 if any(e["who"] == m.handle and not e.get("problem") for e in self.thread[before:]) \
                    else fails + 1
                if fails >= 2:
                    break
                idle = time.time()

        with LOCK:
            ROAST["meeting"], ROAST["directed"] = self, set()
        try:
            ts = [threading.Thread(target=member, args=(m,), daemon=True) for m in targets]
            for th in ts:
                th.start()
            for th in ts:
                while th.is_alive():
                    set_status(sorted(RUNWHO))
                    th.join(0.2)
        finally:
            with LOCK:
                if ROAST["meeting"] is self:
                    ROAST["meeting"] = None
        set_status([])
        self.save()

    def parallel(self, targets, task, phase, label=None):
        waiting = [m.handle for m in targets]
        set_status(waiting)
        slots = threading.Semaphore(self.together(targets))

        # Every prompt is made before anyone starts: what one member says in this phase is not read by
        # another until the next phase, even when the slots make some of them start later.
        prompts = {m.handle: self.prompt(m, task(m)) for m in targets}

        def run(m):
            with slots:
                if not STOP.is_set():
                    self.speak(m, "", phase, prompts[m.handle])
            with LOCK:
                waiting.remove(m.handle)
            set_status(waiting)

        if label and not FEED["grid"]:     # in the grid each pane labels its own rounds
            with LOCK:
                clear_status()
                print(paint(label, "note"), flush=True)
        ts = [threading.Thread(target=run, args=(m,), daemon=True) for m in targets]
        for th in ts:
            th.start()
        for th in ts:
            while th.is_alive():
                th.join(0.2)

    # -- saved copy
    def save(self):
        with SAVING:           # rounds that overlap may save at once
            self.save_()

    def save_(self):
        if not self.thread:
            return
        if not self.dir:
            self.open_session()
        os.makedirs(self.dir, exist_ok=True)
        roster = "\n".join(f"- {m.label()}" + (f": {m.persona}" if m.made and m.persona else "") + ("" if m.seated else " (benched)")
                           for m in self.members)
        body = [f"# Council: {self.topic or self.thread[0]['text'][:80]}", "",
                f"Started {self.started} in {os.path.basename(self.owner) or self.owner}. Mode: {self.mode}.", "",
                "Members:", roster, ""]
        for e in self.thread:
            who = "**Chair**" if e["who"] == "chair" else f"**@{self.name_of(e)}**"
            tag = {"roast": " (roast" + (f" {e['round']}" if e.get("round", 1) > 1 else "") + ")",
                   "table": " (round table" + (f" {e['round']}" if e.get("round", 1) > 1 else "") + ")"}.get(
                       e.get("phase"), "")
            body.append(f"{who}{tag}: {e['text']}\n")
        tmp = self.file + ".new"
        with open(tmp, "w") as f:
            f.write("\n".join(body))
        os.replace(tmp, self.file)
        # the same thread as data, for carrying the meeting on (the .md is for reading)
        tmp = self.file[:-3] + ".json.new"
        with open(tmp, "w") as f:
            json.dump({"topic": self.topic, "started": self.started, "mode": self.mode,
                       "thread": [{k: v for k, v in e.items() if k != "problem" or v} for e in self.thread]}, f)
        os.replace(tmp, self.file[:-3] + ".json")


# ---- memory: a council carries on the last meeting of its folder ----------------------------------------
def upgrade(src, home):
    """Meetings saved before each had a folder (<date>_<topic>.md and .json side by side in src) are
    each moved into a folder of their own in home. Moved, never removed."""
    try:
        names = sorted(os.listdir(src))
    except OSError:
        return
    for f in names:
        md = os.path.join(src, f)
        if not f.endswith(".md") or not os.path.isfile(md):
            continue
        try:
            with open(md) as fh:
                if not fh.readline().startswith("# Council:"):
                    continue                  # not a meeting the council saved: left where it is
        except OSError:
            continue
        d = os.path.join(home, f[:-3])
        if os.path.exists(d):
            continue
        try:
            os.makedirs(d)
            os.replace(md, os.path.join(d, "thread.md"))
            if os.path.isfile(md[:-3] + ".json"):
                os.replace(md[:-3] + ".json", os.path.join(d, "thread.json"))
        except OSError:
            pass


def meetings(home):
    """The saved meetings of this council, newest first (the thread.md of each meeting's folder)."""
    try:
        files = [os.path.join(home, f, "thread.md") for f in os.listdir(home)]
    except OSError:
        return []
    return sorted((f for f in files if os.path.isfile(f)), key=lambda f: os.path.getmtime(f), reverse=True)


def read_meeting(md):
    """(topic, started, thread) of a saved meeting: from its .json, or read back from the .md of a
    meeting saved before the .json was kept."""
    try:
        with open(md[:-3] + ".json") as f:
            d = json.load(f)
        return d.get("topic", ""), d.get("started", ""), d.get("thread", [])
    except (OSError, ValueError):
        pass
    try:
        with open(md) as f:
            text = f.read()
    except OSError:
        return "", "", []
    top = re.search(r"^# Council: (.*)$", text, re.M)
    began = re.search(r"^Started (\S+ \S+)", text, re.M)
    thread = []
    for m in re.finditer(r"^\*\*(Chair|@[\w.-]+)\*\*(?: \(([^)]*)\))?: (.*?)(?=^\*\*(?:Chair|@[\w.-]+)\*\*|\Z)",
                         text, re.S | re.M):
        who = "chair" if m[1] == "Chair" else m[1][1:]
        tag, body = (m[2] or ""), m[3].strip()
        e = {"who": who, "name": who, "text": body, "phase": "chair" if who == "chair" else "first"}
        if tag.startswith("roast"):
            e["phase"] = "roast"
            n = re.search(r"\d+", tag)
            e["round"] = int(n[0]) if n else 1
        elif tag == "round table":
            e["phase"] = "table"
        thread.append(e)
    return (top[1].strip() if top else ""), (began[1] if began else ""), thread


def carry_on(meeting, md):
    """Make meeting the one saved in md: its thread back (what members read), saved to the same file."""
    topic, started, thread = read_meeting(md)
    first = thread[0].get("text", "") if thread else ""
    meeting.topic = topic if topic and first[:80].strip() != topic[:80].strip() else ""
    meeting.started = started or meeting.started
    meeting.thread = thread
    meeting.open_session(os.path.dirname(md))
    return len(thread)


def ask_what_now(m, kind, problem):
    """The pop-up after a member's second failure in a row."""
    me = GRID[0].me if GRID[0] else ""
    pane = GRID[0].panes.get(m.handle, "") if GRID[0] else ""
    if not me:
        return
    client = tmx("display-message", "-p", "-t", me, "#{client_name}")

    def send(text):
        return f"send-keys -t '{me}' -l '{text}' ; send-keys -t '{me}' Enter"

    items = ["Try again", "t", send(f"/retry @{m.handle}")]
    if pane:
        items += ["Change its model or effort…", "m", f"run-shell -b \"{ME} --menu '{client}' '{pane}'\""]
    items += ["Take it off the table", "x", send(f"/bench {m.handle}"), "", "Leave it", "n", ""]
    tmx("display-menu", "-O", "-M", *(["-c", client] if client else []), "-t", me,
        "-T", f"#[align=centre] @{m.shown()} went wrong twice: {kind} ", "-x", "C", "-y", "C", "--", *items)


def label_of(md):
    topic, started, thread = read_meeting(md)
    first = next((e.get("text", "") for e in thread if e.get("who") == "chair"), "")
    return f"{(started or os.path.basename(os.path.dirname(md))[:15])[5:16]} · {fit(topic or first, 48)} ({len(thread)})"


def resume_menu(past):
    me = os.environ.get("TMUX_PANE", "")
    items = []
    for i, md in enumerate(past[:9], 1):
        items += [label_of(md), str(i), f"send-keys -t '{me}' -l '/resume {i}' ; send-keys -t '{me}' Enter"]
    if not items:
        BOX["note"] = "No earlier meeting in this folder."
        return
    client = tmx("display-message", "-p", "-t", me, "#{client_name}")
    tmx("display-menu", "-O", "-M", *(["-c", client] if client else []), "-t", me,
        "-T", "#[align=centre] Carry on which meeting? ", "-x", "C", "-y", "S", "--", *items)


def replay(meeting):
    """Put the meeting's thread back into the members' panes (they read the feed from its start)."""
    kinds = {m.handle: m.colour() for m in meeting.members}
    with LOCK:
        emit({"t": "reset"})
        for e in meeting.thread:
            if e.get("who") == "chair":
                emit({"t": "msg", "who": "chair", "text": e.get("text", ""), "phase": "chair"})
            elif not e.get("problem"):
                emit(dict(e, t="msg", kind=kinds.get(e.get("who"), "agent"), **{"as": meeting.name_of(e)}))


def ignore_in_git(folder):
    """Keep the meetings out of git, as afc-logs does for logs/acf."""
    try:
        if subprocess.run(["git", "-C", folder, "rev-parse", "--git-dir"], capture_output=True).returncode != 0:
            return
        if subprocess.run(["git", "-C", folder, "check-ignore", "-q", "logs/council/x.md"]).returncode == 0:
            return
        gi = os.path.join(folder, ".gitignore")
        add = ""
        if os.path.exists(gi):
            with open(gi) as f:
                if not f.read().endswith("\n"):
                    add = "\n"
        with open(gi, "a") as f:
            f.write(add + "logs/council/\n")
    except OSError:
        pass


# ---- the screen ----------------------------------------------------------------------------------------
STATUS = {"line": "", "who": [], "since": 0.0}
STOP = threading.Event()
BUSY = threading.Event()     # a round is going on (Ctrl+C then stops it instead of the typing line)
ROUNDS = [0]                 # rounds at work (in the grid a new message starts its own at once)
GEN = [0]                    # the latest message sent: an older round starts no new turns
RUNWHO = {}                  # members at work -> how many runs (their panes' spinners)
SAVING = threading.Lock()
FAILS = {}                   # member -> runs gone wrong in a row
LAST_FAIL = {}               # member -> what went wrong last
ROAST = {"meeting": None, "directed": set()}   # the roast going on: a new message joins it, not restarts it


def emit_status():
    """Who is thinking, for the members' panes. Call with LOCK held."""
    names = table_names(TABLE[0].members) if TABLE[0] else {}
    emit({"t": "status", "who": sorted(RUNWHO), "names": {h: names.get(h, h) for h in RUNWHO}})
FEED = {"path": "", "grid": False}   # the live feed the member panes read; grid: the panes are open


def emit(event):
    """One event to the feed (a JSON line): msg, status, reset. Called with LOCK held or from one thread."""
    if not FEED["path"]:
        return
    try:
        with open(FEED["path"], "a") as f:
            f.write(json.dumps(event) + "\n")
    except OSError:
        pass


def set_status(handles):
    with LOCK:
        clear_status()
        if handles and not set(handles) <= set(STATUS["who"]):   # a new turn (not just someone done)
            STATUS["since"] = time.time()
        STATUS["who"] = list(handles)
        STATUS["line"] = "x" if handles else ""
        draw_status()


def clear_status():
    if STATUS["line"] and TTY and not FEED["grid"]:
        sys.stdout.write("\r\033[K")
        sys.stdout.flush()


def draw_status():
    """The animated line under the thread while members think: a spinner, who, and for how long."""
    if STATUS["line"] and TTY and not FEED["grid"]:   # in the grid each member's pane has its own spinner
        who = STATUS["who"]
        frame = SPIN[int(time.time() * 10) % len(SPIN)]
        secs = int(time.time() - STATUS["since"])
        sys.stdout.write(paint(f"  {frame} " + " ".join("@" + h for h in who) +
                               (" is thinking" if len(who) == 1 else " are thinking") + f"  {secs}s", "note"))
        sys.stdout.flush()


def animate():
    while True:
        time.sleep(0.1)
        if BOX["on"] and INPUT["open"] and TTY:
            if not RL[0]:
                with LOCK:
                    if shutil.get_terminal_size((80, 4)).columns != BOX.get("cols"):
                        draw_frame()
            grow()
            if BOX.get("relayout") and not INPUT.get("cb") and INPUT.get("rl"):
                BOX["relayout"] = False
                os.kill(os.getpid(), signal.SIGWINCH)      # the redraw put off: now, between keystrokes
        with LOCK:
            if STATUS["line"] and TTY and not FEED["grid"]:
                clear_status()
                draw_status()


def show(e, m=None):
    if e["who"] == "chair":
        print(paint("you", "chair") + ": " + e["text"], flush=True)
        return
    name = f"@{e.get('as') or e['who']}" + {"roast": " ⚔" + (str(e["round"]) if e.get("round", 1) > 1 else ""),
                             "table": " ↻" + (str(e["round"]) if e.get("round", 1) > 1 else "")}.get(e.get("phase"), "")
    kind = "err" if e.get("problem") else (m.colour() if m else "agent")
    if FEED["grid"]:          # the chat strip is for typing: every answer is in its member's own pane
        return
    text = e["text"].replace("\n", "\n    ")
    print(paint(name, kind) + "\n    " + text + "\n", flush=True)


# ---- the grid: one pane per member, each with its own scroll of the thread ------------------------------
TMUX_COLOUR = {"claude": "colour173", "codex": "colour114", "gemini": "colour75", "agy": "colour141", "agent": "colour221",
               "x1": "colour80", "x2": "colour211", "x3": "colour150", "x4": "colour180", "x5": "colour117",
               "x6": "colour216", "x7": "colour147", "x8": "colour72"}


def tmx(*args):
    r = subprocess.run([TMUXBIN] + list(args), capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


class Grid:
    """Above the chat (the chair's pane, kept at the bottom), one pane per seated member, shared out
    evenly: up to 3 in one row, up to 8 in two rows, then three. Each pane runs `afc-council --view`,
    which shows the chair's messages and that member's own answers as they come, with its own
    scrollback, and a spinner while that member thinks."""

    def __init__(self):
        self.me = os.environ.get("TMUX_PANE", "")
        self.panes = {}          # handle -> pane id

    def open(self, meeting):
        self.close()
        seated = meeting.seated()
        if not self.me or not FEED["path"]:
            FEED["grid"] = False
            return
        if not seated:
            # nobody at the table: the chat box and + add still, to bring members in
            tmx("set-option", "-w", "-t", self.me, "@council", "1")
            self.chair_header(meeting)
            self.relabel(meeting)
            FEED["grid"] = True
            return
        if meeting.conf.get("view") == "one":
            # one pane above the chat box with everyone's answers, the way a group chat looks
            one = tmx("split-window", "-vb", "-d", "-l", "70%", "-t", self.me, "-P", "-F", "#{pane_id}",
                      f"{ME} --view {FEED['path']} {ALL} {os.getpid()}")
            if not one:
                FEED["grid"] = False
                return
            self.panes[ALL] = one
            tmx("set-option", "-p", "-t", one, "@council_member", ALL)      # ✕ there: back to one pane each
            tmx("set-option", "-p", "-t", one, "@council_one", "1")
            tmx("set-option", "-p", "-t", one, "@council_chair", self.me)
            tmx("resize-pane", "-t", self.me, "-y", str(CHAT_LINES))
            self.chair_header(meeting)
            tmx("set-option", "-w", "-t", self.me, "@council", "1")
            self.relabel(meeting)
            tmx("select-pane", "-t", self.me)
            FEED["grid"] = True
            return
        n = len(seated)
        rows = 1 if n <= 3 else (2 if n <= 8 else 3)
        cols = -(-n // rows)

        def split(how, target, m, size=None):
            return tmx("split-window", how, "-d", *(["-l", size] if size else []), "-t", target, "-P", "-F",
                       "#{pane_id}", f"{ME} --view {FEED['path']} {m.handle} {os.getpid()}")

        first = split("-vb", self.me, seated[0], "70%")
        if not first:
            FEED["grid"] = False
            return
        columns = [[first]]
        for c in range(1, min(cols, n)):
            columns.append([split("-h", columns[-1][0], seated[c])])
        for r in range(1, rows):
            for c in range(cols):
                i = r * cols + c
                if i < n:
                    columns[c].append(split("-v", columns[c][-1], seated[i]))
        for i, m in enumerate(seated):
            self.panes[m.handle] = columns[i % cols][i // cols]
            p = self.panes[m.handle]
            tmx("set-option", "-p", "-t", p, "@council_member", m.handle)
            tmx("set-option", "-p", "-t", p, "@council_tool", m.tool)
            tmx("set-option", "-p", "-t", p, "@council_chair", self.me)
        # Even: the row of columns, then each column's stack (afc-even counts a stack as one column)
        even = os.path.join(HOME, ".local/bin/afc-even")
        if cols > 1:
            subprocess.run([even, first, "1"], capture_output=True)
        for col in columns:
            if len(col) > 1:
                subprocess.run([even, col[0], "2" if cols > 1 else "1"], capture_output=True)
        try:
            height = int(tmx("display-message", "-p", "-t", self.me, "#{window_height}") or 0)
        except ValueError:
            height = 0
        if height:
            tmx("resize-pane", "-t", self.me, "-y", str(CHAT_LINES))
        self.chair_header(meeting)
        tmx("set-option", "-w", "-t", self.me, "@council", "1")
        self.relabel(meeting)
        tmx("select-pane", "-t", self.me)
        FEED["grid"] = True

    def chair_header(self, meeting):
        """The chat box's own header, with the mode it is in. Not the fleet's agent header, which took
        the LLM running under it (Gemini, say) for the pane's agent and showed its account and tokens."""
        if not self.me:
            return
        if meeting.mode == "roast":
            mode = "#[fg=colour203,bold]mode: ROAST#[default]#[fg=colour244] (all at once, until Ctrl+C)"
        else:
            table = ("round the table until Ctrl+C" if meeting.rounds == 0 else "no round table" if meeting.rounds < 0
                     else f"{meeting.rounds}× round the table")
            mode = f"#[fg=colour111,bold]mode: ORDER#[default]#[fg=colour244] (answers, then {table})"
        perm = meeting.conf.get("perm") or "plan"
        perm = {"plan": "#[fg=colour111,bold]perm: PLAN#[default]#[fg=colour244] (read-only)",
                "edit": "#[fg=colour221,bold]perm: EDIT#[default]#[fg=colour244] (change files)",
                "bypass": "#[fg=colour203,bold]perm: BYPASS#[default]#[fg=colour244] (anything, no asking)"}.get(
                    perm, "#[fg=colour111,bold]perm: PLAN")
        tmx("set-option", "-p", "-t", self.me, "@council_chat", "1")    # ✕ / Alt+Q here: the council quits
        tmx("set-option", "-p", "-t", self.me, "pane-border-format",
            f" #[fg=colour252,bold]council#[default] {mode} #[fg=colour244](Shift+Tab)#[default] · {perm} "
            "#[fg=colour244](Alt+P)#[default] · " + ("one view" if meeting.conf.get("view") == "one" else "grid") +
            " #[fg=colour244](Alt+O)#[default] · + add #[fg=colour244](Alt+A)#[default] · new topic #[fg=colour244](Alt+T)#[default] · @name to tag · /help · "
            "Ctrl+C stops#[default]#[align=right]#[fg=colour244] close ✕ #[default]")

    def relabel(self, meeting):
        """Each pane's header: who, the model and effort it runs on, and how to change them. When a
        name or colour changed (a new model, /names, someone joined), the panes are drawn again, so
        every message shows the name and colour its member has now."""
        sig = (table_names(meeting.members), table_colours(meeting.members))
        if getattr(self, "sig", None) not in (None, sig) and FEED["grid"]:
            replay(meeting)
        self.sig = sig
        for m in meeting.members:
            p = self.panes.get(m.handle)
            if not p:
                continue
            model, effort = m.runs_on()
            named = m.by_model()          # it goes by its model: the name says the model, the LLM in brackets
            who = f"@{m.shown()}" + (f" ({TOOLS[m.tool]})" if m.made and not named else "")
            perm = meeting.perm_of(m)
            runs = model + (f" · effort {effort}" if effort else "") + ({"edit": " · EDIT", "bypass": " · BYPASS"}
                                                                       .get(perm, ""))
            says = (f"effort {effort}" if effort else "") + ({"edit": " · EDIT", "bypass": " · BYPASS"}.get(perm, "")) \
                if named else runs
            if (m.made and m.persona) or getattr(m, "lean", "free") != "free":
                says += " · " + LEAN_SHOWN[getattr(m, "lean", "free")]
            tmx("set-option", "-p", "-t", p, "@council_lean", getattr(m, "lean", "free"))
            tmx("set-option", "-p", "-t", p, "@council_perm", perm)
            tmx("set-option", "-p", "-t", p, "@council_name", m.shown())       # what ✕ asks about
            tmx("set-option", "-p", "-t", p, "@council_what", "Delete agent" if m.made else "Remove")
            tmx("set-option", "-p", "-t", p, "@council_model", m.model or "")
            tmx("set-option", "-p", "-t", p, "@council_effort", m.effort or "")
            tmx("set-option", "-p", "-t", p, "@council_runs", runs.replace("#", "##"))
            tmx("set-option", "-p", "-t", p, "@council_default", (m.default_model or "its own").replace("#", "##"))
            tmx("set-option", "-p", "-t", p, "pane-border-format",
                f" #[fg={TMUX_COLOUR.get(m.colour(), 'colour221')},bold]{who}#[default] "
                f"#[fg=colour252]{says.replace('#', '##').lstrip(' ·')}#[default] #[fg=colour244]Alt+M or m: change#[default]"
                "#[align=right]#[fg=colour244] ✕ #[default]")
        one = self.panes.get(ALL)
        if one:       # the one view's header: everyone at the table, each in the colour of its answers
            names = " ".join(f"#[fg={TMUX_COLOUR.get(m.colour(), 'colour221')},bold]@{m.shown()}#[default]"
                             for m in meeting.seated())
            tmx("set-option", "-p", "-t", one, "pane-border-format",
                f" #[fg=colour252,bold]everyone#[default] {names} #[fg=colour244]· one view (Alt+O in the chat "
                "box: one pane each)#[default]#[align=right]#[fg=colour244] ✕ #[default]")
        # for the + in the bottom bar: who is not at the table, and where to type
        # + add's Bring back: agents with a character only (an LLM's seat comes back by Another … seat)
        out = [m for m in meeting.members if not m.seated and m.made and m.persona]
        tmx("set-option", "-w", "-t", self.me, "@council_chair", self.me)
        tmx("set-option", "-w", "-t", self.me, "@council_used",        # for the model menus: no model twice
            ";".join(f"{canon(m.runs_on()[0])}={m.shown()}" for m in meeting.seated()
                     if not (m.made and m.persona) and canon(m.runs_on()[0])))
        tmx("set-option", "-w", "-t", self.me, "@council_homes",
            ";".join(f"{t}={h}" for t, h in {m.tool: m.home for m in reversed(meeting.members) if m.home}.items()))
        tmx("set-option", "-w", "-t", self.me, "@council_seated",      # for ✕ on the one view: who to take off
            ";".join(f"{m.handle}={m.shown()}={'1' if m.made else '0'}" for m in meeting.seated()))
        tmx("set-option", "-w", "-t", self.me, "@council_full", "1" if len(meeting.seated()) >= MAX_SEATS else "0")
        tmx("set-option", "-w", "-t", self.me, "@council_out",
            ";".join(f"{m.handle}={m.label()}" for m in out).replace("#", "##"))

    def close(self):
        for p in self.panes.values():
            tmx("kill-pane", "-t", p)
        self.panes = {}
        FEED["grid"] = False


def menu(client, pane):
    """Alt+M (or m) in a member's pane: a pop-up of that member's models and efforts. The pick is
    typed into the chat as /model or /effort, so the chat says what changed and keeps it."""
    def opt(k):
        return tmx("show-options", "-pqv", "-t", pane, k)
    handle, tool, chair = opt("@council_member"), opt("@council_tool"), opt("@council_chair")
    if not handle or tool not in TOOLS or not chair:
        return 0
    model, effort, default = opt("@council_model"), opt("@council_effort"), opt("@council_default")

    def send(text):
        return f"send-keys -t '{chair}' -l '{text}' ; send-keys -t '{chair}' Enter"

    def mark(on):
        return "• " if on else "  "

    win = tmx("display-message", "-p", "-t", pane, "#{window_id}")
    names = models_for(tool, homes(win).get(tool))
    if model and canon(model) not in [canon(n) for n in names]:
        names.insert(0, model)
    used = used_models(win)
    me = opt("@council_name")
    items = []
    for key, name in zip(MODEL_KEYS, names):
        who = used.get(canon(name))
        if who and who != me:            # another member runs it: no model twice at the table
            items += [f"-  {model_label(name)}  (@{who} has it)", key, ""]
        else:
            items += [mark(canon(name) == canon(model)) + model_label(name), key, send(f"/model @{handle} {name}")]
    items += [mark(not model) + f"default model ({default or 'its own'})", "0", send(f"/model @{handle} default")]
    items += ["  another model…", "o", popup_ask(chair, f"Model for @{handle}", f"/model @{handle} %s")]
    items += [""]
    lean = opt("@council_lean") or "free"
    for key, (side, text) in zip("OGF", (("opposition", "side: opposition (always against the chair)"),
                                          ("government", "side: government (for the chair and its agenda)"),
                                          ("free", "side: free will (no side)"))):
        items += [mark(side == lean) + text, key, send(f"/lean @{handle} {side}")]
    items += [""]
    perm = opt("@council_perm") or "plan"
    keys = {"minimal": "n", "low": "l", "medium": "e", "high": "h", "xhigh": "x", "max": "X"}
    if EFFORTS[tool]:
        for e in EFFORTS[tool]:
            items += [mark(e == effort) + f"effort {e}", keys[e], send(f"/effort @{handle} {e}")]
        items += [mark(not effort) + "default effort", "d", send(f"/effort @{handle} default")]
    else:
        items += ["-  no effort setting in Gemini: pick a model", "", ""]
    items += [""]
    for key, (p, text) in zip("rwb", (("plan", "plan (read-only)"), ("edit", "edit (change files, no commands)"),
                                       ("bypass", "bypass (anything, no asking)"))):
        items += [mark(p == perm) + "permission: " + text, key, send(f"/perm @{handle} {p}")]
    tmx("display-menu", "-O", "-M", *(["-c", client] if client else []), "-t", pane,
        "-T", f"#[align=centre] @{handle}: model and effort ", "-x", "P", "-y", "P", "--", *items)
    return 0


def mark(e):
    """The phase after a name: ⚔ roast, ↻ round table (each with its round after the first)."""
    r = e.get("round", 1)
    if e.get("phase") == "roast":
        return " ⚔" + (f" {r}" if r > 1 else "")
    return " ↻" + (f" {r}" if r > 1 else "") if e.get("phase") == "table" else ""


def lines_of(text, width):
    out = []
    for line in text.split("\n"):
        if not line.strip():
            out.append("")
            continue
        lead = line[:len(line) - len(line.lstrip())]
        out.extend(textwrap.wrap(line, width, subsequent_indent=lead, break_on_hyphens=False) or [""])
    while out and not out[-1]:
        out.pop()
    return out


def bubble(name, text, kind, right):
    """A chat message in a member's pane: that member's own on the right, everyone else's (yours
    included) on the left; the name in bold and the text in the speaker's colour, wrapped to four
    fifths of the pane."""
    cols = max(24, shutil.get_terminal_size((80, 20)).columns - 1)
    width = max(20, cols * 4 // 5)
    body = lines_of(text, width)
    if not TTY:
        return name + "\n" + "\n".join(body) + "\n\n"
    code = C.get(kind, C["agent"])
    head = f"\033[1;{code}m{name}\033[0m"
    if right:
        span = max([len(name)] + [len(l) for l in body])
        pad = " " * max(0, cols - span)
        return (" " * max(0, cols - len(name)) + head + "\n" +
                "\n".join(pad + f"\033[{code}m{l}\033[0m" for l in body) + "\n\n")
    return head + "\n" + "\n".join(f"\033[{code}m{l}\033[0m" for l in body) + "\n\n"


def remove(pane):
    """✕ in a member's header (or Alt+Q there): /remove, typed into the chat box. An agent you made is
    deleted for good; an LLM's own seat leaves the table (the + in the bottom bar brings it back). The
    grid is dealt again without it."""
    handle = tmx("show-options", "-pqv", "-t", pane, "@council_member")
    chair = tmx("show-options", "-pqv", "-t", pane, "@council_chair")
    if handle == ALL and chair:
        tmx("send-keys", "-t", chair, "-l", "/view grid")
        tmx("send-keys", "-t", chair, "Enter")
        return 0
    if handle and chair:
        # what every council understands, one opened before /remove was there too: an agent you made
        # (any name that is not an LLM's) is deleted, an LLM's own seat benched
        tmx("send-keys", "-t", chair, "-l", f"/bench {handle}" if handle in TOOLS else f"/agent del {handle}")
        tmx("send-keys", "-t", chair, "Enter")
    return 0


def add_menu(client, win):
    """+ in the bottom bar of a council tab: another seat of an LLM, on the model you pick (a seat of it
    that left the table comes back on it), a new agent, or an agent with a character that left. The pick
    is typed into the chat box (/agent more, /agent new, /seat)."""
    chair = tmx("show-options", "-wqv", "-t", win, "@council_chair")
    if not chair:
        return 0
    full = tmx("show-options", "-wqv", "-t", win, "@council_full") == "1"
    grey = "-" if full else ""
    # every agent you made with a character, with its lean: the ones at the table greyed, the others
    # to bring to it
    agents = [a for a in read_json(CONF).get("agents", []) if a.get("persona")]
    seated = {x.split("=")[0] for x in tmx("show-options", "-wqv", "-t", win, "@council_seated").split(";") if x}
    items = ["-Agents you made", "", ""] if agents else []
    key = iter("123456789")
    for a in agents:
        h = handle_of(a.get("name", ""))
        what = f"@{h}  ({LEAN_SHOWN.get(a.get('lean') or 'free', 'free will')})"
        if h in seated:
            items += [f"-  {what}  at the table", "", ""]
        else:
            items += [f"{grey}  {what}", next(key, ""), f"send-keys -t '{chair}' -l '/seat {h}' ; send-keys -t '{chair}' Enter"]
    if items:
        items += [""]
    for key, tool in zip("cxga", ("claude", "codex", "gemini", "agy")):
        items += [f"{grey}Another {TOOLS[tool]} seat…", key,
                  f"run-shell -b \"'{ME}' --model-menu '{client}' '{win}' {tool}\""]
    if full:
        items += ["-The table is full (9): ✕ someone first", "", ""]
    if tmx("show-options", "-wqv", "-t", win, "@council_seated"):
        items += ["", "Remove everyone…", "r", f"run-shell -b \"'{ME}' --clear-menu '{client}' '{win}'\""]
    # a form in the middle of the screen (tmux's own prompt sits on the bottom line)
    items += ["", f"{grey}New agent…", "n",
              f"display-popup -E -x C -y C -w 84 -h 32 -T ' New agent ' \"'{ME}' --new-agent '{chair}' '{win}'\""]
    tmx("display-menu", "-O", "-M", *(["-c", client] if client else []), "-T", "#[align=centre] Add to the council ",
        "-x", "C", "-y", "C", "--", *items)
    return 0


def used_models(win):
    """{model: who runs it} at the table of that council tab (what the council last wrote there)."""
    return dict(x.split("=", 1) for x in tmx("show-options", "-wqv", "-t", win, "@council_used").split(";")
                if "=" in x)


def homes(win):
    return dict(x.split("=", 1) for x in tmx("show-options", "-wqv", "-t", win, "@council_homes").split(";")
                if "=" in x)


def model_menu(client, win, tool):
    """+ add, Another X seat: which model the new seat runs. Every model that LLM can run; one that a
    member at the table runs already is shown, greyed, with who runs it (never twice at the table)."""
    chair = tmx("show-options", "-wqv", "-t", win, "@council_chair")
    if not chair or tool not in TOOLS:
        return 0
    used = used_models(win)
    items = []
    for key, model in zip(MODEL_KEYS, models_for(tool, homes(win).get(tool))):
        who = used.get(canon(model))
        items += [f"-{model_label(model)}  (@{who} has it)" if who else model_label(model), key,
                  f"send-keys -t '{chair}' -l '/agent more {tool}:{model}' ; send-keys -t '{chair}' Enter"]
    if not any(not i.startswith("-") for i in items[0::3]):
        items += ["", f"-Every {TOOLS[tool]} model is at the table", "", ""]
    items += ["", "Another model…", "o", popup_ask(chair, f"Model for the new {TOOLS[tool]} seat",
                                                 f"/agent more {tool}:%s")]
    tmx("display-menu", "-O", "-M", *(["-c", client] if client else []), "-T",
        f"#[align=centre] Another {TOOLS[tool]} seat: which model? ", "-x", "C", "-y", "C", "--", *items)
    return 0


def popup_ask(chair, question, template):
    """A tmux command for a menu: one question in a small pop-up in the middle of the screen; the answer
    goes into the template (%s) and is typed into the chat box."""
    return (f"display-popup -E -x C -y C -w 72 -h 7 -T ' {question} ' "
            f"\"'{ME}' --ask '{chair}' '{question}' '{template}'\"")


def ask_popup(chair, question, template):
    """Inside the pop-up: ask, then type the command into the chat box. Esc, Ctrl+C or an empty answer:
    nothing is sent."""
    try:
        sys.stdout.write(f"\n  {question}\n\n")
        answer = input("  > ").strip()
    except (EOFError, KeyboardInterrupt):
        return 0
    if answer and re.fullmatch(r"[\w.:/@-]+", answer):
        tmx("send-keys", "-t", chair, "-l", template.replace("%s", answer))
        tmx("send-keys", "-t", chair, "Enter")
    elif answer:
        input("  Not a model name (letters, digits, . : / - only). Enter to close. ")
    return 0


def new_agent_form(chair, win):
    """+ add, New agent…: a form in a pop-up in the middle of the screen. Name, LLM, model (every
    version it can run; one a member runs already is marked and refused), character, soul, rules; then
    /agent new is typed into the chat box. Ctrl+C or Esc at any question: nothing is made."""
    out = sys.stdout
    taken = {handle_of(a.get("name", "")) for a in read_json(CONF).get("agents", [])} | set(TOOLS)
    taken |= {x.split("=")[1] for x in tmx("show-options", "-wqv", "-t", win, "@council_seated").split(";") if "=" in x}
    used = used_models(win)

    def ask(q, hint=""):
        out.write(paint(f"  {q}", "chair") + (paint(f"  {hint}", "note") if hint else "") + "\n")
        out.flush()
        return input("  > ").strip()

    try:
        out.write(paint("\n  A new agent for the council", "chair") + paint("  (Ctrl+C: cancel)", "note") + "\n\n")
        while True:
            name = ask("Name", "one word, e.g. Skeptic")
            if not re.fullmatch(r"[A-Za-z][\w-]{0,30}", name):
                out.write(paint("  One word: letters, digits, - or _.\n", "err"))
            elif handle_of(name) in taken:
                out.write(paint(f"  There is a member or agent called {name} already.\n", "err"))
            else:
                break
        tools = list(TOOLS)
        while True:
            pick = ask("LLM", "   ".join(f"{i} {TOOLS[t]}" for i, t in enumerate(tools, 1))).lower()
            tool = tools[int(pick) - 1] if pick.isdigit() and 0 < int(pick) <= len(tools) else \
                ALIAS.get(pick, pick)
            if tool in TOOLS:
                break
            out.write(paint("  Pick 1 to 4.\n", "err"))
        models = models_for(tool, homes(win).get(tool))
        out.write("\n")
        for i, mdl in enumerate(models, 1):
            who = used.get(canon(mdl))
            out.write(f"   {i:2} " + (paint(f"{model_label(mdl)}  (@{who} has it)", "note") if who else model_label(mdl))
                      + "\n")
        while True:
            pick = ask("Model", "its number, a name, or Enter for its LLM's default")
            model = models[int(pick) - 1] if pick.isdigit() and 0 < int(pick) <= len(models) else pick
            if model and not re.fullmatch(r"[\w.:/-]+", model):
                out.write(paint("  Not a model name.\n", "err"))
            elif model and used.get(canon(model)):
                out.write(paint(f"  @{used[canon(model)]} runs {model} already: pick another.\n", "err"))
            else:
                break
        out.write("\n")
        while True:
            character = ask("Character", "who it is and how it talks")
            if character:
                break
            out.write(paint("  An agent needs a character (a seat without one: + add, Another … seat).\n", "err"))
        soul = ask("Soul", "what it cares about most (Enter to leave it for later)")
        rules = ask("Rules", "what it must or must never do (Enter to leave it for later)")
        while True:
            lean = lean_of(ask("Lean", "1 Opposition (always against the chair)   2 Government (for the chair and "
                                       "its agenda)   3 Free will (no sides; Enter)") or "3")
            if lean:
                break
            out.write(paint("  Pick 1, 2 or 3.\n", "err"))
        spec = tool + (f":{model}" if model else "")
        if ask(f"Make @{handle_of(name)} on {TOOLS[tool]}" + (f" {model}" if model else "") + "?", "Enter or y: yes, n: no"
               ).lower() in ("n", "no"):
            return 0
    except (EOFError, KeyboardInterrupt):
        return 0
    text = f"/agent new {name} {spec} {character} || {soul} || {rules} || {lean}"
    tmx("send-keys", "-t", chair, "-l", " ".join(text.split()))
    tmx("send-keys", "-t", chair, "Enter")
    return 0


def clear_menu(client, target):
    """Remove everyone…: asks first. Then /remove all: every member leaves the table as ✕ on it would (an
    agent you made is deleted, its folder kept in agents/_removed; an LLM's seat is benched)."""
    chair = tmx("show-options", "-wqv", "-t", target, "@council_chair")
    seated = [x.split("=") for x in tmx("show-options", "-wqv", "-t", target, "@council_seated").split(";") if x]
    if not chair or not seated:
        return 0
    made = sum(1 for x in seated if len(x) == 3 and x[2] == "1")
    title = f"#[align=centre] Take all {len(seated)} off the table? " + (
        f"({made} you made: deleted, folders kept) " if made else "")
    tmx("display-menu", "-O", "-M", *(["-c", client] if client else []), "-T", title, "-x", "C", "-y", "C", "--",
        "Yes, remove everyone", "y", f"send-keys -t '{chair}' -l '/remove all' ; send-keys -t '{chair}' Enter",
        "", "No, keep them", "n", "")
    return 0


def one_menu(client, pane):
    """✕ or Alt+Q on the one view: who to take off the table (an agent you made is deleted for good, an
    LLM's seat benched, as ✕ on its own pane does in the grid), back to one pane each, or close."""
    chair = tmx("show-options", "-pqv", "-t", pane, "@council_chair")
    if not chair:
        return 0

    def send(text):
        return f"send-keys -t '{chair}' -l '{text}' ; send-keys -t '{chair}' Enter"

    seated = [x.split("=") for x in tmx("show-options", "-wqv", "-t", pane, "@council_seated").split(";") if x]
    items = []
    for key, (handle, name, made) in zip("123456789", [x for x in seated if len(x) == 3]):
        items += [f"Delete agent @{name} for good" if made == "1" else f"Remove @{name} (+ add brings it back)", key,
                  send(f"/agent del {handle}" if made == "1" else f"/bench {handle}")]
    if not items:
        items += ["-Nobody at the table", "", ""]
    if seated:
        items += ["Remove everyone…", "a", f"run-shell -b \"'{ME}' --clear-menu '{client}' '{pane}'\""]
    items += ["", "Back to one pane per member", "g", send("/view grid"),
              "Close the council", "q", send("/quit"), "", "Cancel", "n", ""]
    tmx("display-menu", "-O", "-M", *(["-c", client] if client else []), "-t", pane, "-T", "#[align=centre] Take who off? ",
        "-x", "C", "-y", "C", "--", *items)
    return 0


def wrapped(text, kind=None):
    """Text wrapped at word boundaries to this pane's width (the terminal itself cuts mid-word)."""
    width = max(20, shutil.get_terminal_size((80, 20)).columns - 1)
    out = []
    for line in text.split("\n"):
        if not line.strip():
            out.append("")
            continue
        lead = line[:len(line) - len(line.lstrip())]
        out.extend(textwrap.wrap(line, width, initial_indent="", subsequent_indent=lead, break_on_hyphens=False,
                                 drop_whitespace=True) or [""])
    body = "\n".join(out)
    return paint(body, kind) if kind else body


def view(feed, handle, owner):
    """A member's pane: the chair's messages (dim) and this member's answers, as they come; a spinner
    while it thinks. Ends when the council (pid owner) has closed."""
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    out = sys.stdout
    fd, old = sys.stdin.fileno(), None
    try:                     # keys without Enter and without echo: m opens this member's menu
        import termios
        import tty
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)
    except Exception:  # noqa: BLE001
        old = None
    try:
        return follow(feed, handle, owner, out, fd)
    finally:
        if old is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)


def follow(feed, handle, owner, out, fd):
    import select
    pos, since, spun = 0, None, False
    one, thinking = handle == ALL, []      # the one view: everyone's answers, yours on the right
    while True:
        chunk = b""
        try:
            with open(feed, "rb") as f:
                f.seek(pos)
                chunk = f.read()
        except OSError:
            pass
        if chunk:
            lines = chunk.split(b"\n")
            pos += len(chunk) - len(lines[-1])
            for raw in lines[:-1]:
                try:
                    e = json.loads(raw)
                except ValueError:
                    continue
                if spun:
                    out.write("\r\033[K")
                    spun = False
                t = e.get("t")
                if t == "reset":
                    out.write("\033[2J\033[H")
                elif t == "status":
                    running = e.get("who", [])
                    if handle in running or (one and running):
                        since = since or time.time()
                        thinking = [(e.get("names") or {}).get(h, h) for h in running]
                    else:
                        since = None
                elif t == "msg" and e.get("who") == "chair":
                    out.write(bubble("you", e.get("text", ""), "you", right=one))
                elif t == "msg" and e.get("who") == handle:
                    kind = "err" if e.get("problem") else e.get("kind", "agent")
                    out.write(bubble("@" + (e.get("as") or handle) + mark(e), e.get("text", ""), kind, right=True))
                    since = None
                elif t == "msg" and not e.get("problem"):
                    out.write(bubble("@" + (e.get("as") or e.get("who", "?")) + mark(e), e.get("text", ""), e.get("kind", "agent"),
                                     right=False))
        if since:
            frame = SPIN[int(time.time() * 10) % len(SPIN)]
            who = (" ".join("@" + n for n in thinking) + " ") if one else ""
            out.write("\r\033[K" + paint(f"{frame} {who}thinking  {int(time.time() - since)}s", "note"))
            spun = True
        out.flush()
        try:
            os.kill(owner, 0)
        except OSError:
            out.write(("\r\033[K" if spun else "") + paint("(the council has closed)", "note") + "\n")
            out.flush()
            time.sleep(1)
            return 0
        try:
            ready = select.select([fd], [], [], 0.12)[0]
        except (OSError, ValueError):
            ready = []
            time.sleep(0.12)
        if ready:
            try:
                key = os.read(fd, 16)
            except OSError:
                key = b""
            if key[:1] in (b"m", b"M", b"\r", b"\n"):
                me = os.environ.get("TMUX_PANE", "")
                menu(tmx("display-message", "-p", "-t", me, "#{client_name}"), me)


# ---- commands ------------------------------------------------------------------------------------------
def build_members(conf, accts, out=None):
    """Every member the council knows; who sits at the table is this project's own (seats), so taking
    someone off in one project's council leaves the others alone."""
    seats = conf.get("seats") or {}
    members = []
    for tool in TOOLS:
        acct, signed, folder = accts.get(tool, (None, False, None))
        st = conf.get("llm", {}).get(tool, {})
        m = Member(TOOLS[tool], tool, account=acct, model=st.get("model"), effort=st.get("effort"), folder=folder)
        m.perm = st.get("perm")
        m.lean = st.get("lean") or "free"
        m.signed = bool(acct and signed)
        m.seated = m.signed and seats.get(tool, True)
        if acct is None:
            m.seated = False
        members.append(m)
        if out is not None and not m.seated:
            why = "taken off the table (+ add brings it back)" if seats.get(tool) is False else \
                f"{'not signed in' if acct else 'no account'} (/seat {tool} to try it anyway)"
            out.append(f"{TOOLS[tool]} sits out: {why}")
    for a in conf["agents"]:
        tool = a.get("tool")
        if tool not in TOOLS:
            continue
        acct = a.get("account") or accts.get(tool, (None, False, None))[0]
        folder = accts.get(tool, (None, False, None))[2] if acct == accts.get(tool, (None,))[0] else None
        m = Member(a["name"], tool, account=acct, model=a.get("model"), persona=a.get("persona", ""), made=True,
                   effort=a.get("effort"), folder=folder)
        m.soul, m.rules = a.get("soul", ""), a.get("rules", "")
        m.powers = list(a.get("powers") or [])
        m.lean = a.get("lean") or "free"        # an extra seat without a character too
        m.perm = (conf.get("agent_perm") or {}).get(a["name"])
        m.seated = seats.get(m.handle, True)
        members.append(m)
    return members


def tags(text, meeting):
    """Who a message is for: the @names it starts with, in that order; [] = everyone (no @name in
    front, or @all). An @name further on is only a mention ("kick out @claude?" goes to everyone).
    None = a leading @name nobody has."""
    lead = re.match(r"\s*((?:@[\w.-]+[\s,:;]*)+)", text)
    if not lead:
        return []
    found, unknown, off = [], [], []
    for w in re.findall(r"@([\w.-]+)", lead.group(1)):
        w = w.rstrip(".-")
        if w.lower() == "all":
            return []
        m = meeting.find(w)
        if m and not m.seated:
            off.append(m)
        elif m and m not in found:
            found.append(m)
        elif not m:
            unknown.append(w)
    if off:          # a member taken off the table is not asked, even by name
        note(", ".join("@" + m.shown() for m in off) + (" is" if len(off) == 1 else " are") +
             " off the table: + add (or /seat) brings it back.")
    if (unknown or off) and not found:
        if unknown:
            note("No member called " + ", ".join("@" + u for u in unknown) + ". /agents lists them.")
        return None
    return found


def command_line(line, meeting, conf, accts):
    """A /command. Returns False to leave."""
    parts = line[1:].split()
    cmd, args = (parts[0].lower(), parts[1:]) if parts else ("help", [])
    if cmd in ("quit", "exit", "q"):
        return False
    if cmd == "help":
        print(__doc__.split("\n\n", 1)[1].split("\nMembers only read")[0])
    elif cmd == "new":
        pass                      # the meeting itself is swapped by the caller
    elif cmd in ("mode", "roast", "order"):
        # /mode alone switches between the two; /roast and /order go straight to one
        want = cmd if cmd != "mode" else (args[0].lower() if args else ("roast" if meeting.mode == "order" else "order"))
        if want in ("order", "roast"):
            meeting.mode = want
            conf["mode"] = meeting.mode
            save_conf(conf)
        note(f"Mode: {meeting.mode} (" + ("everyone answers at once, then round the table one by one"
             if meeting.mode == "order" else "everyone at once, then everyone roasts the others") + ")")
    elif cmd == "length":
        try:
            conf["words"] = max(10, min(400, int(args[0])))
            save_conf(conf)
        except (IndexError, ValueError):
            pass
        note(f"Answers: at most {meeting.words()} words each (roasts: one or two sentences per member). "
             "/length N changes it.")
    elif cmd == "lean":
        who = [w for w in args if w.startswith("@")]
        vals = [w for w in args if not w.startswith("@")]
        lean = lean_of(vals[-1]) if vals else ""
        if not lean or not who:
            note("Sides: " + "  ".join(f"@{m.shown()} {LEAN_SHOWN[getattr(m, 'lean', 'free')]}" for m in meeting.seated())
                 + " · /lean @name opposition|government|free (@all for everyone)")
            return True
        targets = meeting.seated() if any(w.lower() in ("@all", "@everyone") for w in who) else \
            [meeting.find(w[1:].rstrip(".,")) or w for w in who]
        done = []
        for m in targets:
            if isinstance(m, str):
                note(f"No member called {m}.")
                continue
            m.lean = lean
            if m.made:
                for a in conf["agents"]:
                    if a["name"] == m.name:
                        a["lean"] = lean
            else:
                conf.setdefault("llm", {}).setdefault(m.tool, {})["lean"] = lean
            done.append("@" + m.shown())
        if done:
            save_conf(conf)
            note(" ".join(done) + f" now {'leans' if len(done) == 1 else 'all lean'} {LEAN_SHOWN[lean]}" + {
                "opposition": ": always against the chair.", "government": ": for the chair and its agenda.",
                "free": ": no side."}[lean])
        if GRID[0]:
            GRID[0].relabel(meeting)
    elif cmd == "names":
        if args and args[0].lower() in ("model", "llm"):
            conf["names"] = NAMES["by"] = args[0].lower()
            save_conf(conf)
        note("Names: " + ("each LLM goes by the model it runs on (@opus, @gpt-6-astra); agents with a character "
                          "keep their names" if NAMES["by"] == "model" else "each LLM goes by its own name (@claude, "
                          "@codex)") + ". /names model|llm changes it; @claude still finds it either way.")
        if GRID[0]:
            GRID[0].relabel(meeting)
    elif cmd == "rounds":
        if meeting.mode == "roast":
            try:
                meeting.roasts = max(0, min(50, int(args[0])))
            except (IndexError, ValueError):
                pass
            note("Roast mode: " + ("round after round until Ctrl+C." if not meeting.roasts else
                 f"{meeting.roasts} roast round(s) per message.") + " /rounds N sets it, 0 = until Ctrl+C.")
        else:
            if args and args[0].lower() in ("none", "off", "-1"):
                meeting.rounds = -1
            else:
                try:
                    meeting.rounds = max(0, min(50, int(args[0])))
                except (IndexError, ValueError):
                    pass
            note("Order mode: everyone answers, then " + (
                "round the table again and again until Ctrl+C (or everyone passes)." if meeting.rounds == 0 else
                "no round table (answers only)." if meeting.rounds < 0 else
                f"{meeting.rounds} pass(es) round the table per message.") +
                " /rounds N, 0 = until Ctrl+C, none = answers only.")
    elif cmd == "topic":
        if args:
            meeting.topic = " ".join(args)
        note(f"Topic: {meeting.topic or '(your first message)'}")
    elif cmd == "agents":
        for m in meeting.members:
            state = "" if m.seated else "  (benched)"
            print(paint(f"  {m.label()}", m.colour()) + (f": {m.persona}" if m.made and m.persona else "") +
                  paint(state, "note"))
    elif cmd in ("remove", "kick"):
        # ✕ on a member's header: an agent you made is deleted, not benched (gone from every council;
        # + add makes a new one); an LLM's own seat (its account) can only leave this table
        if [w.lower().lstrip("@") for w in args] in (["all"], ["everyone"]):
            gone = meeting.seated()
            for m in gone:
                with contextlib.redirect_stdout(io.StringIO()):     # one note for all, not one each
                    command_line(f"/agent del {m.handle}" if m.made else f"/bench {m.handle}", meeting, conf, accts)
            note(f"Everyone left the table ({len(gone)}). + add brings seats back." if gone else
                 "Nobody is at the table.")
            return True
        for w in args:
            m = meeting.find(w.lstrip("@"))
            if not m:
                note(f"No member called {w}.")
            else:
                command_line(f"/agent del {m.handle}" if m.made else f"/bench {m.handle}", meeting, conf, accts)
    elif cmd in ("bench", "seat"):
        for w in args:
            m = meeting.find(w.lstrip("@"))
            if not m:
                note(f"No member called {w}.")
                continue
            if cmd == "seat" and not m.seated and len(meeting.seated()) >= MAX_SEATS:
                note(f"The table is full ({MAX_SEATS} at most): ✕ someone first.")
                continue
            if cmd == "seat" and not m.account:
                note(f"{m.name} has no account in the fleet's list (agents --accounts).")
                continue
            if cmd == "seat" and not m.seated and not (m.made and m.persona):
                other = meeting.runs_model(m.runs_on()[0], but=m)
                if other:
                    note(f"@{m.shown()} runs {m.runs_on()[0]}, which @{other.shown()} runs already: give it another "
                         f"model first (/model @{m.handle} …) or ✕ @{other.shown()}.")
                    continue
            m.seated = cmd == "seat"
            if not m.seated:
                stop_member(m.handle)      # taken off the table: what it was answering stops now
            # kept for this folder's council only (the next council here starts the same way)
            conf.setdefault("seats", {})[m.handle] = m.seated
            save_conf(conf)
            note(f"{m.label()} {'is at the table' if m.seated else 'is benched'}.")
    elif cmd == "agent":
        sub = args[0].lower() if args else ""
        if sub in ("more", "another") and len(args) >= 2:
            # another seat for an LLM, no character: "Claude 2", "Codex 3"…; its model: Alt+M on its pane
            spec = parse_llm(args[1])
            if spec:
                tool, acct, model, effort = spec
                home = next((m.home for m in meeting.members if m.tool == tool and m.home), None)
                if model and meeting.runs_model(model):
                    note(f"@{meeting.runs_model(model).shown()} runs {model} already: no model twice at the table. "
                         f"Pick another: + add, Another {TOOLS[tool]} seat.")
                    return True
                if not model:          # no model asked for: the first of its list that nobody at the table runs
                    model = next((x for x in models_for(tool, home) if not meeting.runs_model(x)), None)
                    if not model:
                        note(f"Every {TOOLS[tool]} model is at the table already.")
                        return True
                # a seat of this LLM that left the table (its own, or an extra one) comes back on this model:
                # no Claude2 while Claude's own seat is off
                back = next((x for x in meeting.members if x.tool == tool and not x.seated and not (x.made and x.persona)
                             and getattr(x, "signed", True) and (x.account or x.made)
                             and (not acct or x.account == acct)), None)
                if back:
                    back.model = model
                    if back.made:
                        for a in conf["agents"]:
                            if a["name"] == back.name:
                                a["model"] = model
                    else:
                        conf.setdefault("llm", {}).setdefault(tool, {})["model"] = model
                    save_conf(conf)
                    return command_line(f"/seat {back.handle}", meeting, conf, accts)
                base = "Agy" if tool == "agy" else TOOLS[tool]
                n = 2
                while meeting.find(f"{base}{n}"):
                    n += 1
                spec_text = tool + (f"@{acct}" if acct else "") + f":{model}" + (f":{effort}" if effort else "")
                args = ["new", f"{base}{n}", spec_text, ""]
                sub = "new"
        if sub in ("new", "add") and len(args) >= 4 and len(meeting.seated()) >= MAX_SEATS:
            note(f"The table is full ({MAX_SEATS} at most): ✕ someone first, then + add.")
        elif sub in ("new", "add") and len(args) >= 4:
            name, spec, persona = args[1], parse_llm(args[2]), " ".join(args[3:]).strip()
            persona, soul, rules, lean = (persona.split("||") + ["", "", ""])[:4]   # CHARACTER || SOUL || RULES || LEAN
            persona, soul, rules, lean = persona.strip(), soul.strip(), rules.strip(), lean_of(lean) or "free"
            if not spec:
                note("LLM must be claude, codex, gemini or agy (with @account, :model and :effort if you like, "
                     "e.g. claude:opus:high).")
            elif meeting.find(name):
                note(f"There is a member called {name} already.")
            else:
                tool, acct, model, effort = spec
                conf["agents"].append({"name": name, "tool": tool, "account": acct, "model": model, "effort": effort,
                                       "persona": persona, "soul": soul, "rules": rules, "lean": lean})
                save_conf(conf)
                cur = accts.get(tool, (None, False, None))
                m = Member(name, tool, account=acct or cur[0], model=model, persona=persona, made=True, effort=effort,
                           folder=cur[2] if not acct or acct == cur[0] else None)
                m.soul, m.rules, m.lean = soul, rules, lean
                meeting.members.append(m)
                where = ""
                if persona:
                    d = ensure_agent(meeting.owner, name, persona, soul, rules)
                    where = f" Its soul, character, rules and memory: {os.path.relpath(d, meeting.owner)}/"
                note(f"{m.label()} joins the table. Tag it as @{m.shown()}.{where}")
        elif sub == "lean" and len(args) >= 2:
            m = meeting.find(args[1].lstrip("@"))
            lean = lean_of(args[2]) if len(args) > 2 else ""
            if not m:
                note(f"No member called {args[1]}.")
            elif not lean:
                note(f"@{m.shown()} leans {LEAN_SHOWN[getattr(m, 'lean', 'free')]}. /agent lean NAME opposition | "
                     "government | free")
            else:
                m.lean = lean
                for a in conf["agents"]:
                    if a["name"] == m.name:
                        a["lean"] = lean
                save_conf(conf)
                note(f"@{m.shown()} now leans {LEAN_SHOWN[lean]}" + {
                    "opposition": ": always against the chair.", "government": ": for the chair and its agenda.",
                    "free": ": no side."}[lean])
                if GRID[0]:
                    GRID[0].relabel(meeting)
        elif sub == "power" and len(args) >= 3:
            m = meeting.find(args[1].lstrip("@"))
            power, on = args[2].lower(), (args[3].lower() if len(args) > 3 else "on") not in ("off", "no", "0")
            if not m or not m.made or not m.persona:
                note(f"No agent with a character called {args[1]} (powers are for agents you made).")
            elif power != "remove":
                note("The power there is: remove (take a member off the table on its own judgement).")
            else:
                m.powers = sorted(set(getattr(m, "powers", [])) | {power}) if on else \
                    [x for x in getattr(m, "powers", []) if x != power]
                for a in conf["agents"]:
                    if a["name"] == m.name:
                        a["powers"] = m.powers
                save_conf(conf)
                note(f"@{m.shown()} " + ("may now remove members on its own judgement, saying why: an agent is "
                                         "deleted with its memory wiped, an LLM's seat leaves the table." if on else
                                         "no longer removes members."))
        elif sub in ("del", "rm", "remove") and len(args) >= 2:
            m = meeting.find(args[1].lstrip("@"))
            if not m or not m.made:
                note(f"No made agent called {args[1]}.")
            else:
                name = m.shown()
                m.seated = False
                stop_member(m.handle)            # what it was answering stops now
                conf["agents"] = [a for a in conf["agents"] if a["name"] != m.name]
                d = agent_dir(meeting.owner, m.name)
                if m.persona and os.path.isdir(d):       # moved aside, with its memory, never deleted
                    try:
                        aside = os.path.join(agents_dir(meeting.owner), "_removed")
                        os.makedirs(aside, exist_ok=True)
                        os.replace(d, os.path.join(aside, f"{handle_of(m.name)}-{time.strftime('%Y%m%d-%H%M%S')}"))
                    except OSError:
                        pass
                (conf.get("agent_perm") or {}).pop(m.name, None)
                (conf.get("seats") or {}).pop(m.handle, None)
                save_conf(conf)
                meeting.members.remove(m)
                note(f"@{name} ({m.name}) is removed for good, not benched. + add makes a new one.")
        else:
            note("/agent new NAME LLM PERSONA…   e.g. /agent new Skeptic claude A CFO who hates spending money")
    elif cmd in ("model", "effort"):
        who = [w for w in args if w.startswith("@")]
        vals = [w for w in args if not w.startswith("@")]
        if not who or not vals:
            for m in meeting.seated():
                print(paint(f"  @{m.handle}", m.colour()) + f"  model: {m.model or 'its default'}   effort: " +
                      (m.effort or "its default" if EFFORTS[m.tool] else "(none: Gemini has only the model)"))
            note(f"/{cmd} @name VALUE sets it (@all for everyone), /{cmd} @name default goes back to the default. "
                 "/models lists the names.")
            return True
        value = vals[-1]
        value = None if value.lower() in ("default", "none", "-") else value
        targets = meeting.seated() if any(w.lower() in ("@all", "@everyone") for w in who) else \
            [meeting.find(w[1:].rstrip(".,")) or w for w in who]
        for m in targets:
            if isinstance(m, str):
                note(f"No member called {m}.")
                continue
            if cmd == "effort" and value is not None:
                if not EFFORTS[m.tool]:
                    note(f"@{m.handle}: Gemini's command line has no effort setting; its model is the choice "
                         f"(/model @{m.handle} gemini-4-hydrogen).")
                    continue
                if value.lower() not in EFFORTS[m.tool]:
                    note(f"@{m.handle}: effort for {TOOLS[m.tool]} is one of {', '.join(EFFORTS[m.tool])}.")
                    continue
                value = value.lower()
            if cmd == "model" and value is not None and not re.fullmatch(r"[\w.:/-]+", value):
                note(f"{value!r} is not a model name.")
                continue
            if cmd == "model" and value is not None and not (m.made and m.persona) and m.seated:
                other = meeting.runs_model(value, but=m)
                if other:
                    note(f"@{other.shown()} runs {value} already: no model twice at the table. Pick another "
                         "(Alt+M on a pane lists them).")
                    continue
            setattr(m, cmd, value)
            if m.made:
                for a in conf["agents"]:
                    if a["name"] == m.name:
                        a[cmd] = value
            else:
                conf.setdefault("llm", {}).setdefault(m.tool, {})[cmd] = value
            save_conf(conf)
            note(f"{m.label()}: {cmd} {value or 'back to its default'}.")
        if GRID[0]:
            GRID[0].relabel(meeting)
    elif cmd == "perm":
        who = [w for w in args if w.startswith("@")]
        vals = [w.lower() for w in args if not w.startswith("@")]
        value = vals[-1] if vals else ""
        if value and value not in PERMS + ("default",):
            note("Permission is plan (read-only), edit (change files, no commands) or bypass (anything, no asking).")
            return True
        if not value:
            note(f"Council: {(conf.get('perm') or 'plan').upper()}. " + " ".join(
                f"@{m.handle}: {meeting.perm_of(m)}" for m in meeting.seated() if m.perm) +
                " · /perm plan|edit|bypass for all, /perm @name … for one")
            return True
        if not who:
            conf["perm"] = None if value == "default" else value
            targets = []
        else:
            targets = meeting.seated() if any(w.lower() == "@all" for w in who) else \
                [meeting.find(w[1:].rstrip(".,")) or w for w in who]
        for m in targets:
            if isinstance(m, str):
                note(f"No member called {m}.")
                continue
            m.perm = None if value == "default" else value
            if m.made:
                conf.setdefault("agent_perm", {})[m.name] = m.perm
            else:
                conf.setdefault("llm", {}).setdefault(m.tool, {})["perm"] = m.perm
        save_conf(conf)
        shown = value if value != "default" else (conf.get("perm") or "plan")
        whom = " ".join("@" + m.handle for m in targets if not isinstance(m, str)) or "the whole council"
        note(f"{whom}: {shown.upper()}" + {
            "plan": " (read-only).", "edit": " (may change files in this folder, no commands).",
            "bypass": " ⚠ may change files and run commands in this folder with no asking; /perm plan to go back."}[shown])
        if GRID[0]:
            GRID[0].relabel(meeting)
    elif cmd == "models":
        for tool in TOOLS:
            home = next((m.home for m in meeting.members if m.tool == tool and m.home), None)
            print(paint(f"  {TOOLS[tool]}", tool) + ": " + ", ".join(models_for(tool, home)) + "   effort: " +
                  (", ".join(EFFORTS[tool]) if EFFORTS[tool] else "none"))
        note("Any name that LLM's own program takes works too (`agy models` lists Antigravity's).")
    elif cmd == "view":
        want = args[0].lower() if args else ("grid" if conf.get("view") == "one" else "one")
        want = {"single": "one", "1": "one", "all": "one", "split": "grid", "panes": "grid", "each": "grid"}.get(
            want, want)
        if want not in ("one", "grid"):
            note("/view one: everyone's answers in one pane · /view grid: one pane per member · Alt+O switches.")
            return True
        conf["view"] = want
        save_conf(conf)
        if GRID[0] and GRID[0].me and FEED["path"]:
            GRID[0].open(meeting)          # the new panes read the whole thread from the feed
        note("View: one pane for everyone, yours on the right (Alt+O: one pane per member)." if want == "one" else
             "View: one pane per member, each with its own scroll (Alt+O: one pane for everyone).")
    elif cmd == "grid":
        if args and args[0].lower() == "off":
            if GRID[0]:
                GRID[0].close()
            note("Grid off: every answer in full here.")
        elif GRID[0] is None or not GRID[0].me:
            note("The grid needs tmux: open the council with Alt+K.")
        else:
            GRID[0].open(meeting)
            note("Grid on: one pane per member, each with its own scroll." if FEED["grid"] else "No room for a grid.")
    else:
        note(f"No command /{cmd}. /help lists them.")
    return True


GRID = [None]        # the Grid of this council, when it runs in tmux
ALL = ":all"         # the one view's place in the grid (never a member's handle: those are [a-z0-9_-])


def pid_cwd(pid):
    """The folder a process is in, or ''. Linux (and WSL) reads /proc; a Mac has none, so lsof."""
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        pass
    if sys.platform == "darwin":
        try:
            r = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                               capture_output=True, text=True, timeout=5)
            for line in r.stdout.splitlines():
                if line.startswith("n/"):
                    return line[1:]
        except (OSError, subprocess.TimeoutExpired):
            pass
    return ""


def open_tab(session, pid):
    """Alt+K: a new tab with the council in the folder of the pane it was pressed in."""
    tmux = os.path.join(HOME, ".local/bin/tmux")
    tmux = tmux if os.access(tmux, os.X_OK) else "tmux"
    me = os.path.join(HOME, ".local/bin/afc-council")
    target = [] if not session else ["-t", f"={session}:"]
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        pid = 0
    subprocess.run([tmux, "new-window"] + target + ["-n", "council", f"{me} --from-pid {pid}"])
    return 0


def open_general(session):
    """Alt+Shift+K: a new tab with a council that belongs to no project. Each of its meetings is a
    folder in ~/Council, and its members work in that folder: no project's files to read, and in edit
    or bypass nothing of a project to change. It carries on its last meeting like any council."""
    os.makedirs(GENERAL, exist_ok=True)
    tmux = os.path.join(HOME, ".local/bin/tmux")
    tmux = tmux if os.access(tmux, os.X_OK) else "tmux"
    me = os.path.join(HOME, ".local/bin/afc-council")
    target = [] if not session else ["-t", f"={session}:"]
    subprocess.run([tmux, "new-window"] + target + ["-n", "council", f"{me} --general"])
    return 0


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0
    if argv[:1] == ["--open"]:
        return open_tab(argv[1] if len(argv) > 1 else "", argv[2] if len(argv) > 2 else 0)
    if argv[:1] == ["--open-general"]:
        return open_general(argv[1] if len(argv) > 1 else "")
    if argv[:1] == ["--view"] and len(argv) >= 4:
        return view(argv[1], argv[2], int(argv[3]))
    if argv[:1] == ["--menu"] and len(argv) >= 3:
        return menu(argv[1], argv[2])
    if argv[:1] == ["--remove"] and len(argv) >= 2:
        return remove(argv[1])
    if argv[:1] == ["--model-menu"] and len(argv) >= 4:
        return model_menu(argv[1], argv[2], argv[3])
    if argv[:1] == ["--new-agent"] and len(argv) >= 3:
        return new_agent_form(argv[1], argv[2])
    if argv[:1] == ["--ask"] and len(argv) >= 4:
        return ask_popup(argv[1], argv[2], argv[3])
    if argv[:1] == ["--clear-menu"] and len(argv) >= 3:
        return clear_menu(argv[1], argv[2])
    if argv[:1] == ["--one-menu"] and len(argv) >= 3:
        return one_menu(argv[1], argv[2])
    if argv[:1] == ["--add-menu"] and len(argv) >= 3:
        return add_menu(argv[1], argv[2])
    folder = os.getcwd()
    if "--from-pid" in argv:
        try:   # the pane's own folder, read from the process: tmux formats spoil "$$" in paths
            folder = pid_cwd(int(argv[argv.index("--from-pid") + 1])) or folder
        except (ValueError, IndexError):
            pass
    if "--dir" in argv:
        folder = os.path.abspath(argv[argv.index("--dir") + 1])
    if "--general" in argv:
        os.makedirs(GENERAL, exist_ok=True)
        folder = GENERAL
    g = os.path.realpath(GENERAL)
    if os.path.realpath(folder).startswith(g + os.sep):
        folder = GENERAL               # Alt+K inside one of ~/Council's meetings: that council, not a new one
    if folder in ("/", HOME):
        folder = HOME
    home = council_home(folder)
    # meetings kept the old way (side by side in logs/council): each into a folder of its own
    upgrade(os.path.join(GENERAL, "logs", "council") if home == GENERAL else home, home)
    conf = load_conf(home, folder)
    NAMES["by"] = conf.get("names") or "model"
    accts = accounts()
    outs = []
    members = build_members(conf, accts, outs)
    meeting = Meeting(folder, members, conf)
    TABLE[0] = meeting
    for m in members:                        # each agent's own folder in this project (made once, then yours)
        if m.made and m.persona:
            ensure_agent(folder, m.name, m.persona, getattr(m, "soul", ""), getattr(m, "rules", ""))
    carried = 0
    if TTY and "--new" not in argv:          # a council remembers: it carries on its folder's last meeting
        past = meetings(home)
        if past:
            carried = carry_on(meeting, past[0])
    if not meeting.dir:
        meeting.open_session()
    os.chdir(meeting.folder)
    pane = os.environ.get("TMUX_PANE", "")
    if os.environ.get("TMUX") and pane and TTY:
        tmx("rename-window", "-t", pane, "council")
        d = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "afc-council")
        os.makedirs(d, exist_ok=True)
        FEED["path"] = os.path.join(d, f"{os.getpid()}.jsonl")
        open(FEED["path"], "w").close()
        GRID[0] = Grid()
        # The grid opens by itself in a tab of its own (Alt+K); in a tab you share, /grid on asks for it
        if conf.get("grid", True) and "--no-grid" not in argv and \
                tmx("display-message", "-p", "-t", pane, "#{window_panes}") == "1":
            GRID[0].open(meeting)
    threading.Thread(target=animate, daemon=True).start()
    if TTY:
        threading.Thread(target=refresh_models, daemon=True).start()
    about = meeting.topic or next((e.get("text", "") for e in meeting.thread if e.get("who") == "chair"), "")
    remembered = (f"carrying on “{fit(about, 40)}” ({carried} messages) · /new for a fresh one · /resume for "
                  "another") if carried else ""
    if FEED["grid"]:
        replay(meeting)
        # The chat box is only for typing: the welcome sits on its note line until the first note
        BOX["note"] = (remembered or f"Council · {os.path.basename(folder) or folder} · mode {meeting.mode} · "
                       "answers in the panes above") + (" · " + outs[0] if outs and not carried else "")
    else:
        print(paint(f"Council · {os.path.basename(folder) or folder} · mode {meeting.mode}", "chair"))
        if remembered:
            note(remembered.capitalize())
        print("  At the table: " + " ".join(paint(m.label(), m.colour()) for m in meeting.seated()))
        for o in outs:
            note(o)
        note("Tag with @name, /mode order|roast, /model and /effort @name VALUE, /agent new NAME LLM PERSONA, "
             "/help. Ctrl+C stops a round.")
        print()
    if TTY:     # a hard crash (readline, a C library) leaves its Python traceback in errors.log
        try:
            import faulthandler
            d = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "afc-council")
            os.makedirs(d, exist_ok=True)
            CRASHLOG[0] = open(os.path.join(d, "errors.log"), "a")
            faulthandler.enable(CRASHLOG[0])
        except (OSError, ImportError):
            pass

    def leave(sig, frame):           # the tab was closed under it: the runs at work end with it
        stop_all()
        raise SystemExit(0)
    signal.signal(signal.SIGHUP, leave)
    signal.signal(signal.SIGTERM, leave)
    try:
        return chat(meeting, members, conf, accts, folder)
    finally:
        if TABLE[0]:
            TABLE[0].close_session()
        if GRID[0]:
            GRID[0].close()
        if FEED["path"]:
            try:
                os.unlink(FEED["path"])
            except OSError:
                pass


def chat(meeting, members, conf, accts, folder):

    def on_int(sig, frame):
        if BUSY.is_set():          # rounds are on: stop them (and the runs at work); the council stays
            STOP.set()
            stop_all()
        else:
            raise KeyboardInterrupt

    signal.signal(signal.SIGINT, on_int)
    last = None          # the members of the last round, for Enter / /again
    work = Worker() if FEED["grid"] else None
    WORKER[0] = work
    BOX["on"] = bool(work) and TTY
    TABLE[0] = meeting
    if TTY:
        setup_typing()
    if BOX["on"]:
        RL[0] = rl_lib()
        if RL[0]:      # the box redraws itself on a resize, readline's own redraw left out
            signal.signal(signal.SIGWINCH, relayout)
    while True:
        try:
            INPUT["open"] = bool(work)
            if BOX["on"]:
                draw_box()
            line = input((BOXPROMPT if BOX["on"] else PROMPT) if TTY else "")
        except EOFError:
            print()
            break
        except KeyboardInterrupt:
            if not BOX["on"]:
                print()
            # nothing to stop: say how to leave (Ctrl+C itself only ever stops a round)
            if BOX["on"]:
                BOX["note"] = "Nothing running to stop. To close the council: ✕ on this box, Alt+Q here, /quit or Ctrl+D."
            else:
                note("Nothing running to stop. /quit (or Ctrl+D) closes the council.")
            continue
        except Exception as e:  # noqa: BLE001  (the typing line went wrong: say so, keep the council)
            errlog("the typing line")
            BOX["note"] = f"⚠ the typing line went wrong ({fit(str(e), 60)}); what you typed is lost. Logged."
            if not BOX["on"]:
                note(BOX["note"])
            continue
        finally:
            INPUT["open"] = INPUT["rl"] = False
        if KEY_NEW in line:              # Alt+T: a new meeting, named by what was typed
            line = ("/new " + line.replace(KEY_NEW, "", 1).strip()).strip()
        for marker, cmd in ((KEY_MODE, "/mode"), (KEY_VIEW, "/view"), (KEY_PERM, "/perm " + {
                "plan": "edit", "edit": "bypass"}.get(conf.get("perm") or "plan", "plan"))):
            if marker in line:            # Shift+Tab or Alt+P: do it, and give back what was typed
                PENDING["text"] = line.replace(marker, "", 1)
                if BOX["on"]:
                    boxed(command_line, cmd, meeting, conf, accts)
                else:
                    command_line(cmd, meeting, conf, accts)
                if FEED["grid"] and GRID[0]:
                    GRID[0].chair_header(meeting)
                line = None
                break
        if line is None:
            continue
        line = line.strip()
        if line.split()[:1] == ["/retry"] or line.lower().startswith("/retry "):
            named = tags(line[6:].strip(), meeting) if line[6:].strip() else \
                [m for m in meeting.seated() if FAILS.get(m.handle)]
            if not named:
                note("Nobody to retry: /retry @name, or it asks the ones that went wrong last.")
                continue
            for m in named:
                FAILS[m.handle] = 0 if FAILS.get(m.handle, 0) >= 2 else FAILS.get(m.handle, 0)
            task = "Answer the chair's latest message now (your last try did not get through)."
            if work:
                work.retry(meeting, named, task)
            else:
                STOP.clear()
                meeting.parallel(named, lambda m: task, "first")
            note("Trying again: " + " ".join("@" + m.shown() for m in named))
            continue
        if line.split()[:1] == ["/resume"] or line.lower().startswith("/resume "):
            past = [f for f in meetings(meeting.home) if f != meeting.file]
            arg = line.split()[1] if len(line.split()) > 1 else ""
            if not arg:
                if BOX["on"]:
                    resume_menu(past)
                else:
                    for i, md in enumerate(past[:9], 1):
                        print(f"  {i}  {label_of(md)}")
                    note("/resume N carries on that one." if past else "No earlier meeting in this folder.")
                continue
            try:
                pick = past[int(arg) - 1]
            except (ValueError, IndexError):
                note(f"No meeting {arg}: /resume lists them.")
                continue
            if work:
                work.stop()
            meeting.save()
            meeting.close_session()
            meeting = Meeting(folder, members, conf)
            TABLE[0] = meeting
            n = carry_on(meeting, pick)
            if FEED["grid"]:
                replay(meeting)
            msg = f"Carrying on “{fit(meeting.topic or next((e.get('text', '') for e in meeting.thread if e.get('who') == 'chair'), ''), 40)}” ({n} messages)."
            if BOX["on"]:
                BOX["note"] = msg
            else:
                note(msg)
            continue
        if line.startswith("/"):
            if line.split()[0].lower() in ("/again", "/more"):
                line = ""
            else:
                seats = [m.handle for m in meeting.seated()]
                had_grid = FEED["grid"]
                if not (boxed(command_line, line, meeting, conf, accts) if BOX["on"] else
                        command_line(line, meeting, conf, accts)):
                    break
                if line.split()[0].lower() == "/new":
                    if work:
                        work.stop()
                    meeting.save()
                    meeting.close_session()
                    meeting = Meeting(folder, members, conf)
                    TABLE[0] = meeting
                    meeting.topic = line[4:].strip()
                    meeting.open_session()
                    meeting.name_session(meeting.topic)
                    with LOCK:
                        emit({"t": "reset"})
                    if BOX["on"]:
                        BOX["note"] = "A new meeting." + (f" Topic: {meeting.topic}" if meeting.topic else "")
                    else:
                        note("A new meeting." + (f" Topic: {meeting.topic}" if meeting.topic else ""))
                if FEED["grid"] and GRID[0]:
                    GRID[0].chair_header(meeting)
                if had_grid and FEED["grid"] and GRID[0] and seats != [m.handle for m in meeting.seated()]:
                    GRID[0].open(meeting)          # someone joined or left: the grid is dealt out again
                continue
        if work:
            # The grid: the round runs in the background and the chat box takes the next message at
            # once. A message typed while members answer goes into the thread now; the council
            # moves on to it when the ones at work have answered.
            if not line:
                if meeting.thread:
                    work.submit(meeting, last if last is not None else meeting.seated(), False)
                continue
            named = boxed(tags, line, meeting) if BOX["on"] else tags(line, meeting)
            if named is None:
                continue
            with LOCK:
                meeting.thread.append({"who": "chair", "name": "Chair", "text": line, "phase": "chair"})
                emit({"t": "msg", "who": "chair", "text": line, "phase": "chair"})
            meeting.name_session(meeting.topic or line)
            last = named or meeting.seated()
            work.submit(meeting, last, True, directed=named)
            continue
        STOP.clear()
        if not line:
            if not meeting.thread:
                continue
            meeting.round(last if last is not None else meeting.seated(), fresh=False)
        else:
            named = tags(line, meeting)
            if named is None:
                continue
            meeting.thread.append({"who": "chair", "name": "Chair", "text": line, "phase": "chair"})
            meeting.name_session(meeting.topic or line)
            with LOCK:
                emit({"t": "msg", "who": "chair", "text": line, "phase": "chair"})
            if not TTY:
                show(meeting.thread[-1])
            last = named or meeting.seated()
            meeting.round(last, fresh=True)
        if STOP.is_set():
            set_status([])
            note("Stopped. What was said so far is kept.")
            meeting.save()
    if work:
        work.stop()
    meeting.save()
    if meeting.file:
        note(f"Saved: {meeting.file}")
    return 0


WORKER = [None]


class Worker:
    """The grid's rounds, each in a thread of its own, started the moment its message is sent: one
    slow member never holds up the next message. A round for an older message starts no new turns
    once a newer one is sent; the answers already on their way still arrive. Ctrl+C stops them all."""

    def submit(self, meeting, targets, fresh, directed=()):
        with LOCK:
            if fresh and meeting.mode == "roast" and ROAST["meeting"] is meeting:
                # the roast goes on: everyone hears the message (it is in the thread) and answers it
                # in its next turn; the ones it was addressed to are told it was for them
                ROAST["directed"].update(m.handle for m in directed)
                return
            GEN[0] += 1
            gen = GEN[0]
        STOP.clear()
        threading.Thread(target=self.run, args=(meeting, targets, fresh, gen), daemon=True).start()

    def retry(self, meeting, members, task):
        """Ask those members again, alongside whatever is going on (a roast keeps going)."""
        STOP.clear()

        def go():
            with LOCK:
                ROUNDS[0] += 1
                BUSY.set()
            try:
                meeting.parallel(members, lambda m: task, "first")
                meeting.save()
            finally:
                with LOCK:
                    ROUNDS[0] -= 1
                    if not ROUNDS[0]:
                        BUSY.clear()
        threading.Thread(target=go, daemon=True).start()

    def run(self, meeting, targets, fresh, gen):
        try:
            meeting.round(targets, fresh, gen)
        except Exception as e:  # noqa: BLE001  (a round that breaks must not take the chat box with it)
            note(f"That round failed: {e}")
        if STOP.is_set() and gen == GEN[0] and not BUSY.is_set():
            set_status([])
            note("Stopped. What was said so far is kept.")
            meeting.save()

    def stop(self):
        """Stop every round at work (a new meeting, /quit)."""
        if BUSY.is_set():
            STOP.set()
            stop_all()
            for _ in range(100):
                if not BUSY.is_set():
                    break
                time.sleep(0.05)



if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
