TTY = sys.stdout.isatty()
C = {"rule2": "38;5;110", "rule": "38;5;60", "chair": "1;37", "claude": "38;5;173", "codex": "38;5;114",
     "gemini": "38;5;75", "agy": "38;5;141", "copilot": "38;5;117", "opencode": "38;5;216",
