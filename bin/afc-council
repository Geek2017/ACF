TOOLS = {"claude": "Claude", "codex": "Codex", "gemini": "Gemini", "agy": "Antigravity",
         "copilot": "Copilot", "opencode": "OpenCode"}
CORE_TOOLS = ("claude", "codex", "gemini", "agy")
