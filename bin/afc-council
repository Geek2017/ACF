    ("PM", "Prime Minister", "Opening Government", "Define the motion and set out the government's case: two or three arguments."),
    ("LO", "Leader of the Opposition", "Opening Opposition", "Rebut the Prime Minister and set out the opposition's case."),
    ("DPM", "Deputy Prime Minister", "Opening Government", "Rebuild the government's case against the Leader of the Opposition and add an argument."),
    ("DLO", "Deputy Leader of the Opposition", "Opening Opposition", "Rebut the Deputy Prime Minister, rebuild the opposition and add an argument."),
    ("MG", "Member of Government", "Closing Government", "Bring a new argument for the government (an extension) that the opening bench did not make."),
    ("MO", "Member of Opposition", "Closing Opposition", "Bring a new argument for the opposition (an extension) that the opening bench did not make."),
    ("GW", "Government Whip", "Closing Government", "Sum up the debate for the government: the main clashes and why your side won them. No new arguments."),
    ("OW", "Opposition Whip", "Closing Opposition", "Sum up the debate for the opposition: the main clashes and why your side won them. No new arguments."),
]
