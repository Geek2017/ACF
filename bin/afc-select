#!/usr/bin/env -S python3 -S
"""afc-select: Ctrl+A in an agent's chat box selects everything typed there, in every agent pane.

Claude Code, Codex, Gemini, Copilot, Antigravity and OpenCode each draw their own typing box, and
none of them can select what is typed in it. tmux can: Ctrl+A (tmux/tmux.conf) runs this, which
finds the box on the pane's screen (the prompt mark ❯ > › ┃ on or above the cursor's row, down to
the box's rule or a blank row), puts the pane in copy mode with the typed text selected (shown in
tmux's selection colour) and waits for one key, with what it does on the status line:

  Backspace, Delete   delete the text             Ctrl+C   copy it to the clipboard (afc-copy)
  Ctrl+X              cut it (copy, then delete)  Ctrl+V   paste over it
  a character         replaces it                 Ctrl+A   to the start of the line (as before)
  Esc                 leaves it as it was         any other key (an arrow, Enter): as usual

Deleting is done with the agent's own keys: Backspace and Delete, sized to the cursor position so
it works fast and identically in every agent. Anywhere else (a shell, an editor, a council's chat,
which has its own selecting) Ctrl+A goes to the program as it always did.

  afc-select start <pane id> <client> [in_mode cx cy pid alt cmd width]   what Ctrl+A runs
  afc-select key <pane number>                                            legacy key entry point
"""
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
TMUXBIN = os.path.join(HOME, ".local/bin/tmux") if os.access(os.path.join(HOME, ".local/bin/tmux"), os.X_OK) else "tmux"
AGENTS = frozenset(("claude", "codex", "gemini", "copilot", "agy", "opencode"))
AGENTS_B = frozenset(a.encode() for a in AGENTS)
MARKS = "❯>›┃"                 # the prompt marks: Claude, Antigravity/Gemini, Codex, Copilot's boxed one
RULE = frozenset("─━═▄▀▔▁╌┄┈╭╮╰╯┌┐└┘╻╹")
BORDER = "│┃"
EDITORS = frozenset(("vim", "nvim", "vi", "nano", "emacs", "less", "more", "man"))
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "afc-select")
SGR = re.compile(r"\x1b\[([0-9;:]*)m")
ESC = re.compile(r"\x1b(?:\[[0-9;:?]*[A-Za-z]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[()][A-Za-z0-9]|.)")
MAX_ROWS = 40                  # how far up from the cursor the prompt mark may be
_UD = None


def tmux(*args):
    try:
        r = subprocess.run([TMUXBIN, *args], capture_output=True, text=True, timeout=5)
        return r.stdout.rstrip("\n") if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def width(ch):
    if ord(ch) < 128:
        return 1
    global _UD
    if _UD is None:
        import unicodedata as _UD
    if _UD.combining(ch):
        return 0
    return 2 if _UD.east_asian_width(ch) in ("W", "F") else 1


def sgr(state, params):
    """Follow an SGR sequence: faint, reverse-video, and foreground colour."""
    p = [int(x) if x.isdigit() else 0 for x in re.split("[;:]", params or "0")]
    i = 0
    while i < len(p):
        c = p[i]
        if c == 0:
            state["faint"], state["fg"], state["rev"] = False, None, False
        elif c == 2:
            state["faint"] = True
        elif c == 7:
            state["rev"] = True
        elif c == 22:
            state["faint"] = False
        elif c == 27:
            state["rev"] = False
        elif c == 39:
            state["fg"] = None
        elif 30 <= c <= 37 or 90 <= c <= 97:
            state["fg"] = ("basic", c)
        elif c in (38, 48) and i + 1 < len(p) and p[i + 1] == 5:
            if c == 38 and i + 2 < len(p):
                state["fg"] = ("256", p[i + 2])
            i += 3
            continue
        elif c in (38, 48) and i + 1 < len(p) and p[i + 1] == 2:
            if c == 38 and i + 4 < len(p):
                state["fg"] = ("rgb", tuple(p[i + 2:i + 5]))
            i += 5
            continue
        i += 1


def ghostly(state):
    """Text drawn faint or grey: a placeholder ("Try …", "Ask Codex …") or a suggestion, not typed."""
    fg = state["fg"]
    if state["faint"]:
        return True
    if fg is None:
        return False
    if fg[0] == "basic":
        return fg[1] == 90
    if fg[0] == "256":
        return fg[1] == 8 or 238 <= fg[1] <= 250
    r, g, b = fg[1]
    return max(r, g, b) - min(r, g, b) <= 8 and max(r, g, b) < 200


def parse(line):
    """One captured row as cells: (column, character, ghost?). Wide characters take two columns."""
    out, col, state = [], 0, {"faint": False, "fg": None, "rev": False}
    pos = 0
    n = len(line)
    while pos < n:
        if line[pos] == "\x1b":
            m = ESC.match(line, pos)
            if m:
                s = SGR.fullmatch(m.group(0))
                if s:
                    sgr(state, s.group(1))
                pos = m.end()
                continue
        ch = line[pos]
        pos += 1
        w = width(ch)
        if w == 0 and out:
            continue
        out.append((col, ch, ghostly(state)))
        col += w
    return out


def _find_rev_cursor(raw_lines, r0, r1, start_col):
    """Find a reverse-video (SGR 7) fake cursor inside rows [r0..r1], if the TUI draws one."""
    for r in range(r0, min(r1 + 1, len(raw_lines))):
        line = raw_lines[r]
        if "\x1b[" not in line:
            continue
        col, state, pos, n = 0, {"faint": False, "fg": None, "rev": False}, 0, len(line)
        while pos < n:
            if line[pos] == "\x1b":
                m = ESC.match(line, pos)
                if m:
                    s = SGR.fullmatch(m.group(0))
                    if s:
                        sgr(state, s.group(1))
                    pos = m.end()
                    continue
            ch = line[pos]
            pos += 1
            w = width(ch)
            if w == 0:
                continue
            if state["rev"] and col >= start_col:
                return (col, r)
            col += w
    return None


def text_of(cells):
    return "".join(c[1] for c in cells)


def rule(cells):
    body = [c[1] for c in cells if c[1] not in " \xa0"]
    return len(body) >= 8 and sum(ch in RULE for ch in body) * 10 >= len(body) * 7


def blank(cells):
    return not text_of(cells).strip(" \xa0" + BORDER)


def prompt_start(cells):
    """The column typing starts at when this row is the box's first row (its prompt mark at column
    0 or 1, then a space), else None."""
    for i, (col, ch, _) in enumerate(cells):
        if ch in " \xa0":
            continue
        if col > 1 or ch not in MARKS:
            return None
        if i + 1 < len(cells) and cells[i + 1][0] == col + 1 and cells[i + 1][1] not in " \xa0":
            return None
        return col + 2
    return None


def agent_in(pid):
    """Is one of the agents running in this pane (fast /proc tree walk, ps fallback)?"""
    if os.path.isdir("/proc"):
        todo, seen = [str(pid)], set()
        while todo and len(seen) < 256:
            p = todo.pop()
            if p in seen:
                continue
            seen.add(p)
            try:
                with open(f"/proc/{p}/cmdline", "rb") as fh:
                    raw = fh.read(512)
                for w in raw.split(b"\0")[:2]:
                    if w and os.path.basename(w) in AGENTS_B:
                        return True
                task_dir = f"/proc/{p}/task"
                for tid in os.listdir(task_dir):
                    try:
                        with open(f"{task_dir}/{tid}/children", "r") as cf:
                            todo.extend(cf.read().split())
                    except OSError:
                        pass
            except OSError:
                pass
        return False
    try:
        out = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,args="], capture_output=True, text=True,
                             timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    kids, args = {}, {}
    for ln in out.splitlines():
        parts = ln.split(None, 2)
        if len(parts) < 2 or not parts[0].isdigit() or not parts[1].isdigit():
            continue
        kids.setdefault(parts[1], []).append(parts[0])
        args[parts[0]] = parts[2] if len(parts) > 2 else ""
    todo, seen = [str(pid)], set()
    while todo and len(seen) < 500:
        p = todo.pop()
        if p in seen:
            continue
        seen.add(p)
        words = args.get(p, "").split()[:2]
        if any(os.path.basename(w) in AGENTS for w in words):
            return True
        todo.extend(kids.get(p, []))
    return False


def find_box(rows, cx, cy):
    """The typed text's rows: [(row, [cells of the text])], or None when no typing box is found."""
    if not (0 <= cy < len(rows)):
        return None
    top = None
    for r in range(cy, max(-1, cy - MAX_ROWS), -1):
        if r != cy and rule(rows[r]):
            return None                       # a rule before any prompt mark: the cursor is not in a box
        if prompt_start(rows[r]) is not None:
            top = r
            break
    if top is None:
        return None
    start_col = prompt_start(rows[top])
    last = cy
    r = cy + 1
    while r < len(rows) and r - cy < MAX_ROWS and not rule(rows[r]) and not blank(rows[r]):
        last, r = r, r + 1
    out = []
    for r in range(top, last + 1):
        cells = [c for c in rows[r] if c[0] >= start_col]
        while cells and (cells[-1][1] in " \xa0" + BORDER or cells[-1][2]):
            cells.pop()                       # the box's right edge, padding, a faint suggestion
        out.append((r, cells))
    while out and not out[-1][1]:
        out.pop()
    if not out or all(c[2] for _, cells in out for c in cells if c[1].strip()):
        return None                           # nothing typed: only a placeholder, or empty
    return out


def char_steps(row_cells, col, past=False):
    """Exact copy-mode cursor-right steps from col 0 to reach screen column `col` (or one past it)."""
    if not row_cells:
        return col + (1 if past else 0)
    n = 0
    last_end = 0
    for c_col, ch, _ in row_cells:
        if c_col >= col:
            return n + (1 if past else 0)
        n += 1
        last_end = c_col + width(ch)
    return n + max(0, col - last_end) + (1 if past else 0)


def clear_counts(box, cur_x, cur_y):
    """Compute (backspaces, deletes) sized to the cursor position inside `box`."""
    total = sum(len(cells) for _, cells in box) + len(box) - 1
    r0, r1 = box[0][0], box[-1][0]
    if not (r0 <= cur_y <= r1):
        return total + 8, total + 8
    before = 0
    for idx, (r, cells) in enumerate(box):
        if idx > 0 and r <= cur_y:
            before += 1
        if r < cur_y:
            before += len(cells)
        elif r == cur_y:
            before += sum(1 for c in cells if c[0] < cur_x)
            break
    after = max(0, total - before)
    # Tight safety pad on both sides so we never strand a character even if cursor is off by 1-2 cells
    nb = (before + 6) if before > 0 else 4
    na = (after + 6) if after > 0 else 4
    return nb, na


def _build_select_cmds(pane, rows, cx, cy, r0, first, r1, last, pane_w):
    """Build ONE atomic batched tmux command list to enter copy-mode and select [r0..r1]."""
    full = last[-1][0] + width(last[-1][1]) >= pane_w and r1 + 1 < len(rows)
    r_end = r1 + 1 if full else r1
    steps_cy = char_steps(rows[cy], cx) if 0 <= cy < len(rows) else cx
    steps0 = char_steps(rows[r0], first[0][0])
    steps1 = 0 if full else char_steps(rows[r1], last[-1][0], past=True)

    cmds = ["copy-mode", "-H", "-t", pane]

    def add(*a):
        cmds.extend([";", "send-keys", "-X", "-t", pane, *a])

    if steps_cy:
        add("-N", str(steps_cy), "cursor-left")
    if cy != r0:
        add("-N", str(abs(cy - r0)), "cursor-up" if cy > r0 else "cursor-down")
    if steps0:
        add("-N", str(steps0), "cursor-right")
    add("begin-selection")
    if r_end == r0:
        if steps1 != steps0:
            add("-N", str(abs(steps1 - steps0)), "cursor-right" if steps1 > steps0 else "cursor-left")
    else:
        if steps0:
            add("-N", str(steps0), "cursor-left")
        add("-N", str(r_end - r0), "cursor-down")
        if steps1:
            add("-N", str(steps1), "cursor-right")
    return cmds


def _sh_dq(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("`", "\\`") + '"'


def _shell_path(p):
    if "'" in p and p.startswith(HOME + "/"):
        return '"$HOME/' + p[len(HOME) + 1:].replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("`", "\\`") + '"'
    return _sh_dq(p)


def _key_shell_cmd(num, count, nb, na):
    """Single-line POSIX /bin/sh key dispatcher (zero Python startup, zero display-message fork, zero '%' or single-quotes)."""
    agents_bin = os.path.join(HOME, ".local/bin/agents")
    plural = "" if count == 1 else "s"
    clr = f'send-keys -t "$P" -N {nb} BSpace ";" send-keys -t "$P" -N {na} DC'
    # No '%' (command-prompt expands %1..%9/%%) and no single-quotes (passed inside tmux single-quoted run-shell -b '...').
    # tmux run-shell natively expands #{pane_in_mode}, #{q:socket_path}, and #{q:@acf_key_<num>} before invoking /bin/sh,
    # eliminating a display-message subprocess and safely shell-quoting every special character (', ", $, `, \, ;, *, ?, %, #).
    return (
        f'T={_shell_path(TMUXBIN)}; P="$(printf "\\045"){num}"; '
        f'IM=#{{pane_in_mode}}; SOCK=#{{q:socket_path}}; K=#{{q:@acf_key_{num}}}; '
        f'case "$K" in '
        f'C-c) '
        f'if [ "$IM" = 1 ]; then "$T" set -gu @acf_key_{num} ";" send-keys -X -t "$P" copy-pipe-and-cancel -C ";" display-message -d 2500 "Copied {count} character{plural} to the clipboard"; '
        f'else "$T" set -gu @acf_key_{num} ";" display-message -d 2500 "Copied {count} character{plural} to the clipboard"; fi ;; '
        f'C-x) '
        f'if [ "$IM" = 1 ]; then "$T" set -gu @acf_key_{num} ";" send-keys -X -t "$P" copy-pipe-and-cancel -C ";" {clr} ";" display-message -d 2500 "Cut {count} character{plural} to the clipboard"; '
        f'else "$T" set -gu @acf_key_{num} ";" {clr} ";" display-message -d 2500 "Cut {count} character{plural} to the clipboard"; fi ;; '
        f'BSpace|DC|C-h|C-\\?) '
        f'if [ "$IM" = 1 ]; then "$T" set -gu @acf_key_{num} ";" send-keys -X -t "$P" cancel ";" {clr}; '
        f'else "$T" set -gu @acf_key_{num} ";" {clr}; fi ;; '
        f'C-v) '
        f'if [ "$IM" = 1 ]; then "$T" set -gu @acf_key_{num} ";" send-keys -X -t "$P" cancel ";" {clr}; '
        f'else "$T" set -gu @acf_key_{num} ";" {clr}; fi; '
        f'{_shell_path(agents_bin)} --paste "$P" "$SOCK" >/dev/null 2>&1 ;; '
        f'Space) '
        f'if [ "$IM" = 1 ]; then "$T" set -gu @acf_key_{num} ";" send-keys -X -t "$P" cancel ";" {clr} ";" send-keys -t "$P" -l -- " "; '
        f'else "$T" set -gu @acf_key_{num} ";" {clr} ";" send-keys -t "$P" -l -- " "; fi ;; '
        f'";") '
        f'if [ "$IM" = 1 ]; then "$T" set -gu @acf_key_{num} ";" send-keys -X -t "$P" cancel ";" {clr} ";" send-keys -t "$P" -H 3b; '
        f'else "$T" set -gu @acf_key_{num} ";" {clr} ";" send-keys -t "$P" -H 3b; fi ;; '
        f'Escape|""|Mouse*|Wheel*|Double*|Triple*) '
        f'if [ "$IM" = 1 ]; then "$T" set -gu @acf_key_{num} ";" send-keys -X -t "$P" cancel; '
        f'else "$T" set -gu @acf_key_{num} >/dev/null 2>&1; "$T" send-keys -X -t "$P" cancel >/dev/null 2>&1 || true; fi ;; '
        f'?) '
        f'if [ "$IM" = 1 ]; then "$T" set -gu @acf_key_{num} ";" send-keys -X -t "$P" cancel ";" {clr} ";" send-keys -t "$P" -l -- "$K"; '
        f'else "$T" set -gu @acf_key_{num} ";" {clr} ";" send-keys -t "$P" -l -- "$K"; fi ;; '
        f'*) '
        f'if [ "$IM" = 1 ]; then "$T" set -gu @acf_key_{num} ";" send-keys -X -t "$P" cancel ";" send-keys -t "$P" -- "$K"; '
        f'else "$T" set -gu @acf_key_{num} ";" send-keys -t "$P" -- "$K"; fi ;; '
        f'esac'
    )


def passthrough(pane):
    tmux("send-keys", "-t", pane, "C-a")
    return 0


def start(pane, client, meta=None):
    if meta and len(meta) >= 7:
        in_mode, cx_s, cy_s, pid_s, alt_s, cmd_s, w_s = meta[:7]
        council = "0"
    else:
        info = tmux("display-message", "-p", "-t", pane,
                    "#{pane_in_mode}\t#{cursor_x}\t#{cursor_y}\t#{pane_pid}\t#{alternate_on}\t#{pane_current_command}\t#{@council_chat}\t#{pane_width}")
        f = info.split("\t")
        if len(f) < 8:
            return passthrough(pane)
        in_mode, cx_s, cy_s, pid_s, alt_s, cmd_s, council, w_s = f[:8]

    if in_mode != "0" or council == "1" or not (cx_s.isdigit() and cy_s.isdigit() and w_s.isdigit()):
        return passthrough(pane)
    cx, cy, pane_w = int(cx_s), int(cy_s), int(w_s)
    if (alt_s == "1" and cmd_s in EDITORS) or not agent_in(pid_s):
        return passthrough(pane)

    raw_lines = tmux("capture-pane", "-p", "-e", "-t", pane).split("\n")
    rows = [parse(ln) for ln in raw_lines]
    box = find_box(rows, cx, cy)
    if not box:
        return passthrough(pane)

    (r0, first), (r1, last) = box[0], box[-1]
    count = sum(len(cells) for _, cells in box) + len(box) - 1
    rev = _find_rev_cursor(raw_lines, r0, r1, first[0][0])
    cur_x, cur_y = rev if rev else (cx, cy)
    nb, na = clear_counts(box, cur_x, cur_y)

    num = pane.lstrip("%")
    shell_cmd = _key_shell_cmd(num, count, nb, na)
    # The pane's number, not its id: a "%1" in the template would itself be replaced by the key.
    # Single-quote run-shell's argument so tmux performs zero backslash/$ mangling before /bin/sh.
    then = f"set -g @acf_key_{num} \"%%%\" ; run-shell -b '{shell_cmd}'"
    hint = (f" {count} character{'s' if count != 1 else ''} selected:  Backspace/Del deletes · Ctrl+X cuts · "
            "Ctrl+C copies · typing replaces · Esc leaves it ")

    cmds = _build_select_cmds(pane, rows, cx, cy, r0, first, r1, last, pane_w)
    cmds.extend([";", "command-prompt", *(["-t", client] if client else []), "-k", "-p", hint, then])
    if __name__ == "__main__":
        os.execvp(TMUXBIN, [TMUXBIN, *cmds])
    tmux(*cmds)
    return 0


def key(num):
    """Legacy entry point kept for compatibility if invoked directly."""
    import json
    path = os.path.join(STATE, f"{num}.json")
    try:
        with open(path) as fh:
            st = json.load(fh)
        os.unlink(path)
    except (OSError, ValueError):
        return 0
    pane, count = st["pane"], int(st.get("count") or 0)
    nb = int(st.get("nb") or (count + 8))
    na = int(st.get("na") or (count + 8))
    meta = tmux("display-message", "-p", "-t", pane,
                f"#{{pane_in_mode}}\t#{{socket_path}}\t#{{@acf_key_{num}}}").split("\t")
    in_mode = len(meta) >= 1 and meta[0] == "1"
    sock = meta[1] if len(meta) >= 2 else ""
    k = meta[2] if len(meta) >= 3 else ""
    X = ["send-keys", "-X", "-t", pane]

    def clear():
        return ["send-keys", "-t", pane, "-N", str(nb), "BSpace", ";", "send-keys", "-t", pane, "-N", str(na), "DC"]

    cmds = ["set-option", "-gu", f"@acf_key_{num}"]
    if k in ("C-c", "C-x"):
        if in_mode:
            cmds.extend([";", *X, "copy-pipe-and-cancel", "-C"])
        if k == "C-x":
            cmds.extend([";", *clear()])
        cmds.extend([";", "display-message", "-d", "2500",
                     f"{'Cut' if k == 'C-x' else 'Copied'} {count} character{'s' if count != 1 else ''} to the clipboard"])
        tmux(*cmds)
        return 0
    if in_mode:
        cmds.extend([";", *X, "cancel"])
    if k in ("BSpace", "DC", "C-h", "C-?"):
        cmds.extend([";", *clear()])
        tmux(*cmds)
    elif k == "C-v":
        cmds.extend([";", *clear()])
        tmux(*cmds)
        subprocess.run([os.path.join(HOME, ".local/bin/agents"), "--paste", pane, sock],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
    elif k == "Space" or len(k) == 1:
        if k == ";":
            cmds.extend([";", *clear(), ";", "send-keys", "-t", pane, "-H", "3b"])
        else:
            cmds.extend([";", *clear(), ";", "send-keys", "-t", pane, "-l", "--", " " if k == "Space" else k])
        tmux(*cmds)
    elif k in ("Escape", "") or k.startswith(("Mouse", "Wheel", "Double", "Triple")):
        tmux(*cmds)
    else:
        cmds.extend([";", "send-keys", "-t", pane, k])
        tmux(*cmds)
    return 0


def main(argv):
    if len(argv) >= 2 and argv[0] == "start":
        return start(argv[1], argv[2] if len(argv) > 2 else "", argv[3:] if len(argv) > 3 else None)
    if len(argv) == 2 and argv[0] == "key" and argv[1].isdigit():
        return key(argv[1])
    sys.stdout.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
