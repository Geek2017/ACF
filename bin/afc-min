#!/usr/bin/env bash
# afc-min: minimise a split in the fleet and bring it back.
#
# A minimised split keeps running (its agent goes on working); it is only moved out of the tab into
# a hidden holding session called "afcmin", which has no tab in the bottom bar. The bottom bar shows
# how many are minimised ( ▣ 2 ); clicking that, or Alt+U, brings one back.
#
#   afc-min hide <pane id>                    minimise that split (Alt+H, or – in its header)
#   afc-min show <client> <window id> [pane]  restore: the only one, or a pop-up list when there are
#                                             several (Alt+U, or click ▣ N); with a pane id, that one
#   afc-min all <window id>                   restore every minimised split
#   afc-min count                             how many are minimised
#   afc-min sync                              recount and update the bottom bar (afc-bar does this too)
#
# Called from bindings in ~/.tmux.conf, inside tmux. A split goes back to the tab it came from
# (remembered in the pane option @min_from), as a column on the right; if that tab is gone, it
# joins the tab you are looking at. A tab's only pane cannot be minimised: the tab would vanish.
STASH=afcmin
t() { tmux "$@"; }
say() { t display-message -d 3500 "$1" 2>/dev/null; }

hidden() { t list-panes -s -t "=$STASH" -F '#{?#{@min_from},#{pane_id},}' 2>/dev/null | grep . ; }
count() { hidden | grep -c . ; }
sync() {
  local n; n=$(count)
  [[ "$(t show -gqv @min_count 2>/dev/null)" == "$n" ]] || t set -g @min_count "$n"
  t refresh-client -S 2>/dev/null
  return 0
}

# "C / 1" for the agent in a pane: tool letter and the account's label, as the pane header shows it
badge() {
  local who tool acct letter label n s _
  who=$("$HOME/.local/bin/agents" --who "$1" 2>/dev/null | head -1)
  [[ -n "$who" ]] || { echo "terminal"; return; }
  tool=${who%% *}
  case "$tool" in claude) letter=C ;; codex) letter=X ;; gemini) letter=G ;; agy) letter=A ;; *) letter=$tool ;; esac
  [[ "$who" == *' '* ]] || { echo "$letter"; return; }
  acct=${who#* }; label=$acct
  if [[ -r "$HOME/.config/agents/account-labels" ]]; then
    while read -r n s _; do [[ "$n" == "$acct" && -n "$s" ]] && { label=$s; break; }; done < "$HOME/.config/agents/account-labels"
  fi
  echo "$letter / $label"
}

restore() {  # <pane id> <window to fall back on>
  local pane=$1 from target
  from=$(t display-message -p -t "$pane" '#{@min_from}' 2>/dev/null)
  [[ -n "$from" ]] || return 1
  if t list-windows -a -F '#{window_id}' | grep -qx -- "$from"; then target=$from; else target=$2; fi
  [[ -n "$target" ]] || return 1
  t join-pane -fh -s "$pane" -t "$target" || return 1
  t set-option -p -u -t "$pane" @min_from
  t set-option -p -u -t "$pane" @min_name
  t select-layout -E -t "$pane"
  t select-window -t "$target"
  t select-pane -t "$pane"
}

case "${1:-}" in
  hide)
    pane=${2:?pane id}
    read -r wid np wname <<< "$(t display-message -p -t "$pane" '#{window_id} #{window_panes} #{window_name}')"
    if (( ${np:-1} < 2 )); then
      say "This is the tab's only pane, so there is nothing to minimise. Alt+Z zooms a pane, Alt+Q closes it."
      exit 0
    fi
    # the holding session needs one window of its own to exist; it does nothing
    t has-session -t "=$STASH" 2>/dev/null || t new-session -d -s "$STASH" -n holding 'exec sleep infinity'
    other=$(t list-panes -t "$wid" -F '#{pane_id}' | grep -vx -- "$pane" | head -1)
    t set-option -p -t "$pane" @min_from "$wid"
    t set-option -p -t "$pane" @min_name "$wname"
    if t break-pane -d -s "$pane" -t "$STASH:" -n "$wname"; then
      [[ -n "$other" ]] && t select-layout -E -t "$other"
      sync
      say "Minimised ($(count) hidden, still running). Alt+U or click ▣ in the bottom bar to bring it back."
    else
      t set-option -p -u -t "$pane" @min_from
      say "Could not minimise this split."
    fi
    ;;
  show)
    client=${2:-}; win=${3:-}; pane=${4:-}
    if [[ -n "$pane" ]]; then
      restore "$pane" "$win" || say "That split is no longer there."
      sync; exit 0
    fi
    mapfile -t list < <(hidden)
    case ${#list[@]} in
      0) sync; say "Nothing is minimised. Alt+H, or – in the box at the right of a pane header, minimises a split." ;;
      1) restore "${list[0]}" "$win"; sync ;;
      *)
        items=(); key=0
        for p in "${list[@]}"; do
          key=$((key + 1))
          read -r ppid pname <<< "$(t display-message -p -t "$p" '#{pane_pid} #{@min_name}')"
          items+=("$pname · $(badge "$ppid")" "$( ((key < 10)) && echo "$key" )" "run-shell -b '$HOME/.local/bin/afc-min show \"$client\" $win $p'")
        done
        items+=("" "Bring back all ${#list[@]}" a "run-shell -b '$HOME/.local/bin/afc-min all $win'")
        t display-menu -M ${client:+-c "$client"} -T "#[align=centre] Minimised splits " -x C -y C "${items[@]}"
        ;;
    esac
    ;;
  all)
    win=${2:-}
    while read -r p; do [[ -n "$p" ]] && restore "$p" "$win"; done < <(hidden)
    sync
    ;;
  count) count ;;
  sync) sync ;;
  *) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
