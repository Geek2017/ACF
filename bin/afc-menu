CONFIG_SCHEMA = [
    ("view", "Chat UI mode", ["classic", "compact", "unified"], "classic"),
    ("start-agent", "New tab default agent", ["claude", "ask"], "claude"),
    ("rules", "TokenOps rule check", ["off", "report", "enforce"], "enforce"),
