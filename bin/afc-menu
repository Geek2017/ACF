            val_w,
        )
        rt_line = trunc(
            f"{a['tmux_v']} · {a['win_cnt']} tabs, {a['pane_cnt']} panes · autonice: {a['autonice']}",
            val_w,
        )
        repo_line = trunc(
            f"{REPO_ROOT.replace(HOME, '~')} ({a['branch']} @ {a['commit']})",
            val_w,
        )
        bio = [
            "Tech engineer with over a decade of experience in tech, combining",
            "deep digital acumen across AI, Cloud, Security & IoT — building",
            "sub-200ms STT/TTS Voice AI, autonomous multi-agent platforms,",
            "smart EV/motorcycle OS, custom MCP servers, RAG & edge AI.",
        ]
        author_s = 'John Marion "JM" Grefaldo (@Geek2017)'
        motto_s = '"MO ERGASTEE FORN, MO ERGALONE FORN NORT..."'
        lines = [
            (f"{FG_BLUE}{BOLD}  Agentic CLI Fleet (ACF)", ""),
            (f"{FG_MUTED}  {trunc('Multi-provider tmux fleet with live telemetry, Council & cgroup guards', max(10, w - 2))}", ""),
            ("", ""),
            (f"{FG_PURPLE}{BOLD}  Author        ", f"{FG_WHITE}{BOLD}{trunc(author_s, val_w)}"),
            (f"{FG_PURPLE}  Role          ", f"{FG_CYAN}{trunc('AI Founder, Chief AI Architect & Digital Acumen Leader', val_w)}"),
            (f"{FG_PURPLE}  Featured In   ", f"{FG_AMBER}{trunc('GMA News  ·  GadgetMatch  ·  PhilSTAR Life  ·  VISOR', val_w)}"),
            (f"{FG_PURPLE}  Work          ", f"{FG_TEXT}{trunc(bio[0], val_w)}"),
            (f"{FG_PURPLE}                ", f"{FG_TEXT}{trunc(bio[1], val_w)}"),
            (f"{FG_PURPLE}                ", f"{FG_TEXT}{trunc(bio[2], val_w)}"),
            (f"{FG_PURPLE}                ", f"{FG_TEXT}{trunc(bio[3], val_w)}"),
            (f"{FG_PURPLE}  Credentials   ", f"{FG_MUTED}{trunc('MBA · M.S. Big Data & BI · AI Educator & Cloud Ambassador', val_w)}"),
            (f"{FG_PURPLE}  Motto         ", f"{FG_AMBER}{trunc(motto_s, val_w)}"),
            ("", ""),
            (f"{FG_AMBER}  Repository    ", f"{FG_TEXT}{repo_line}"),
            (f"{FG_AMBER}  Runtime       ", f"{FG_TEXT}{rt_line}"),
            (f"{FG_AMBER}  agents.slice  ", f"{FG_TEXT}{cg_line}"),
            (f"{FG_AMBER}  Providers     ", prov_line),
            (f"{FG_BLUE}  Source        ", f"{FG_CYAN}{trunc('github.com/Geek2017/ACF', val_w)}"),
        ]

        for r in range(rows):
            y = top + r
            if r < len(lines):
                k, v = lines[r]
                out.append(f"\x1b[{y};1H{BG_MAIN}{k}{v}{RESET}{BG_MAIN}\x1b[K{RESET}")
            else:
                out.append(f"\x1b[{y};1H{BG_MAIN}{' ' * w}{RESET}")

    def _set_active_sel(self, idx):
        if self.tab == TAB_SESSIONS and self.inspect_win is not None:
            self.inspect_sel = max(0, min(idx, max(0, len(self.inspect_agents) - 1)))
        elif self.tab == TAB_HISTORY and self.history_handoff_item is not None:
            self.history_handoff_sel = max(0, min(idx, max(0, len(self.history_handoff_targets) - 1)))
        elif self.tab == TAB_HISTORY and self.history_detail is not None:
            _, h = get_term_size()
            vis = max(1, h - 7)
            max_sc = max(0, len(self.history_detail_lines) - vis)
            self.history_detail_scroll = max(0, min(idx, max_sc))
        elif self.tab == TAB_HISTORY and self.history_date_key is not None:
            grp = self._current_date_group()
            n = len(grp["items"]) if grp else 0
            self.history_date_sel = max(0, min(idx, max(0, n - 1)))
        else:
            self.sel[self.tab] = max(0, min(idx, max(0, self.current_items_len() - 1)))

    def _get_active_sel(self):
        if self.tab == TAB_SESSIONS and self.inspect_win is not None:
            return self.inspect_sel
        if self.tab == TAB_HISTORY and self.history_handoff_item is not None:
            return self.history_handoff_sel
        if self.tab == TAB_HISTORY and self.history_detail is not None:
            return self.history_detail_scroll
        if self.tab == TAB_HISTORY and self.history_date_key is not None:
            return self.history_date_sel
        return self.sel[self.tab]

    def _scroll_from_bar(self, row):
        if not self.scrollbar_rect:
            return
        top_r, bot_r, _sb_col, total, visible, mode = self.scrollbar_rect
        span = max(1, bot_r - top_r)
        frac = max(0.0, min(1.0, (row - top_r) / span))
        max_sc = max(0, total - visible)
        sc = int(round(frac * max_sc))
        if mode == "history_detail":
            self.history_detail_scroll = sc
        elif mode == "history_cards":
            self.history_date_scroll = sc
            self.history_date_sel = max(0, min(total - 1, sc + int(round(frac * max(0, visible - 1)))))
        elif mode == "history_dates":
            self.scroll[TAB_HISTORY] = sc
            self.sel[TAB_HISTORY] = max(0, min(total - 1, sc + int(round(frac * max(0, visible - 1)))))
        elif mode == "config":
            self.scroll[TAB_CONFIG] = sc
            citems = self._config_items()
            cfg_rows, _ = self._config_rows(citems)
            target_r = max(0, min(len(cfg_rows) - 1, sc + int(round(frac * max(0, visible - 1)))))
            for r_i in range(target_r, len(cfg_rows)):
                if cfg_rows[r_i][0] == "item":
                    self.sel[TAB_CONFIG] = cfg_rows[r_i][1]
                    break
            else:
                for r_i in range(target_r, -1, -1):
                    if cfg_rows[r_i][0] == "item":
                        self.sel[TAB_CONFIG] = cfg_rows[r_i][1]
                        break

    def handle_mouse(self, btn, col, row, pressed):
        # Scroll wheel (64 = up, 65 = down)
        if self.tab == TAB_HISTORY and self.history_date_editing:
            if btn == 64:
                self._dp_shift_month(-1)
                return
            if btn == 65:
                self._dp_shift_month(1)
                return
            if btn & 32:
                for ry, cs, ce, d_obj in self.dp_day_rects:
                    if row == ry and cs <= col <= ce:
                        self.dp_cursor = d_obj
                        return
                return
            if btn == 0 and pressed == "M":
                if self.back_rect and row == self.back_rect[0] and self.back_rect[1] <= col <= self.back_rect[2]:
                    self.history_date_editing = False
                    self.status_msg = ""
                    return
                for ry, cs, ce, d_obj in self.dp_day_rects:
                    if row == ry and cs <= col <= ce:
                        self._dp_pick_date(d_obj)
                        return
                for ry, cs, ce, act, payload in self.dp_btn_rects:
                    if row == ry and cs <= col <= ce:
                        if act == "prev_month":
                            self._dp_shift_month(-1)
                        elif act == "next_month":
                            self._dp_shift_month(1)
                        elif act == "preset":
                            self._apply_history_date_spec(payload)
                        elif act == "apply":
                            self._dp_apply_current()
                        elif act == "reset":
                            self._apply_history_date_spec("top10")
                        return
                # Allow clicking top tab bar even while picker is open
                if row == 1:
                    for sc, ec, tab_idx in self.tab_rects:
                        if sc <= col <= ec:
                            self.history_date_editing = False
                            self._switch_tab(tab_idx)
                            return
                    w, _ = get_term_size()
                    if col >= w - 13:
                        self.running = False
                return
            return

        step = 3 if (self.tab == TAB_HISTORY and self.history_detail is not None) else 1
        if btn == 64:
            self._set_active_sel(self._get_active_sel() - step)
            return
        if btn == 65:
            self._set_active_sel(self._get_active_sel() + step)
            return

        # Left-button drag on scrollbar (btn == 32)
        if btn == 32 and self.scrollbar_rect:
            top_r, bot_r, sb_col = self.scrollbar_rect[:3]
            if col >= sb_col - 1 and top_r <= row <= bot_r:
                self._scroll_from_bar(row)
                return

        # Motion hover (btn & 32): highlight hovered row smoothly
        if btn & 32:
            if row in self.row_map:
                self._set_active_sel(self.row_map[row])
            return

        # Left or right click press on inline Doctrine / Mental Model / ✕ pills
        if btn in (0, 2) and pressed == "M":
            if self.tab == TAB_SESSIONS and self.inspect_win is not None:
                rect = self.agent_doc_rects.get(row)
                if rect and rect[0] <= col <= rect[1]:
                    self.inspect_sel = rect[2]
                    if btn == 0:
                        self._cycle_agent_mode(rect[2], "doctrine")
                    else:
                        self._clear_agent_mode(rect[2], field="doctrine", action="toggle_clear")
                    return
                rect = self.agent_mod_rects.get(row)
                if rect and rect[0] <= col <= rect[1]:
                    self.inspect_sel = rect[2]
                    if btn == 0:
                        self._cycle_agent_mode(rect[2], "mental-model")
                    else:
                        self._clear_agent_mode(rect[2], field="mental-model", action="toggle_clear")
                    return
                rect = self.agent_clr_rects.get(row)
                if rect and rect[0] <= col <= rect[1]:
                    self.inspect_sel = rect[2]
                    self._clear_agent_mode(rect[2], field=None, action="toggle_clear" if btn == 0 else "delete")
                    return
            if self.tab == TAB_HISTORY and self.history_date_key is not None and self.history_detail is None and self.history_handoff_item is None:
                rect = self.hist_doc_rects.get(row)
                if rect and rect[0] <= col <= rect[1]:
                    self.history_date_sel = rect[2]
                    if btn == 0:
                        self._cycle_history_project_mode(rect[2], "doctrine")
                    else:
                        self._clear_history_project_mode(rect[2], field="doctrine", action="toggle_clear")
                    return
                rect = self.hist_mod_rects.get(row)
                if rect and rect[0] <= col <= rect[1]:
                    self.history_date_sel = rect[2]
                    if btn == 0:
                        self._cycle_history_project_mode(rect[2], "mental-model")
                    else:
                        self._clear_history_project_mode(rect[2], field="mental-model", action="toggle_clear")
                    return
                rect = self.hist_clr_rects.get(row)
                if rect and rect[0] <= col <= rect[1]:
                    self.history_date_sel = rect[2]
                    self._clear_history_project_mode(rect[2], field=None, action="toggle_clear" if btn == 0 else "delete")
                    return
                rect = self.hist_copy_rects.get(row)
                if rect and rect[0] <= col <= rect[1]:
                    self.history_date_sel = rect[2]
                    self._copy_history_session_id(rect[2])
                    return

        # Left click press (btn == 0, pressed == 'M')
        if btn == 0 and pressed == "M":
            if self.scrollbar_rect:
                top_r, bot_r, sb_col = self.scrollbar_rect[:3]
                if col >= sb_col - 1 and top_r <= row <= bot_r:
                    self._scroll_from_bar(row)
                    return
            if row == 1:
                for s_col, e_col, t_idx in self.tab_rects:
                    if s_col <= col <= e_col:
                        self._switch_tab(t_idx)
                        return
                # Click on "Esc to close" at top-right
                w, _ = get_term_size()
                if col >= w - 13:
                    self.running = False
                return
            if self.back_rect and row == self.back_rect[0] and self.back_rect[1] <= col <= self.back_rect[2]:
                if self.tab == TAB_HISTORY and self.history_handoff_item is not None:
                    self.history_handoff_item = None
                elif self.tab == TAB_HISTORY and self.history_detail is not None:
                    self.history_detail = None
                elif self.tab == TAB_HISTORY and self.history_date_key is not None:
                    self.history_date_key = None
                else:
                    self.inspect_win = None
                self.status_msg = ""
                return
            if self.jump_rect and row == self.jump_rect[0] and self.jump_rect[1] <= col <= self.jump_rect[2]:
                if self.inspect_win is not None:
                    self.pending_cmd = self.inspect_win["cmd"]
                    self.running = False
                return
            if self.tab == TAB_HISTORY and self.history_detail is not None and self.history_handoff_item is None:
                if self.hist_handoff_rect and row == self.hist_handoff_rect[0] and self.hist_handoff_rect[1] <= col <= self.hist_handoff_rect[2]:
                    self.open_history_handoff(self.history_detail)
                    return
                if self.hist_resume_rect and row == self.hist_resume_rect[0] and self.hist_resume_rect[1] <= col <= self.hist_resume_rect[2]:
                    self.pending_cmd = build_history_go_cmd(self.ctx, self.history_detail)
                    self.running = False
                    return
                if self.hist_pager_rect and row == self.hist_pager_rect[0] and self.hist_pager_rect[1] <= col <= self.hist_pager_rect[2]:
                    self.pending_cmd = build_history_pager_cmd(self.ctx, self.history_detail)
                    self.running = False
                    return
            if self.tab == TAB_HISTORY and self.history_detail is None and self.history_date_key is None:
                if self.hist_proj_rect and row == self.hist_proj_rect[0] and self.hist_proj_rect[1] <= col <= self.hist_proj_rect[2]:
                    self.history_searching = False
                    self.history_date_editing = False
                    self._cycle_history_project(1)
                    self.status_msg = ""
                    return
                if self.hist_tool_rect and row == self.hist_tool_rect[0] and self.hist_tool_rect[1] <= col <= self.hist_tool_rect[2]:
                    self.history_searching = False
                    self.history_date_editing = False
                    self._cycle_history_tool(1)
                    self.status_msg = ""
                    return
                if self.hist_dates_rect and row == self.hist_dates_rect[0] and self.hist_dates_rect[1] <= col <= self.hist_dates_rect[2]:
                    self.open_history_date_picker()
                    return
                if self.hist_search_rect and row == self.hist_search_rect[0] and self.hist_search_rect[1] <= col <= self.hist_search_rect[2]:
                    self.history_date_editing = False
                    self.history_searching = True
                    self.status_msg = ""
                    return
            if row in self.row_map:
                self.history_searching = False
                self.history_date_editing = False
                self._set_active_sel(self.row_map[row])
                self.activate_current()

    def handle_key(self, data):
        if not data:
            return
        # SGR mouse sequence: ESC [ < btn ; col ; row M/m
        if data.startswith("\x1b[<"):
            m = re.match(r"^\x1b\[<(\d+);(\d+);(\d+)([Mm])$", data)
            if m:
                self.handle_mouse(int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4))
            return
        # Inside History visual Calendar Date-Range Picker (supports arrows/click + direct typing)
        if self.tab == TAB_HISTORY and self.history_date_editing and self.history_detail is None:
            if data in ("\x1b", "\x1b\x1b", "\x1b[99~"):
                if self.history_date_input:
                    self.history_date_input = ""
                    self.status_msg = ""
                elif self.dp_start and not self.dp_end:
                    self.dp_start = None
                    self.status_msg = "Cleared start date — pick Start date or Esc to close"
                else:
                    self.history_date_editing = False
                    self.status_msg = ""
                return
            if data == "\x03":
                self.running = False
                return
            if data in ("\r", "\n"):
                if self.history_date_input.strip():
                    self._apply_history_date_spec(self.history_date_input)
                else:
                    self._dp_pick_date(self.dp_cursor)
                return
            if data in ("\x7f", "\x08"):
                if self.history_date_input:
                    self.history_date_input = self.history_date_input[:-1]
                elif self.dp_start:
                    self.dp_start = None
                    self.dp_end = None
                    self.status_msg = "Cleared selection"
                return
            if data == "\x15":  # Ctrl+U
                self.history_date_input = ""
                return
            if data == "\x1b[D":
                self._dp_move_cursor(-1)
                return
            if data == "\x1b[C":
                self._dp_move_cursor(1)
                return
            if data == "\x1b[A":
                self._dp_move_cursor(-7)
                return
            if data == "\x1b[B":
                self._dp_move_cursor(7)
                return
            if data == "\x1b[5~":  # PgUp -> previous month
                self._dp_shift_month(-1)
                return
            if data == "\x1b[6~":  # PgDn -> next month
                self._dp_shift_month(1)
                return
            if not self.history_date_input:
                if data == "[":
                    self._dp_shift_month(-1)
                    return
                if data == "]":
                    self._dp_shift_month(1)
                    return
                if data == " ":
                    self._dp_apply_current()
                    return
                if data in ("t", "T"):
                    today = datetime.datetime.now().astimezone().date()
                    self.dp_cursor = today
                    self.dp_year, self.dp_month = today.year, today.month
                    self.status_msg = f"Jumped to today ({today.isoformat()})"
                    return
                if data in ("c", "C"):
                    self._apply_history_date_spec("top10")
                    return
            if len(data) == 1 and data.isprintable():
                self.history_date_input += data
                return
            return
        # Inside History inline search mode
        if self.tab == TAB_HISTORY and self.history_searching and self.history_detail is None:
            if data in ("\x1b", "\x1b\x1b", "\x1b[99~"):
                self.history_searching = False
                if self.history_query:
                    self.history_query = ""
                    self._apply_history_filter()
                self.status_msg = ""
                return
            if data == "\x03":
                self.running = False
                return
            if data in ("\r", "\n"):
                self.history_searching = False
                self.status_msg = ""
                return
            if data in ("\x7f", "\x08"):
                if self.history_query:
                    self.history_query = self.history_query[:-1]
                    self._apply_history_filter()
                return
            if data == "\x15":  # Ctrl+U
                self.history_query = ""
                self._apply_history_filter()
                return
            if data == "\x1b[A":
                self._set_active_sel(self._get_active_sel() - 1)
                return
            if data == "\x1b[B":
                self._set_active_sel(self._get_active_sel() + 1)
                return
            if len(data) == 1 and data.isprintable():
                self.history_query += data
                self._apply_history_filter()
                return
            return
        # Inside Session Inspector: Esc / Backspace / Left / h returns to Sessions list
        if self.tab == TAB_SESSIONS and self.inspect_win is not None:
            if data in ("\x1b", "\x7f", "\x08", "\x1b[D", "h"):
                self.inspect_win = None
                self.status_msg = ""
                return
            if data in ("g", "G"):
                self.pending_cmd = self.inspect_win["cmd"]
                self.running = False
                return
            if data in ("r", "R"):
                self.inspect_agents = load_window_agents(self.ctx, self.inspect_win)
                self.status_msg = f"Refreshed {self.inspect_win['win_name']} ({len(self.inspect_agents)} panes)"
                return
            if data in ("d", "D"):
                self.clamp_sel()
                self._cycle_agent_mode(self.inspect_sel, "doctrine")
                return
            if data in ("m", "M"):
                self.clamp_sel()
                self._cycle_agent_mode(self.inspect_sel, "mental-model")
                return
            if data in ("x", "X"):
                self.clamp_sel()
                self._clear_agent_mode(self.inspect_sel, field=None, action="off")
                return
            if data in ("c", "\x1b[3~"):
                self.clamp_sel()
                self._clear_agent_mode(self.inspect_sel, field=None, action="delete")
                return
            if data == "C":
                self.clamp_sel()
                self._delete_agent_project_modes(self.inspect_sel)
                return
        # Inside History Handoff Provider Picker
        if self.tab == TAB_HISTORY and self.history_handoff_item is not None:
            if data in ("\x1b", "\x7f", "\x08", "\x1b[D", "h"):
                self.history_handoff_item = None
                self.status_msg = ""
                return
        # Inside History Thread Inspector
        if self.tab == TAB_HISTORY and self.history_detail is not None and self.history_handoff_item is None:
            if data in ("\x1b", "\x7f", "\x08", "\x1b[D", "h"):
                self.history_detail = None
                self.status_msg = ""
                return
            if data == "H":
                self.open_history_handoff(self.history_detail)
                return
            if data in ("o", "O"):
                self.pending_cmd = build_history_go_cmd(self.ctx, self.history_detail)
                self.running = False
                return
            if data in ("v", "V"):
                self.pending_cmd = build_history_pager_cmd(self.ctx, self.history_detail)
                self.running = False
                return
            if data in ("t", "T"):
                self.history_detail_tools = not self.history_detail_tools
                self._reload_history_detail()
                self.history_detail_scroll = 0
                self.status_msg = "Showing tool calls & thinking" if self.history_detail_tools else "Showing conversation only"
                return
            if data in ("r", "R"):
                self._reload_history_detail()
                self.status_msg = "Reloaded thread from acf.db"
                return
            if data == " ":
                _, h = get_term_size()
                self._set_active_sel(self._get_active_sel() + max(1, h - 8))
                self.status_msg = ""
                return
        # Inside History Date view (Level 2): Esc / Backspace / Left / h returns to Dates list
        if self.tab == TAB_HISTORY and self.history_date_key is not None and self.history_detail is None:
            if data in ("\x1b", "\x7f", "\x08", "\x1b[D", "h"):
                self.history_date_key = None
                self.status_msg = ""
                return
        if data in ("\x1b", "\x1b\x1b", "\x1b[99~", "q", "Q", "\x03"):
            self.running = False
        elif data in ("\t", "\x1b[C", "l"):
            if self.tab == TAB_SESSIONS and self.inspect_win is None and data in ("\x1b[C", "l"):
                # Right arrow on a window row drills into its agents
                self.clamp_sel()
                idx = self.sel[TAB_SESSIONS]
                if 0 <= idx < len(self.sessions) and self.sessions[idx].get("kind") == "window":
                    self.open_session_inspector(self.sessions[idx])
                    return
            if self.tab == TAB_HISTORY and self.history_detail is None and self.history_handoff_item is None and data in ("\x1b[C", "l"):
                self.clamp_sel()
                if self.history_date_key is None:
                    idx = self.sel[TAB_HISTORY]
                    if 0 <= idx < len(self.history_date_groups):
                        self.open_history_date(self.history_date_groups[idx])
                        return
                else:
                    grp = self._current_date_group()
                    items = grp["items"] if grp else []
                    idx = self.history_date_sel
                    if 0 <= idx < len(items):
                        self.open_history_detail(items[idx])
                        return
            self._switch_tab(self.tab + 1)
        elif data in ("\x1b[Z", "\x1b[D", "h"):
            self._switch_tab(self.tab - 1)
        elif len(data) == 1 and data.isdigit() and 1 <= int(data) <= len(TABS):
            self._switch_tab(int(data) - 1)
        elif data in ("\x1b[A", "k"):
            self._set_active_sel(self._get_active_sel() - 1)
            self.status_msg = ""
        elif data in ("\x1b[B", "j"):
            self._set_active_sel(self._get_active_sel() + 1)
            self.status_msg = ""
        elif data == "\x1b[5~":  # PageUp
            _, h = get_term_size()
            is_cards = (self.tab == TAB_HISTORY and self.history_date_key is not None and self.history_detail is None) or (self.tab == TAB_SESSIONS and self.inspect_win is not None)
            step = max(1, (h - 6) // 2) if is_cards else max(1, h - 6)
            self._set_active_sel(self._get_active_sel() - step)
            self.status_msg = ""
        elif data == "\x1b[6~":  # PageDown
            _, h = get_term_size()
            is_cards = (self.tab == TAB_HISTORY and self.history_date_key is not None and self.history_detail is None) or (self.tab == TAB_SESSIONS and self.inspect_win is not None)
            step = max(1, (h - 6) // 2) if is_cards else max(1, h - 6)
            self._set_active_sel(self._get_active_sel() + step)
            self.status_msg = ""
        elif data in ("\x1b[H", "\x1b[1~", "\x1bOH"):  # Home
            self._set_active_sel(0)
            self.status_msg = ""
        elif data in ("\x1b[F", "\x1b[4~", "\x1bOF"):  # End
            self._set_active_sel(max(0, self.current_items_len() - 1))
            self.status_msg = ""
        elif data in ("\r", "\n", " "):
            self.activate_current()
        elif self.tab == TAB_COMMANDS and data in self.hotkey_map:
            self._activate_command(self.hotkey_map[data])
        elif self.tab == TAB_COMMANDS and len(data) == 2 and data[0] == "\x1b" and data[1] in "0123456789":
            sock = shlex.quote(self.ctx["sock"]) if self.ctx["sock"] else ""
            tbin = shlex.quote(TMUX_BIN) + (f" -S {sock}" if sock else " -L agents")
            sess = shlex.quote(self.ctx["session"])
            if data[1] == "0" and self.pane_ctx.get("in_council"):
                chair = shlex.quote(self.pane_ctx.get("chair_target") or self.ctx["pane"])
                self.pending_cmd = f"{tbin} send-keys -t {chair} M-o"
            else:
                num = 10 if data[1] == "0" else int(data[1])
                self.pending_cmd = f"{tbin} select-window -t {sess}:={num}"
            self.running = False
        elif data in ("g", "G") and self.tab == TAB_SESSIONS and self.inspect_win is None:
            self.clamp_sel()
            idx = self.sel[TAB_SESSIONS]
            if 0 <= idx < len(self.sessions):
                self.pending_cmd = self.sessions[idx]["cmd"]
                self.running = False
        elif data in ("r", "R") and self.tab == TAB_SESSIONS:
            self.sessions = load_sessions(self.ctx)
            self.status_msg = "Refreshed sessions"
        elif self.tab == TAB_CONFIG and data in ("x", "X", "c", "C", "\x7f", "\x08", "\x1b[3~"):
            self.clamp_sel()
            citems = self._config_items()
            idx = self.sel[TAB_CONFIG]
            if 0 <= idx < len(citems):
                it = citems[idx]
                is_off = data in ("x", "X")
                if it["scope"] in ("pane", "project"):
                    self._set_config_val(it, "off" if is_off else "inherit")
                elif it["scope"] == "global" and "off" in it["choices"]:
                    self._set_config_val(it, "off")
        elif self.tab == TAB_HISTORY and self.history_detail is None and self.history_handoff_item is None:
            if data in ("d", "D") and self.history_date_key is not None:
                self.clamp_sel()
                self._cycle_history_project_mode(self.history_date_sel, "doctrine")
            elif data in ("m", "M") and self.history_date_key is not None:
                self.clamp_sel()
                self._cycle_history_project_mode(self.history_date_sel, "mental-model")
            elif data == "x" and self.history_date_key is not None:
                self.clamp_sel()
                self._clear_history_project_mode(self.history_date_sel, field=None, action="off")
            elif data in ("X", "\x1b[3~") and self.history_date_key is not None:
                self.clamp_sel()
                self._clear_history_project_mode(self.history_date_sel, field=None, action="delete")
            elif data in ("y", "Y") and self.history_date_key is not None:
                self.clamp_sel()
                self._copy_history_session_id(self.history_date_sel)
            elif data == "H" and self.history_date_key is not None:
                self.clamp_sel()
                grp = self._current_date_group()
                items = grp["items"] if grp else []
                idx = self.history_date_sel
                if 0 <= idx < len(items):
                    self.open_history_handoff(items[idx])
            elif data in ("i", "I") and self.history_date_key is not None:
                self.clamp_sel()
                grp = self._current_date_group()
                items = grp["items"] if grp else []
                idx = self.history_date_sel
                if 0 <= idx < len(items):
                    self.open_history_detail(items[idx])
            elif data in ("d", "D") and self.history_date_key is None:
                self.open_history_date_picker()
            elif data in ("/", "s", "S") and self.history_date_key is None:
                self.history_date_editing = False
                self.history_searching = True
                self.status_msg = ""
            elif data == "p":
                self._cycle_history_project(1)
                self.status_msg = ""
            elif data == "P":
                self._cycle_history_project(-1)
                self.status_msg = ""
            elif data == "t":
                self._cycle_history_tool(1)
                self.status_msg = ""
            elif data == "T":
                self._cycle_history_tool(-1)
                self.status_msg = ""
            elif data in ("c", "C"):
                self.history_proj_filter = ""
                self.history_tool_filter = ""
                self.history_query = ""
                self.history_date_mode = "top"
                self.history_date_start = None
                self.history_date_end = None
                self.history_date_range_label = "Top 10"
                self.history_date_input = ""
                self.history_date_editing = False
                self.ensure_history_loaded()
                self._apply_history_filter()
                self.status_msg = "Cleared History filters (Dates: Top 10)"
            elif data in ("o", "O") and self.history_date_key is not None:
                self.clamp_sel()
                grp = self._current_date_group()
                items = grp["items"] if grp else []
                idx = self.history_date_sel
                if 0 <= idx < len(items):
                    self.pending_cmd = build_history_go_cmd(self.ctx, items[idx])
                    self.running = False
            elif data in ("v", "V") and self.history_date_key is not None:
                self.clamp_sel()
                grp = self._current_date_group()
                items = grp["items"] if grp else []
                idx = self.history_date_sel
                if 0 <= idx < len(items):
                    self.pending_cmd = build_history_pager_cmd(self.ctx, items[idx])
                    self.running = False
            elif data in ("r", "R"):
                self.ensure_history_loaded(force=True)
                self.status_msg = f"Refreshed history ({len(self.history_all)} chats across {len(self.history_projects)} projects)"

    @staticmethod
    def _pop_tokens(buf, fd):
        """Parse complete key/CSI/SGR-mouse tokens without ever splitting an ESC sequence."""
        tokens = []
        i = 0
        n = len(buf)
        while i < n:
            if buf[i] != "\x1b":
                tokens.append(buf[i])
                i += 1
                continue
            # ESC at end of buffer: wait briefly to see if a CSI/mouse sequence follows
            if i + 1 == n:
                rlist, _, _ = select.select([fd], [], [], 0.025)
                if rlist:
                    more = os.read(fd, 4096).decode("utf-8", errors="ignore")
                    if more:
                        buf += more
                        n = len(buf)
                        continue
                tokens.append("\x1b")
                i += 1
                continue
            nxt = buf[i + 1]
            if nxt in ("[", "O"):
                # Scan for CSI/SS3 final byte (0x40..0x7E)
                j = i + 2
                while j < n and not (0x40 <= ord(buf[j]) <= 0x7E):
                    j += 1
                if j >= n:
                    # Incomplete sequence at buffer end; wait briefly for rest, else keep pending
                    rlist, _, _ = select.select([fd], [], [], 0.025)
                    if rlist:
                        more = os.read(fd, 4096).decode("utf-8", errors="ignore")
                        if more:
                            buf += more
                            n = len(buf)
                            continue
                    break
                tokens.append(buf[i : j + 1])
                i = j + 1
            else:
                # Alt+key two-byte sequence: consume cleanly, never treat as bare Esc
                tokens.append(buf[i : i + 2])
                i += 2
        return tokens, buf[i:]

    def run(self):
        fd = sys.stdin.fileno()
        old_tty = termios.tcgetattr(fd)
        resized = [False]

        def on_winch(_sig, _frame):
            resized[0] = True

        signal.signal(signal.SIGWINCH, on_winch)
        try:
            tty.setraw(fd)
            # Alt screen, hide cursor, enable SGR mouse + hover tracking
            sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1003h\x1b[?1006h")
            sys.stdout.flush()
            self.render()
            pending = ""
            while self.running:
                if resized[0]:
                    resized[0] = False
                    self.render()
                try:
                    rlist, _, _ = select.select([fd], [], [], 0.2)
                except InterruptedError:
                    continue
                if not rlist:
                    continue
                chunk = os.read(fd, 4096).decode("utf-8", errors="ignore")
                if not chunk:
                    break
                pending += chunk
                tokens, pending = self._pop_tokens(pending, fd)
                for tok in tokens:
                    self.handle_key(tok)
                    if not self.running:
                        break
                if self.running:
                    self.render()
        finally:
            sys.stdout.write("\x1b[?1006l\x1b[?1003l\x1b[?1000l\x1b[?25h\x1b[?1049l")
            sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_tty)

        if self.pending_cmd:
            spawn_deferred(self.pending_cmd)


def main():
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print("Usage: afc-menu [--open] [socket_path] [client_name] [window_id] [pane_id] [pane_pid] [pane_path] [session_name]")
        return 0
    if args and args[0] == "--open":
        rest = args[1:]
        sock = rest[0] if len(rest) > 0 else ""
        client = rest[1] if len(rest) > 1 else ""
        inner = " ".join(shlex.quote(x) for x in [os.path.join(LOCAL_BIN, "afc-menu"), *rest])
        cmd = tmux_cmd(
            sock,
            "display-popup", "-E",
            *(["-c", client] if client else []),
            "-x", "C", "-y", "C", "-w", "84", "-h", "32",
            "-b", "rounded", "-S", "fg=#7aa2f7", "-T", " [ACF] ",
            inner,
        )
        # Interactive popup blocks until the user closes the menu (no short timeout).
        return subprocess.run(cmd, timeout=None).returncode
    ctx = {
        "sock": args[0] if len(args) > 0 else "",
        "client": args[1] if len(args) > 1 else "",
        "win": args[2] if len(args) > 2 else "",
        "pane": args[3] if len(args) > 3 else "",
        "pid": args[4] if len(args) > 4 else "",
        "cwd": args[5] if len(args) > 5 else os.getcwd(),
        "session": args[6] if len(args) > 6 else "agents",
    }
    if not sys.stdin.isatty():
        # Non-interactive smoke test check
        print(f"afc-menu tabs={TABS} commands={len(build_commands(ctx))} config={len(CONFIG_SCHEMA)}")
        return 0
    MenuApp(ctx).run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
