def run_out(cmd, timeout=2.0):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip() if r.returncode == 0 else ""
    except Exception:
        return ""


def session_id_for_copy(tid):
    """The provider's own session id from an acf.db thread id ("claude:<uuid>" -> "<uuid>")."""
    tid = tid or ""
    return tid.split(":", 1)[1] if ":" in tid else tid


def copy_to_clipboard(text, sock=""):
    """Put text on the system clipboard via afc-copy (pbcopy / clip.exe / wl-copy / xclip) and the
    tmux paste buffer. Returns True when either took it."""
    ok = False
    try:
        r = subprocess.run([os.path.join(REPO_ROOT, "bin", "afc-copy"), "--raw"], input=text.encode("utf-8"),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        ok = r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        ok = False
    try:
        r = subprocess.run(tmux_cmd(sock, "set-buffer", "-w", "--", text),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        ok = ok or r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        pass
    return ok


def tmux_cmd(sock, *args):
    return afc_state.tmux_cmd(sock, *args, default_sock="agents", tmux_bin=TMUX_BIN)


def spawn_deferred(shell_cmd):
    subprocess.Popen(
        ["/bin/sh", "-c", f"sleep 0.08; {shell_cmd}"],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def get_term_size():
    try:
        rows, cols = struct.unpack("hh", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\x00\x00\x00\x00"))
        if rows > 0 and cols > 0:
            return cols, rows
    except (OSError, ValueError, struct.error):
        pass
    return 78, 24


def trunc(text, width):
    if width <= 0:
        return ""
    if len(text) <= width:
        return text
    return text[: max(0, width - 1)] + "…" if width > 1 else text[:width]


def load_settings():
    return afc_state.load_settings(SETTINGS_PATH)


def save_setting(key, value):
    afc_state.save_setting(key, value, SETTINGS_PATH)


