#!/usr/bin/env python3
"""Interactive tabbed ACF popup menu (Commands | Sessions | Config | About).

Launched by clicking the bottom-left ACF badge in tmux status-left:
  afc-menu <socket_path> <client_name> <window_id> <pane_id> <pane_pid> <pane_path>
"""

