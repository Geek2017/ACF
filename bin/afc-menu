    ("ram-wall", "Machine RAM wall (%)", ["90", "85", "95", "0"], "90"),
    ("cpu-wall", "Machine CPU wall (%)", ["90", "85", "95", "0"], "90"),
]


def run_out(cmd, timeout=2.0):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip() if r.returncode == 0 else ""
    except Exception:
        return ""


def tmux_cmd(sock, *args):
    base = [TMUX_BIN]
    if sock:
        base += ["-S", sock]
    else:
        base += ["-L", "agents"]
    return base + list(args)


def spawn_deferred(shell_cmd):
    subprocess.Popen(
        ["/bin/sh", "-c", f"sleep 0.08; {shell_cmd}"],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def get_term_size():
    try:
        rows, cols = struct.unpack("hh", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\x00\x00\x00\x00"))
        if rows > 0 and cols > 0:
            return cols, rows
    except Exception:
        pass
    return 78, 24


def trunc(text, width):
    if width <= 0:
        return ""
    if len(text) <= width:
        return text
    return text[: max(0, width - 1)] + "…" if width > 1 else text[:width]


def load_settings():
    values = {}
    if not os.path.isfile(SETTINGS_PATH):
        return values
    try:
        with open(SETTINGS_PATH, "r", encoding="utf-8", errors="replace") as f:
            for raw in f:
                line = raw.split("#", 1)[0].strip()
                if not line:
                    continue
                parts = line.split(None, 1)
                if len(parts) == 2:
                    values[parts[0]] = parts[1].strip()
    except Exception:
        pass
    if "view" not in values and "claude-view" in values:
        values["view"] = values["claude-view"]
    return values


def save_setting(key, value):
    os.makedirs(os.path.dirname(SETTINGS_PATH), exist_ok=True)
    lines = []
    if os.path.isfile(SETTINGS_PATH):
        with open(SETTINGS_PATH, "r", encoding="utf-8", errors="replace") as f:
            lines = f.readlines()

    active_pat = re.compile(rf"^(\s*){re.escape(key)}(\s+)\S+(.*)$")
    commented_pat = re.compile(rf"^(\s*)#(\s*){re.escape(key)}(\s+)\S+(.*)$")

    replaced = False
    for idx, raw in enumerate(lines):
        m = active_pat.match(raw)
        if m:
            lines[idx] = f"{m.group(1)}{key}{m.group(2)}{value}{m.group(3)}\n"
            replaced = True
            break

    if not replaced:
        for idx, raw in enumerate(lines):
            m = commented_pat.match(raw)
            if m:
                lines[idx] = f"{m.group(1)}{key} {value}{m.group(4)}\n"
                replaced = True
                break

    if not replaced:
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += "\n"
        lines.append(f"{key} {value}\n")

    tmp = SETTINGS_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.writelines(lines)
    os.replace(tmp, SETTINGS_PATH)


def read_cgroup_summary():
    uid = os.getuid()
    cg = f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/agents.slice"
    info = {}
    for name in ("cpu.max", "memory.current", "memory.high", "memory.max", "pids.current", "pids.max", "io.weight"):
        p = os.path.join(cg, name)
        try:
            with open(p, "r", encoding="utf-8") as f:
                info[name] = f.read().strip()
        except Exception:
            info[name] = ""
    return info


def fmt_bytes(val):
    try:
        n = int(val)
    except Exception:
        return val or "?"
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return f"{n:.1f}{unit}" if unit in ("GiB", "TiB") else f"{int(n)}{unit}"
        n /= 1024.0
    return str(val)


def fmt_cpu_max(val):
    parts = val.split()
    if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit() and int(parts[1]) > 0:
        pct = int(round(int(parts[0]) * 100 / int(parts[1])))
        return f"{pct}%"
    return val or "?"


def build_commands(ctx):
    sock = shlex.quote(ctx["sock"]) if ctx["sock"] else ""
    tbin = shlex.quote(TMUX_BIN) + (f" -S {sock}" if sock else " -L agents")
    client = shlex.quote(ctx["client"])
    win = shlex.quote(ctx["win"])
    pane = shlex.quote(ctx["pane"])
    pid = shlex.quote(ctx["pid"])
    agents = shlex.quote(os.path.join(LOCAL_BIN, "agents"))
    council = shlex.quote(os.path.join(LOCAL_BIN, "afc-council"))
    model_menu = shlex.quote(os.path.join(LOCAL_BIN, "afc-model-menu"))
    afc_min = shlex.quote(os.path.join(LOCAL_BIN, "afc-min"))
    afc_move = shlex.quote(os.path.join(LOCAL_BIN, "afc-move"))

    return [
        ("Switch agent / handoff", "Alt+G", "Change provider or hand off chat log",
         f"{agents} --account-menu {client} {pane} {pid}"),
        ("Pick model / effort", "Alt+M", "Switch model or reasoning effort",
         f"{model_menu} {client} {pane} {pid}"),
        ("Split right", "Alt+\\", "Open a new agent or terminal on the right",
         f"{agents} --split-menu {client} {pane} {pid}"),
        ("Split down", "Alt+-", "Open a new agent or terminal below",
         f"{agents} --split-down {client} {pane} {pid}"),
        ("Add project tab", "Alt+N", "Pick or create a project folder",
         f"{agents} --pick >/dev/null 2>&1"),
        ("Open project Council", "Alt+K", "Multi-LLM council in this project",
         f"{council} --open {shlex.quote(ctx['session'])} {pid}"),
        ("Open general Council", "Alt+Shift+K", "Multi-LLM council in ~/Council",
         f"{council} --open-general {shlex.quote(ctx['session'])}"),
        ("Fleet overview", "Alt+L", "List every agent and jump to it",
         f"{agents} --overview-menu {client}"),
        ("Toggle Express lane", "Alt+E", "Give this tab priority CPU & memory",
         f"{agents} --lane-toggle {client} {win} {pid}"),
        ("Move / merge split", "Alt+J", "Swap or merge this pane with neighbours",
         f"{afc_move} menu {client} {pane}"),
        ("Minimise split", "Alt+H", "Hide pane while keeping it running",
         f"{afc_min} hide {pane}"),
        ("Restore minimised", "Alt+U", "Bring back a minimised split",
         f"{afc_min} show {client} {win}"),
        ("Zoom / unzoom split", "Alt+Z", "Toggle fullscreen for this pane",
         f"{tbin} resize-pane -Z -t {pane}"),
        ("New terminal tab", "Alt+C", "Plain shell in current project folder",
         f"{tbin} new-window -t {shlex.quote(ctx['session'] + ':')} {shlex.quote(os.path.join(LOCAL_BIN, 'agents') + ' --pane tab ' + ctx['pid'])}"),
        ("Reload tmux config", "Ctrl+B r", "Source ~/.tmux.conf live",
         f"{tbin} source-file {shlex.quote(os.path.join(HOME, '.tmux.conf'))} \\; display-message 'tmux config reloaded'"),
    ]


AFC_KEEP = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "afc-bar.d")
HOSTNAME = socket.gethostname()
BRAILLE_SPIN = set("⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏")
TMUX_STYLE_RE = re.compile(r"#\[[^\]]*\]")

PROVIDER_COLORS = {
    "claude": FG_PURPLE,
    "codex": FG_GREEN,
    "gemini": FG_CYAN,
    "agy": FG_BLUE,
    "copilot": FG_WHITE,
    "opencode": FG_AMBER,
    "council": FG_AMBER,
}


def _read_pane_who(pane_pid):
    """Read cached provider & account from afc-bar.d/w<pid> (zero subprocesses)."""
    if not pane_pid:
        return "", ""
    path = os.path.join(AFC_KEEP, f"w{pane_pid}")
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            lines = [ln.strip() for ln in f.readlines()]
        if len(lines) >= 3 and lines[2]:
            parts = lines[2].split(None, 1)
            return parts[0].lower(), (parts[1] if len(parts) > 1 else "")
    except Exception:
        pass
    return "", ""


def _read_pane_header(pane_id):
    """Parse cached model, token summary, and express-lane flag from afc-bar.d/h<id>."""
    if not pane_id:
        return "", "", False
    path = os.path.join(AFC_KEEP, f"h{pane_id.lstrip('%')}")
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            lines = f.readlines()
        if len(lines) < 2:
            return "", "", False
        plain = TMUX_STYLE_RE.sub("", lines[1]).strip()
        express = "⚡" in plain
        groups = re.findall(r"\[([^\]]+)\]", plain)
        model, tokens = "", ""
        for idx, grp in enumerate(groups):
            g = grp.strip()
            if idx == 0:
                continue  # provider/account slot
            if g.startswith("T:"):
                tokens = g
            elif not model and not g.startswith(("S", "W", "API", "left ", "err")):
                model = g
        return model, tokens, express
    except Exception:
        return "", "", False


def _clean_pane_title(title, win_name):
    t = (title or "").strip()
    if not t or t == HOSTNAME:
        return ""
    # Strip leading agent glyph or spinner
    t = re.sub(r"^[✳✦●○•✻⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏⚡\s]+", "", t).strip()
    if win_name:
        t = re.sub(rf"\s*[|·\-–]\s*{re.escape(win_name)}\s*$", "", t).strip()
        t = re.sub(rf"\s*\({re.escape(win_name)}\)\s*$", "", t).strip()
    t = re.sub(r"\s*-\s*GitHub Copilot\s*$", "", t).strip()
    return t


def _extract_live_activity(sock, pane_id):
    """Sample bottom lines of a pane to extract live task / status cue."""
    raw = run_out(tmux_cmd(sock, "capture-pane", "-p", "-t", pane_id, "-S", "-18"))
    if not raw:
        return "", False, False
    lines = []
    for ln in raw.splitlines():
        s = ln.strip()
        if not s:
            continue
        # Skip horizontal rules / borders
        if set(s) <= set("─━═▄▀-_=~· "):
            continue
        lines.append(s)

    is_working = False
    is_done = False
    cue = ""
    prompt_line = ""
    fallback = ""

    skip_prefixes = (
        "? for shortcuts",
        "workspace (/directory)",
        "auto-accept edits",
        "⏵⏵ bypass permissions",
        "← for agents",
        "└ Tip:",
        "Type your message",
        "Ask Codex to do anything",
    )

    for ln in reversed(lines[-14:]):
        ln = re.sub(r"\s{2,}", " ", ln).strip()
        low = ln.lower()
        if any(p.lower() in low for p in skip_prefixes):
            continue
        if "esc to interrupt" in low or "esc to cancel" in low or re.search(r"\bworking\s*\(", low) or re.search(r"^[•⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]\s*(working|thinking|running|reading|editing)", low):
            is_working = True
            if low.startswith("esc to cancel") or low.startswith("esc to interrupt"):
                continue
            cleaned = re.sub(r"^[•⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏\s]+", "", ln)
            cleaned = re.sub(r"\s*[•·,]\s*esc to (interrupt|cancel)\)?", ")", cleaned)
            cleaned = re.sub(r"\(\s*esc to (interrupt|cancel),?\s*", "(", cleaned)
            cleaned = cleaned.replace("))", ")").strip()
            if not cue:
                cue = cleaned
            continue
        if ln.startswith("✻") and ("brewed" in low or "done" in low or "worked" in low or "cooked" in low or "churned" in low or "baked" in low):
            is_done = True
            if not cue:
                cue = ln.lstrip("✻ ").strip()
            continue
        if re.match(r"^[❯›>]\s+\S", ln):
            cand = re.sub(r"^[❯›>]\s+", "", ln).strip()
            if cand and not any(p.lower() in cand.lower() for p in ("type your message", "ask codex", "try \"", "thought for ")):
                if not prompt_line:
                    prompt_line = cand
            continue
        if not fallback and len(ln) >= 6 and not ln.startswith(("/", "~/", "GPT-", "Gemini ", "Claude ")):
            fallback = ln

    if cue:
        return cue, is_working, is_done
    if prompt_line:
        return f"› {prompt_line}", is_working, is_done
    return fallback, is_working, is_done


def load_window_agents(ctx, win_item):
    """Inspect all panes inside a window: provider, model, tokens, state, and live task."""
    sock = ctx["sock"]
    wid = win_item["wid"]
    wname = win_item.get("win_name", "")
    tbin = shlex.quote(TMUX_BIN) + (f" -S {shlex.quote(sock)}" if sock else " -L agents")
    fmt = "#{pane_index}\t#{pane_id}\t#{pane_pid}\t#{pane_active}\t#{@busy}\t#{@state}\t#{pane_current_command}\t#{pane_title}"
    out = run_out(tmux_cmd(sock, "list-panes", "-t", wid, "-F", fmt))
    agents = []

    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) < 8:
            continue
        pidx, pid_id, ppid, pactive, pbusy, pstate, pcmd, ptitle = parts[:8]
        prov, acct = _read_pane_who(ppid)
        if not prov:
            prov = pcmd or "shell"
        model, tokens, express = _read_pane_header(pid_id)
        title_clean = _clean_pane_title(ptitle, wname)
        activity, cap_working, cap_done = _extract_live_activity(sock, pid_id)
        if prov.startswith("python") and ("/agent new" in activity or "council" in activity.lower()):
            prov = "council"

        has_spinner = bool(ptitle) and any(ch in BRAILLE_SPIN for ch in ptitle[:3])
        if pbusy == "1" or pstate == "busy" or has_spinner or cap_working:
            badge, bcol = "▶ working", FG_CYAN
        elif pstate == "wait":
            badge, bcol = "◆ waiting", FG_AMBER
        elif pstate == "done" or cap_done:
            badge, bcol = "✓ done", FG_GREEN
        else:
            badge, bcol = "· idle", FG_MUTED

        if title_clean and activity:
            tl, al = title_clean.lower(), activity.lower()
            if tl in al or (tl.startswith(("working", "thinking")) and al.startswith(("working", "thinking"))):
                task_str = activity
            elif al in tl:
                task_str = title_clean
            else:
                task_str = f"{title_clean}  ·  {activity}"
        else:
            task_str = title_clean or activity or f"running {pcmd or 'shell'}"

        agents.append({
            "pane_idx": pidx,
            "pane_id": pid_id,
            "active": pactive == "1",
            "provider": prov,
            "account": acct,
            "prov_col": PROVIDER_COLORS.get(prov, FG_MUTED),
            "express": express,
            "model": model,
            "tokens": tokens,
            "badge": badge,
            "badge_col": bcol,
            "task": task_str,
            "cmd": f"{tbin} select-window -t {shlex.quote(wid)} \\; select-pane -t {shlex.quote(pid_id)}",
        })

    return agents


def _summarize_window_providers(sock, sess):
    """Build compact per-window provider summaries (e.g. 'claude · gemini · codex')."""
    out = run_out(tmux_cmd(sock, "list-panes", "-s", "-t", sess, "-F", "#{window_id}\t#{pane_pid}\t#{pane_current_command}"))
    by_win = {}
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        wid, ppid, pcmd = parts[:3]
        prov, _acct = _read_pane_who(ppid)
        by_win.setdefault(wid, []).append(prov or pcmd or "shell")

    summary = {}
    for wid, provs in by_win.items():
        counts = {}
        order = []
        for p in provs:
            if p not in counts:
                counts[p] = 0
                order.append(p)
            counts[p] += 1
        chunks = [f"{p} ×{counts[p]}" if counts[p] > 1 else p for p in order]
        summary[wid] = " · ".join(chunks)
    return summary


def load_sessions(ctx):
    rows = []
    sock = ctx["sock"]
    sess = ctx["session"] or "agents"
    fmt = "#{window_index}\t#{window_id}\t#{window_name}\t#{window_active}\t#{window_panes}\t#{@unseen}\t#{P:#{@busy}}\t#{P:#{@state}}\t#{pane_current_path}"
    out = run_out(tmux_cmd(sock, "list-windows", "-t", sess, "-F", fmt))
    prov_map = _summarize_window_providers(sock, sess)
    tbin = shlex.quote(TMUX_BIN) + (f" -S {shlex.quote(sock)}" if sock else " -L agents")

    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) < 9:
            continue
        idx, wid, name, active, panes, unseen, busy_s, state_s, cwd = parts[:9]
        if "1" in busy_s:
            badge, col = "▶ working", FG_CYAN
        elif "wait" in state_s:
            badge, col = "◆ waiting", FG_AMBER
        elif unseen:
            badge, col = "● unseen", FG_AMBER
        elif "done" in state_s:
            badge, col = "✓ done", FG_GREEN
        else:
            badge, col = "· idle", FG_MUTED
        short_cwd = cwd.replace(HOME, "~") if cwd.startswith(HOME) else cwd
        provs = prov_map.get(wid, "")
        meta = f"{panes}p  {provs}" if provs else f"{panes}p  {short_cwd}"
        rows.append({
            "kind": "window",
            "wid": wid,
            "win_idx": idx,
            "win_name": name,
            "panes_cnt": panes,
            "cwd": short_cwd,
            "active": active == "1",
            "label": f"{idx}  {name}",
            "meta": meta,
            "badge": badge,
            "badge_col": col,
            "cmd": f"{tbin} select-window -t {shlex.quote(wid)}",
        })

    # Minimised splits in =afcmin
    min_out = run_out(tmux_cmd(sock, "list-panes", "-s", "-t", "=afcmin", "-F", "#{pane_id}\t#{@min_from}\t#{window_name}\t#{pane_current_path}"))
    afc_min = shlex.quote(os.path.join(LOCAL_BIN, "afc-min"))
    for line in min_out.splitlines():
        parts = line.split("\t")
        if len(parts) < 4 or not parts[1]:
            continue
        pid, from_win, wname, cwd = parts[:4]
        short_cwd = cwd.replace(HOME, "~") if cwd.startswith(HOME) else cwd
        rows.append({
            "kind": "min",
            "active": False,
            "label": f"▣  {wname or pid}",
            "meta": short_cwd,
            "badge": "minimised",
            "badge_col": FG_PURPLE,
            "cmd": f"{afc_min} show {shlex.quote(ctx['client'])} {shlex.quote(ctx['win'])}",
        })

    # Other tmux sessions (excluding current & afcmin)
    sess_out = run_out(tmux_cmd(sock, "list-sessions", "-F", "#{session_name}\t#{session_windows}\t#{session_attached}"))
    for line in sess_out.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        sname, swins, sattached = parts[:3]
        if sname in (sess, "afcmin"):
            continue
        rows.append({
            "kind": "session",
            "active": False,
            "label": f"⌘  session:{sname}",
            "meta": f"{swins} windows",
            "badge": "attached" if sattached != "0" else "detached",
            "badge_col": FG_BLUE,
            "cmd": f"{tbin} switch-client -t {shlex.quote(sname)}",
        })

    return rows


def load_about(ctx):
    branch = run_out(["git", "-C", REPO_ROOT, "rev-parse", "--abbrev-ref", "HEAD"]) or "—"
    commit = run_out(["git", "-C", REPO_ROOT, "rev-parse", "--short", "HEAD"]) or "—"
    tmux_v = run_out([TMUX_BIN, "-V"]) or "tmux"
    autonice = run_out(["systemctl", "--user", "is-active", "autonice.service"]) or "inactive"
    cg = read_cgroup_summary()
    providers = []
    for tool in ("claude", "codex", "gemini", "agy", "copilot", "opencode"):
        found = bool(run_out(["/bin/sh", "-c", f"command -v {tool}"]))
        providers.append((tool, found))

    win_cnt = len(run_out(tmux_cmd(ctx["sock"], "list-windows", "-t", ctx["session"] or "agents", "-F", "#{window_id}")).splitlines())
    pane_cnt = len(run_out(tmux_cmd(ctx["sock"], "list-panes", "-s", "-t", ctx["session"] or "agents", "-F", "#{pane_id}")).splitlines())

    return {
        "branch": branch,
        "commit": commit,
        "tmux_v": tmux_v,
        "autonice": autonice,
        "cg": cg,
        "providers": providers,
        "win_cnt": win_cnt,
        "pane_cnt": pane_cnt,
    }


class MenuApp:
    def __init__(self, ctx):
        self.ctx = ctx
        self.tab = 0
        self.sel = [0, 0, 0, 0]
        self.scroll = [0, 0, 0, 0]
        self.commands = build_commands(ctx)
        self.sessions = load_sessions(ctx)
        self.settings = load_settings()
        self.cg = read_cgroup_summary()
        self.autonice = run_out(["systemctl", "--user", "is-active", "autonice.service"]) or "inactive"
        self.about = load_about(ctx)
        self.status_msg = ""
        self.tab_rects = []      # [(start_col_1based, end_col_1based, tab_idx)]
        self.row_map = {}        # screen_row_1based -> item_index
        self.inspect_win = None  # selected window dict when drilling into Sessions
        self.inspect_agents = [] # panes/agents loaded for inspect_win
        self.inspect_sel = 0
        self.inspect_scroll = 0
        self.back_rect = None    # (row, s_col, e_col)
        self.jump_rect = None    # (row, s_col, e_col)
        self.pending_cmd = None
        self.running = True

    def open_session_inspector(self, win_item):
        self.inspect_win = win_item
        self.inspect_agents = load_window_agents(self.ctx, win_item)
        self.inspect_sel = 0
        self.inspect_scroll = 0
        for i, ag in enumerate(self.inspect_agents):
            if ag["active"]:
                self.inspect_sel = i
                break
        self.status_msg = ""

    def current_items_len(self):
        if self.tab == 0:
            return len(self.commands)
        if self.tab == 1:
            if self.inspect_win is not None:
                return len(self.inspect_agents)
            return len(self.sessions)
        if self.tab == 2:
            return len(CONFIG_SCHEMA) + 1  # +1 for Reload tmux config action
        return 0

    def clamp_sel(self):
        n = self.current_items_len()
        if self.tab == 1 and self.inspect_win is not None:
            if n <= 0:
                self.inspect_sel = 0
                self.inspect_scroll = 0
            else:
                self.inspect_sel = max(0, min(self.inspect_sel, n - 1))
            return
        if n <= 0:
            self.sel[self.tab] = 0
            self.scroll[self.tab] = 0
            return
        self.sel[self.tab] = max(0, min(self.sel[self.tab], n - 1))

    def activate_current(self):
        self.clamp_sel()
        if self.tab == 1 and self.inspect_win is not None:
            idx = self.inspect_sel
            if 0 <= idx < len(self.inspect_agents):
                self.pending_cmd = self.inspect_agents[idx]["cmd"]
                self.running = False
            return
        idx = self.sel[self.tab]
        if self.tab == 0 and 0 <= idx < len(self.commands):
            self.pending_cmd = self.commands[idx][3]
            self.running = False
        elif self.tab == 1 and 0 <= idx < len(self.sessions):
            item = self.sessions[idx]
            if item.get("kind") == "window":
                self.open_session_inspector(item)
            else:
                self.pending_cmd = item["cmd"]
                self.running = False
        elif self.tab == 2:
            if idx < len(CONFIG_SCHEMA):
                key, _desc, choices, default = CONFIG_SCHEMA[idx]
                cur = self.settings.get(key, default)
                nxt = choices[(choices.index(cur) + 1) % len(choices)] if cur in choices else choices[0]
                save_setting(key, nxt)
                self.settings[key] = nxt
                self.status_msg = f"Saved {key} = {nxt} in ~/.config/agents/settings"
            else:
                sock = shlex.quote(self.ctx["sock"]) if self.ctx["sock"] else ""
                tbin = shlex.quote(TMUX_BIN) + (f" -S {sock}" if sock else " -L agents")
                self.pending_cmd = f"{tbin} source-file {shlex.quote(os.path.join(HOME, '.tmux.conf'))} \\; display-message 'tmux config reloaded'"
                self.running = False

    def render(self):
        w, h = get_term_size()
        out = ["\x1b[H"]
        self.tab_rects = []
        self.row_map = {}
        self.back_rect = None
        self.jump_rect = None

        # Row 1: Pill tab bar matching reference look
        line1 = f"{BG_MAIN} "
        col = 2
        for i, name in enumerate(TABS):
            num = str(i + 1)
            pill_plain = f" {num} {name} "
            start_c = col
            end_c = col + len(pill_plain) - 1
            self.tab_rects.append((start_c, end_c, i))
            if i == self.tab:
                line1 += f"{BG_TAB_ON}{FG_CYAN}{BOLD} {num} {FG_WHITE}{name} {RESET}{BG_MAIN}"
            else:
                line1 += f"{BG_TAB_OFF}{FG_AMBER} {num} {FG_TEXT}{name} {RESET}{BG_MAIN}"
            col += len(pill_plain)
            if i < len(TABS) - 1:
                line1 += "  "
                col += 2
        right_hint = "Esc to close "
        pad = max(1, w - col - len(right_hint) + 1)
        line1 += (" " * pad) + f"{FG_DIM}{right_hint}{RESET}"
        out.append(line1 + "\x1b[K")

        # Row 2: Divider
        out.append(f"\x1b[2;1H{BG_MAIN}{FG_DIM}{'─' * w}{RESET}")

        # Body area: rows 3 .. h-2
        body_top = 3
        body_rows = max(1, h - 4)
        self.clamp_sel()

        if self.tab == 0:
            self._render_commands(out, w, body_top, body_rows)
        elif self.tab == 1:
            self._render_sessions(out, w, body_top, body_rows)
        elif self.tab == 2:
            self._render_config(out, w, body_top, body_rows)
        else:
            self._render_about(out, w, body_top, body_rows)

        # Row h-1: divider / status feedback
        if self.status_msg:
            msg = trunc(self.status_msg, w - 2)
            out.append(f"\x1b[{h - 1};1H{BG_MAIN}{FG_GREEN} {msg}{' ' * max(0, w - len(msg) - 1)}{RESET}")
        else:
            out.append(f"\x1b[{h - 1};1H{BG_MAIN}{FG_DIM}{'─' * w}{RESET}")

        # Row h: footer bar
        if self.tab == 1 and self.inspect_win is not None:
            footer = " Enter/Click: open pane   ←/Esc: back   g: jump tab   r: refresh   q: close"
        elif self.tab == 1:
            footer = " Enter/Click: inspect agents   g: jump tab   r: refresh   1-4: tabs   Esc: close"
        else:
            footer = " ←/→ Tab: tabs   ↑/↓: select   Enter/Click: run   1-4: jump   q/Esc: close"
        footer = trunc(footer, w)
        out.append(f"\x1b[{h};1H{BG_MAIN}{FG_MUTED}{footer}{' ' * max(0, w - len(footer))}{RESET}")

        sys.stdout.write("".join(out))
        sys.stdout.flush()

    def _adjust_scroll(self, n, visible):
        sel = self.sel[self.tab]
        sc = self.scroll[self.tab]
        if sel < sc:
            sc = sel
        elif sel >= sc + visible:
            sc = sel - visible + 1
        sc = max(0, min(sc, max(0, n - visible)))
        self.scroll[self.tab] = sc
        return sc

    def _render_commands(self, out, w, top, rows):
        sc = self._adjust_scroll(len(self.commands), rows)
        for r in range(rows):
            idx = sc + r
            y = top + r
            if idx >= len(self.commands):
                out.append(f"\x1b[{y};1H{BG_MAIN}{' ' * w}{RESET}")
                continue
            self.row_map[y] = idx
            name, key, desc, _cmd = self.commands[idx]
            selected = idx == self.sel[self.tab]
            bg = BG_SEL if selected else BG_MAIN
            ptr = f"{FG_BLUE}▸ " if selected else "  "
            name_w = 24
            key_w = 13
            desc_w = max(0, w - 2 - name_w - key_w - 2)
            name_s = trunc(name, name_w).ljust(name_w)
            key_s = trunc(key, key_w).ljust(key_w)
            desc_s = trunc(desc, desc_w).ljust(desc_w)
            name_col = f"{FG_WHITE}{BOLD}" if selected else FG_TEXT
            out.append(
                f"\x1b[{y};1H{bg}{ptr}{name_col}{name_s}{RESET}{bg}"
                f"{FG_AMBER}{key_s}{FG_MUTED}{desc_s}  {RESET}"
            )

    def _render_sessions(self, out, w, top, rows):
        if self.inspect_win is not None:
            self._render_session_agents(out, w, top, rows)
            return
        if not self.sessions:
            for r in range(rows):
                y = top + r
                msg = "  No active fleet tabs found." if r == 1 else ""
                out.append(f"\x1b[{y};1H{BG_MAIN}{FG_MUTED}{msg.ljust(w)}{RESET}")
            return
        sc = self._adjust_scroll(len(self.sessions), rows)
        for r in range(rows):
            idx = sc + r
            y = top + r
            if idx >= len(self.sessions):
                out.append(f"\x1b[{y};1H{BG_MAIN}{' ' * w}{RESET}")
                continue
            self.row_map[y] = idx
            item = self.sessions[idx]
            selected = idx == self.sel[self.tab]
            bg = BG_SEL if selected else BG_MAIN
            ptr = f"{FG_BLUE}▸ " if selected else ("● " if item["active"] else "  ")
            ptr_col = FG_BLUE if selected else (FG_PURPLE if item["active"] else FG_DIM)
            label_w = 24
            badge_w = 12
            chevron = " › " if item.get("kind") == "window" else "   "
            meta_w = max(0, w - 2 - label_w - badge_w - len(chevron))
            label_s = trunc(item["label"], label_w).ljust(label_w)
            badge_s = trunc(item["badge"], badge_w).ljust(badge_w)
            meta_s = trunc(item["meta"], meta_w).ljust(meta_w)
            name_col = f"{FG_WHITE}{BOLD}" if selected else (f"{FG_PURPLE}{BOLD}" if item["active"] else FG_TEXT)
            chev_col = FG_BLUE if selected else FG_DIM
            out.append(
                f"\x1b[{y};1H{bg}{ptr_col}{ptr}{name_col}{label_s}{RESET}{bg}"
                f"{item['badge_col']}{badge_s}{FG_MUTED}{meta_s}{chev_col}{chevron}{RESET}"
            )

    def _render_session_agents(self, out, w, top, rows):
        win = self.inspect_win
        agents = self.inspect_agents

        # Header strip (row = top): clickable Back button, session title, clickable Jump button
        back_lbl = " ← Sessions "
        jump_lbl = " ⇄ Jump tab "
        self.back_rect = (top, 2, 2 + len(back_lbl) - 1)
        jump_start = max(2 + len(back_lbl) + 2, w - len(jump_lbl))
        self.jump_rect = (top, jump_start, jump_start + len(jump_lbl) - 1)

        mid_avail = max(4, jump_start - (2 + len(back_lbl)) - 2)
        title_txt = trunc(f"›  {win['label']}  ({len(agents)}p · {win['badge']})", mid_avail)
        pad_mid = max(1, jump_start - (2 + len(back_lbl) + 1 + len(title_txt)))
        hdr = (
            f"\x1b[{top};1H{BG_MAIN} "
            f"{BG_TAB_OFF}{FG_BLUE}{BOLD}{back_lbl}{RESET}{BG_MAIN} "
            f"{FG_WHITE}{BOLD}{title_txt}{RESET}{BG_MAIN}"
            f"{' ' * pad_mid}"
            f"{BG_TAB_OFF}{FG_CYAN}{jump_lbl}{RESET}{BG_MAIN}\x1b[K{RESET}"
        )
        out.append(hdr)

        # Divider (row = top + 1)
        if rows >= 2:
            out.append(f"\x1b[{top + 1};1H{BG_MAIN}{FG_DIM}{'─' * w}{RESET}")

        list_top = top + 2
        list_rows = max(0, rows - 2)
        if not agents:
            for r in range(list_rows):
                y = list_top + r
                msg = "  No panes found in this session." if r == 1 else ""
                out.append(f"\x1b[{y};1H{BG_MAIN}{FG_MUTED}{msg.ljust(w)}{RESET}")
            return

        # Each agent renders as a 2-row card (line 1: provider/model/tokens/state, line 2: live task)
        card_h = 2
        cards_vis = max(1, list_rows // card_h)
        sc = self.inspect_scroll
        if self.inspect_sel < sc:
            sc = self.inspect_sel
        elif self.inspect_sel >= sc + cards_vis:
            sc = self.inspect_sel - cards_vis + 1
        sc = max(0, min(sc, max(0, len(agents) - cards_vis)))
        self.inspect_scroll = sc

        used_rows = 0
        for slot in range(cards_vis):
            idx = sc + slot
            y1 = list_top + slot * card_h
            y2 = y1 + 1
            if y1 >= top + rows:
                break
            if idx >= len(agents):
                out.append(f"\x1b[{y1};1H{BG_MAIN}{' ' * w}{RESET}")
                if y2 < top + rows:
                    out.append(f"\x1b[{y2};1H{BG_MAIN}{' ' * w}{RESET}")
                used_rows += card_h
                continue

            ag = agents[idx]
            selected = idx == self.inspect_sel
            bg = BG_SEL if selected else BG_MAIN
            self.row_map[y1] = idx
            if y2 < top + rows:
                self.row_map[y2] = idx

            ptr = f"{FG_BLUE}▸ " if selected else ("● " if ag["active"] else "  ")
            ptr_col = FG_BLUE if selected else (FG_PURPLE if ag["active"] else FG_DIM)

            pane_tag = f"p{ag['pane_idx']}".ljust(3)
            exp_ch = "⚡" if ag["express"] else " "
            exp_cols = 2 if ag["express"] else 1
            prov_name = ag["provider"].upper()
            acct_part = f" {ag['account']}" if ag["account"] else ""
            prov_w = 15 - (exp_cols - 1)
            prov_str = trunc(f"{prov_name}{acct_part}", prov_w).ljust(prov_w)
            model_str = trunc(ag["model"], 14).ljust(14)
            badge_str = ag["badge"].rjust(10)
            tok_w = max(0, w - 2 - 3 - exp_cols - prov_w - 1 - 14 - 1 - 10 - 2)
            tok_str = trunc(ag["tokens"], tok_w).ljust(tok_w)

            out.append(
                f"\x1b[{y1};1H{bg}{ptr_col}{ptr}"
                f"{FG_DIM}{pane_tag}"
                f"{FG_AMBER}{exp_ch}"
                f"{ag['prov_col']}{BOLD}{prov_str}{RESET}{bg} "
                f"{FG_TEXT}{model_str} "
                f"{FG_CYAN}{tok_str}"
                f"{ag['badge_col']}{badge_str}  {RESET}"
            )

            if y2 < top + rows:
                task_prefix = "      Task: "
                task_w = max(4, w - len(task_prefix) - 2)
                task_s = trunc(ag["task"], task_w).ljust(task_w)
                t_col = FG_WHITE if selected else FG_MUTED
                out.append(
                    f"\x1b[{y2};1H{bg}{FG_DIM}{task_prefix}{t_col}{task_s}  {RESET}"
                )
            used_rows += card_h

        for r in range(used_rows, list_rows):
            y = list_top + r
            out.append(f"\x1b[{y};1H{BG_MAIN}{' ' * w}{RESET}")

    def _render_config(self, out, w, top, rows):
        summary_lines = 3
        list_rows = max(1, rows - summary_lines)
        total = len(CONFIG_SCHEMA) + 1
        sc = self._adjust_scroll(total, list_rows)

        for r in range(list_rows):
            idx = sc + r
            y = top + r
            if idx >= total:
                out.append(f"\x1b[{y};1H{BG_MAIN}{' ' * w}{RESET}")
                continue
            self.row_map[y] = idx
            selected = idx == self.sel[self.tab]
            bg = BG_SEL if selected else BG_MAIN
            ptr = f"{FG_BLUE}▸ " if selected else "  "
            if idx < len(CONFIG_SCHEMA):
                key, desc, _choices, default = CONFIG_SCHEMA[idx]
                cur = self.settings.get(key, default)
                val_col = FG_GREEN if cur in ("on", "unified", "enforce") else (FG_AMBER if cur in ("compact", "ask", "report") else FG_CYAN)
                key_w = 16
                val_w = 12
                desc_w = max(0, w - 2 - key_w - val_w - 2)
                key_s = trunc(key, key_w).ljust(key_w)
                val_s = trunc(f"[{cur}]", val_w).ljust(val_w)
                desc_s = trunc(desc, desc_w).ljust(desc_w)
                kcol = f"{FG_WHITE}{BOLD}" if selected else FG_TEXT
                out.append(
                    f"\x1b[{y};1H{bg}{ptr}{kcol}{key_s}{RESET}{bg}"
                    f"{val_col}{BOLD}{val_s}{RESET}{bg}{FG_MUTED}{desc_s}  {RESET}"
                )
            else:
                txt = trunc("↻ Reload tmux config (~/.tmux.conf)", w - 4).ljust(w - 2)
                out.append(f"\x1b[{y};1H{bg}{ptr}{FG_BLUE}{BOLD}{txt}{RESET}")

        # Live cgroup summary strip at bottom of Config tab
        y0 = top + list_rows
        cpu = fmt_cpu_max(self.cg.get("cpu.max", ""))
        mem_cur = fmt_bytes(self.cg.get("memory.current", ""))
        mem_hi = fmt_bytes(self.cg.get("memory.high", ""))
        mem_max = fmt_bytes(self.cg.get("memory.max", ""))
        pids = f"{self.cg.get('pids.current', '?')}/{self.cg.get('pids.max', '?')}"
        io_w = self.cg.get("io.weight", "").replace("default ", "") or "?"
        if y0 < top + rows:
            out.append(f"\x1b[{y0};1H{BG_MAIN}{FG_DIM}{'─' * w}{RESET}")
        if y0 + 1 < top + rows:
            s1 = trunc(f"  agents.slice   CPU: {cpu}   RAM: {mem_cur} / {mem_hi} soft / {mem_max} max", w)
            out.append(f"\x1b[{y0 + 1};1H{BG_MAIN}{FG_CYAN}{s1.ljust(w)}{RESET}")
        if y0 + 2 < top + rows:
            s2 = trunc(f"  Tasks: {pids}   IOWeight: {io_w}   autonice: {self.autonice}   (Enter/Click toggles)", w)
            out.append(f"\x1b[{y0 + 2};1H{BG_MAIN}{FG_MUTED}{s2.ljust(w)}{RESET}")

    def _render_about(self, out, w, top, rows):
        a = self.about
        cg = a["cg"]
        prov_parts = []
        for name, ok in a["providers"]:
            prov_parts.append(f"{FG_GREEN}● {name}" if ok else f"{FG_DIM}○ {name}")
        prov_line = "   ".join(prov_parts)

        val_w = max(10, w - 16)
        cg_line = trunc(
            f"CPU {fmt_cpu_max(cg.get('cpu.max', ''))} · RAM {fmt_bytes(cg.get('memory.current', ''))}/{fmt_bytes(cg.get('memory.high', ''))} (max {fmt_bytes(cg.get('memory.max', ''))}) · Tasks {cg.get('pids.current', '?')}/{cg.get('pids.max', '?')}",
            val_w,
        )
        rt_line = trunc(
            f"{a['tmux_v']} · {a['win_cnt']} tabs, {a['pane_cnt']} panes · autonice: {a['autonice']}",
            val_w,
        )
        repo_line = trunc(
            f"{REPO_ROOT.replace(HOME, '~')} ({a['branch']} @ {a['commit']})",
            val_w,
        )
        bio = [
            "Tech engineer with over a decade of experience in tech, combining",
            "deep digital acumen across AI, Cloud, Security & IoT — building",
            "sub-200ms STT/TTS Voice AI, autonomous multi-agent platforms,",
            "smart EV/motorcycle OS, custom MCP servers, RAG & edge AI.",
        ]
        author_s = 'John Marion "JM" Grefaldo (@Geek2017)'
        motto_s = '"MO ERGASTEE FORN, MO ERGALONE FORN NORT..."'
        lines = [
            (f"{FG_BLUE}{BOLD}  Agentic CLI Fleet (ACF)", ""),
            (f"{FG_MUTED}  {trunc('Multi-provider tmux fleet with live telemetry, Council & cgroup guards', max(10, w - 2))}", ""),
            ("", ""),
            (f"{FG_PURPLE}{BOLD}  Author        ", f"{FG_WHITE}{BOLD}{trunc(author_s, val_w)}"),
            (f"{FG_PURPLE}  Role          ", f"{FG_CYAN}{trunc('AI Founder, Chief AI Architect & Digital Acumen Leader', val_w)}"),
            (f"{FG_PURPLE}  Featured In   ", f"{FG_AMBER}{trunc('GMA News  ·  GadgetMatch  ·  PhilSTAR Life  ·  VISOR', val_w)}"),
            (f"{FG_PURPLE}  Work          ", f"{FG_TEXT}{trunc(bio[0], val_w)}"),
            (f"{FG_PURPLE}                ", f"{FG_TEXT}{trunc(bio[1], val_w)}"),
            (f"{FG_PURPLE}                ", f"{FG_TEXT}{trunc(bio[2], val_w)}"),
            (f"{FG_PURPLE}                ", f"{FG_TEXT}{trunc(bio[3], val_w)}"),
            (f"{FG_PURPLE}  Credentials   ", f"{FG_MUTED}{trunc('MBA · M.S. Big Data & BI · AI Educator & Cloud Ambassador', val_w)}"),
            (f"{FG_PURPLE}  Motto         ", f"{FG_AMBER}{trunc(motto_s, val_w)}"),
            ("", ""),
            (f"{FG_AMBER}  Repository    ", f"{FG_TEXT}{repo_line}"),
            (f"{FG_AMBER}  Runtime       ", f"{FG_TEXT}{rt_line}"),
            (f"{FG_AMBER}  agents.slice  ", f"{FG_TEXT}{cg_line}"),
            (f"{FG_AMBER}  Providers     ", prov_line),
            (f"{FG_BLUE}  Source        ", f"{FG_CYAN}{trunc('github.com/Geek2017/ACF', val_w)}"),
        ]

        for r in range(rows):
            y = top + r
            if r < len(lines):
                k, v = lines[r]
                out.append(f"\x1b[{y};1H{BG_MAIN}{k}{v}{RESET}{BG_MAIN}\x1b[K{RESET}")
            else:
                out.append(f"\x1b[{y};1H{BG_MAIN}{' ' * w}{RESET}")

    def _set_active_sel(self, idx):
        if self.tab == 1 and self.inspect_win is not None:
            self.inspect_sel = max(0, min(idx, max(0, len(self.inspect_agents) - 1)))
        else:
            self.sel[self.tab] = max(0, min(idx, max(0, self.current_items_len() - 1)))

    def _get_active_sel(self):
        if self.tab == 1 and self.inspect_win is not None:
            return self.inspect_sel
        return self.sel[self.tab]

    def handle_mouse(self, btn, col, row, pressed):
        # Scroll wheel (64 = up, 65 = down)
        if btn == 64:
            self._set_active_sel(self._get_active_sel() - 1)
            return
        if btn == 65:
            self._set_active_sel(self._get_active_sel() + 1)
            return

        # Motion hover (btn & 32): highlight hovered row smoothly
        if btn & 32:
            if row in self.row_map:
                self._set_active_sel(self.row_map[row])
            return

        # Left click press (btn == 0, pressed == 'M')
        if btn == 0 and pressed == "M":
            if row == 1:
                for s_col, e_col, t_idx in self.tab_rects:
                    if s_col <= col <= e_col:
                        if t_idx == 1 and self.tab == 1 and self.inspect_win is not None:
                            self.inspect_win = None
                        self.tab = t_idx
                        self.status_msg = ""
                        return
                # Click on "Esc to close" at top-right
                w, _ = get_term_size()
                if col >= w - 13:
                    self.running = False
                return
            if self.back_rect and row == self.back_rect[0] and self.back_rect[1] <= col <= self.back_rect[2]:
                self.inspect_win = None
                self.status_msg = ""
                return
            if self.jump_rect and row == self.jump_rect[0] and self.jump_rect[1] <= col <= self.jump_rect[2]:
                if self.inspect_win is not None:
                    self.pending_cmd = self.inspect_win["cmd"]
                    self.running = False
                return
            if row in self.row_map:
                self._set_active_sel(self.row_map[row])
                self.activate_current()

    def handle_key(self, data):
        if not data:
            return
        # SGR mouse sequence: ESC [ < btn ; col ; row M/m
        if data.startswith("\x1b[<"):
            m = re.match(r"^\x1b\[<(\d+);(\d+);(\d+)([Mm])$", data)
            if m:
                self.handle_mouse(int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4))
            return
        # Inside Session Inspector: Esc / Backspace / Left / h returns to Sessions list
        if self.tab == 1 and self.inspect_win is not None:
            if data in ("\x1b", "\x7f", "\x08", "\x1b[D", "h"):
                self.inspect_win = None
                self.status_msg = ""
                return
            if data in ("g", "G"):
                self.pending_cmd = self.inspect_win["cmd"]
                self.running = False
                return
            if data in ("r", "R"):
                self.inspect_agents = load_window_agents(self.ctx, self.inspect_win)
                self.status_msg = f"Refreshed {self.inspect_win['win_name']} ({len(self.inspect_agents)} panes)"
                return
        if data in ("\x1b", "q", "Q", "\x03"):
            self.running = False
        elif data in ("\t", "\x1b[C", "l"):
            if self.tab == 1 and self.inspect_win is None and data in ("\x1b[C", "l"):
                # Right arrow on a window row drills into its agents
                self.clamp_sel()
                idx = self.sel[1]
                if 0 <= idx < len(self.sessions) and self.sessions[idx].get("kind") == "window":
                    self.open_session_inspector(self.sessions[idx])
                    return
            self.tab = (self.tab + 1) % len(TABS)
            self.status_msg = ""
        elif data in ("\x1b[Z", "\x1b[D", "h"):
            self.tab = (self.tab - 1) % len(TABS)
            self.status_msg = ""
        elif data in ("1", "2", "3", "4"):
            nxt_tab = int(data) - 1
            if nxt_tab == 1 and self.tab == 1 and self.inspect_win is not None:
                self.inspect_win = None
            self.tab = nxt_tab
            self.status_msg = ""
        elif data in ("\x1b[A", "k"):
            self._set_active_sel(self._get_active_sel() - 1)
        elif data in ("\x1b[B", "j"):
            self._set_active_sel(self._get_active_sel() + 1)
        elif data in ("\r", "\n", " "):
            self.activate_current()
        elif data in ("g", "G") and self.tab == 1 and self.inspect_win is None:
            self.clamp_sel()
            idx = self.sel[1]
            if 0 <= idx < len(self.sessions):
                self.pending_cmd = self.sessions[idx]["cmd"]
                self.running = False
        elif data in ("r", "R") and self.tab == 1:
            self.sessions = load_sessions(self.ctx)
            self.status_msg = "Refreshed sessions"

    @staticmethod
    def _pop_tokens(buf, fd):
        """Parse complete key/CSI/SGR-mouse tokens without ever splitting an ESC sequence."""
        tokens = []
        i = 0
        n = len(buf)
        while i < n:
            if buf[i] != "\x1b":
                tokens.append(buf[i])
                i += 1
                continue
            # ESC at end of buffer: wait briefly to see if a CSI/mouse sequence follows
            if i + 1 == n:
                rlist, _, _ = select.select([fd], [], [], 0.025)
                if rlist:
                    more = os.read(fd, 4096).decode("utf-8", errors="ignore")
                    if more:
                        buf += more
                        n = len(buf)
                        continue
                tokens.append("\x1b")
                i += 1
                continue
            nxt = buf[i + 1]
            if nxt in ("[", "O"):
                # Scan for CSI/SS3 final byte (0x40..0x7E)
                j = i + 2
                while j < n and not (0x40 <= ord(buf[j]) <= 0x7E):
                    j += 1
                if j >= n:
                    # Incomplete sequence at buffer end; wait briefly for rest, else keep pending
                    rlist, _, _ = select.select([fd], [], [], 0.025)
                    if rlist:
                        more = os.read(fd, 4096).decode("utf-8", errors="ignore")
                        if more:
                            buf += more
                            n = len(buf)
                            continue
                    break
                tokens.append(buf[i : j + 1])
                i = j + 1
            else:
                # Alt+key two-byte sequence: consume cleanly, never treat as bare Esc
                tokens.append(buf[i : i + 2])
                i += 2
        return tokens, buf[i:]

    def run(self):
        fd = sys.stdin.fileno()
        old_tty = termios.tcgetattr(fd)
        resized = [False]

        def on_winch(_sig, _frame):
            resized[0] = True

        signal.signal(signal.SIGWINCH, on_winch)
        try:
            tty.setraw(fd)
            # Alt screen, hide cursor, enable SGR mouse + hover tracking
            sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1003h\x1b[?1006h")
            sys.stdout.flush()
            self.render()
            pending = ""
            while self.running:
                if resized[0]:
                    resized[0] = False
                    self.render()
                try:
                    rlist, _, _ = select.select([fd], [], [], 0.2)
                except InterruptedError:
                    continue
                if not rlist:
                    continue
                chunk = os.read(fd, 4096).decode("utf-8", errors="ignore")
                if not chunk:
                    break
                pending += chunk
                tokens, pending = self._pop_tokens(pending, fd)
                for tok in tokens:
                    self.handle_key(tok)
                    if not self.running:
                        break
                if self.running:
                    self.render()
        finally:
            sys.stdout.write("\x1b[?1006l\x1b[?1003l\x1b[?1000l\x1b[?25h\x1b[?1049l")
            sys.stdout.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, old_tty)

        if self.pending_cmd:
            spawn_deferred(self.pending_cmd)


def main():
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print("Usage: afc-menu [--open] [socket_path] [client_name] [window_id] [pane_id] [pane_pid] [pane_path] [session_name]")
        return 0
    if args and args[0] == "--open":
        rest = args[1:]
        sock = rest[0] if len(rest) > 0 else ""
        client = rest[1] if len(rest) > 1 else ""
        inner = " ".join(shlex.quote(x) for x in [os.path.join(LOCAL_BIN, "afc-menu"), *rest])
        cmd = tmux_cmd(
            sock,
            "display-popup", "-E",
            *(["-c", client] if client else []),
            "-x", "C", "-y", "C", "-w", "84", "-h", "24",
            "-b", "rounded", "-S", "fg=#7aa2f7", "-T", " [ACF] ",
            inner,
        )
        return subprocess.run(cmd).returncode
    ctx = {
        "sock": args[0] if len(args) > 0 else "",
        "client": args[1] if len(args) > 1 else "",
        "win": args[2] if len(args) > 2 else "",
        "pane": args[3] if len(args) > 3 else "",
        "pid": args[4] if len(args) > 4 else "",
        "cwd": args[5] if len(args) > 5 else os.getcwd(),
        "session": args[6] if len(args) > 6 else "agents",
    }
    if not sys.stdin.isatty():
        # Non-interactive smoke test check
        print(f"afc-menu tabs={TABS} commands={len(build_commands(ctx))} config={len(CONFIG_SCHEMA)}")
        return 0
    MenuApp(ctx).run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
