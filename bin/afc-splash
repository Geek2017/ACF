#!/usr/bin/env python3
"""afc-splash: the fleet's splash screen. A small white rectangle in the middle of the screen: the
logo's animation on the left, the name and what is happening on the right, and a thin bar along
the bottom that fills while it plays.

    afc-splash [--text "Starting the fleet…"] [--seconds 5]    play it once, then close
    afc-splash --save FILE [--frame N]                         draw one frame to a PNG (no window)

It plays when the fleet window opens and no window shows the fleet yet (agents --new-window, which
opens the window once the splash is done), and while the .deb's first run sets the fleet up. The
animation is fitted to --seconds (5 by default). A click or Esc closes it early. It never takes
the keyboard. Off: `splash off` in ~/.config/agents/settings, or ACF_SPLASH=0.

The frames are made from logo.png by _tools/build-logo.py: share/acf/splash.png (every frame side
by side) and splash.json (each frame's time and strength). Needs GTK 3 for Python (python3-gi,
gir1.2-gtk-3.0); without it, or without a screen, it does nothing and exits 0.
"""
import fcntl
import json
import os
import sys

TITLE = "Agentic CLI Fleet"
INK = (0.13, 0.19, 0.23)          # the logo's dark grey
GREY = (0.42, 0.46, 0.50)
BLUE = (0.16, 0.44, 0.87)         # the logo's planes


def assets():
    """share/acf beside this program (its real path: the fleet's folder), else the copies."""
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (os.path.join(here, "..", "share", "acf"), os.path.expanduser("~/.local/share/acf"),
              "/opt/agentic-cli-fleet/share/acf"):
        if os.path.exists(os.path.join(d, "splash.png")) and os.path.exists(os.path.join(d, "splash.json")):
            return os.path.normpath(d)
    return None


def splash_off():
    if os.environ.get("ACF_SPLASH", "").lower() in ("0", "off", "no"):
        return True
    path = os.environ.get("AGENTS_SETTINGS") or os.path.expanduser("~/.config/agents/settings")
    try:
        with open(path) as f:
            for line in f:
                p = line.split()
                if len(p) >= 2 and p[0] == "splash":
                    return p[1].lower() in ("off", "0", "no")
    except OSError:
        pass
    return False


def arg(name, default=None):
    a = sys.argv[1:]
    return a[a.index(name) + 1] if name in a and a.index(name) + 1 < len(a) else default


class Card:
    """What is drawn: the white rectangle, the frame on the left, the name and the status line on
    the right, the bar along the bottom."""
    PAD, GAP, TEXT_W, BAR = 16, 18, 190, 3

    def __init__(self, strip, meta, text):
        self.strip, self.meta, self.text = strip, meta, text
        self.fw, self.fh = meta["width"], meta["height"]
        self.w = self.PAD + self.fw + self.GAP + self.TEXT_W + self.PAD
        self.h = self.PAD + self.fh + self.PAD + self.BAR

    def draw(self, cr, i, done=0.0):
        from gi.repository import Gdk
        w, h = self.w, self.h
        cr.set_source_rgb(1, 1, 1)
        cr.paint()
        cr.rectangle(0.5, 0.5, w - 1, h - 1)
        cr.set_source_rgba(*INK, 0.22)
        cr.set_line_width(1)
        cr.stroke()
        Gdk.cairo_set_source_pixbuf(cr, self.strip, self.PAD - i * self.fw, self.PAD)
        cr.rectangle(self.PAD, self.PAD, self.fw, self.fh)
        cr.fill()
        x = self.PAD + self.fw + self.GAP
        mid = self.PAD + self.fh / 2
        cr.select_font_face("Sans", 0, 1)       # normal, bold
        cr.set_font_size(17)
        cr.set_source_rgb(*INK)
        cr.move_to(x, mid - 2)
        cr.show_text(TITLE)
        cr.select_font_face("Sans", 0, 0)
        cr.set_font_size(12)
        cr.set_source_rgb(*GREY)
        cr.move_to(x, mid + 18)
        cr.show_text(self.text)
        cr.rectangle(1, h - 1 - self.BAR, (w - 2) * max(0.0, min(1.0, done)), self.BAR)
        cr.set_source_rgb(*BLUE)
        cr.fill()


def main():
    save = arg("--save")
    if not save and (splash_off() or not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))):
        return 0
    d = assets()
    if not d:
        return 0
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
    except (ImportError, ValueError):
        return 0
    with open(os.path.join(d, "splash.json")) as f:
        meta = json.load(f)
    n = meta["frames"]
    # the animation fitted to --seconds, each frame keeping its share of the time
    try:
        seconds = max(1.0, float(arg("--seconds", "5")))
    except ValueError:
        seconds = 5.0
    k = seconds * 1000 / max(1, sum(meta["durations"]))
    times = [max(16, round(ms * k)) for ms in meta["durations"]]
    strip = GdkPixbuf.Pixbuf.new_from_file(os.path.join(d, "splash.png"))
    card = Card(strip, meta, arg("--text", "Starting the fleet…"))

    if save:                                    # one frame to a PNG, for a look without a window
        import cairo
        i = max(0, min(n - 1, int(arg("--frame", str(n - 1)))))
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, card.w, card.h)
        card.draw(cairo.Context(surf), i, sum(times[:i + 1]) / sum(times))
        surf.write_to_png(save)
        return 0

    # one splash at a time (a second press of the launcher while it plays shows nothing more)
    run = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    lock = open(os.path.join(run, f"afc-splash-{os.getuid()}.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0

    from gi.repository import Gdk, GLib, Gtk
    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title(TITLE)
    win.set_icon_name("acf")
    win.set_decorated(False)
    win.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_keep_above(True)
    win.set_accept_focus(False)
    win.set_focus_on_map(False)
    win.set_resizable(False)
    win.set_default_size(card.w, card.h)
    win.set_size_request(card.w, card.h)
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_app_paintable(True)
    state = {"i": 0}
    strength = meta.get("strength") or [1] * n
    last_full = max([j for j, s in enumerate(strength) if s >= 1] or [n - 1])
    total = sum(times)

    def on_draw(_w, cr):
        card.draw(cr, state["i"], sum(times[:state["i"] + 1]) / total)
        return False

    def step():
        i = state["i"] + 1
        if i >= n:
            Gtk.main_quit()
            return False
        state["i"] = i
        if i > last_full:                       # the logo's own fade-out takes the card with it
            Gtk.Widget.set_opacity(win, max(0.0, strength[i]))
        win.queue_draw()
        GLib.timeout_add(times[i], step)
        return False

    def close(*_):
        Gtk.main_quit()
        return True

    win.connect("draw", on_draw)
    win.connect("delete-event", close)
    win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.KEY_PRESS_MASK)
    win.connect("button-press-event", close)
    win.connect("key-press-event", lambda _w, e: close() if e.keyval == Gdk.KEY_Escape else False)
    GLib.timeout_add(times[0], step)
    GLib.timeout_add(total + 3000, close)       # never stays up, whatever happens
    win.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
