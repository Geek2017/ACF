#!/bin/bash
# jobq — run a heavy command only when a slot is free; otherwise wait for one.
#
#   jobq [-c class] [--] command [args...]   run it in a <class> slot (default: heavy)
#   jobq --status                            who holds the slots, who is paused
#
# Slot counts come from ~/.config/autonice/rules ("slots <class> <N>").
# The slot stays taken until the command exits. autonice PAUSES gated
# background work that skips jobq; jobq waits politely instead.

RULES="${AUTONICE_RULES:-$HOME/.config/autonice/rules}"
RUN="${JOBQ_RUN:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/jobq}"
mkdir -p "$RUN"

slots_for() {   # slots_for <class> -> N (default 2)
    local n=
    [ -f "$RULES" ] && n=$(awk -v c="$1" '$1 == "slots" && $2 == c { print $3 }' "$RULES" | tail -n1)
    echo "${n:-2}"
}

holder() {   # holder <class.k> -> "pid command" of the job in that slot, if known
    local slot=$1 pid pp pids
    # Started via jobq: the slot is in its environment (and its children's); show the top one.
    pids=" $(grep -lsz "^JOBQ_SLOT=$slot\$" /proc/[0-9]*/environ | cut -d/ -f3 | tr '\n' ' ') "
    for pid in $pids; do
        pp=$(ps -o ppid= -p "$pid" | tr -d ' ')
        [[ "$pids" == *" $pp "* ]] && continue
        echo "$pid $(ps -o args= -p "$pid" | cut -c1-100)  (via jobq)"
        return
    done
    # Adopted by autonice on the job's behalf.
    awk -v s="$slot" '$2 == s { pid = $1; $1 = $2 = ""; print pid $0 "  (gated by autonice)"; exit }' "$RUN/held" 2>/dev/null
}

if [ "$1" = "--status" ]; then
    classes=$([ -f "$RULES" ] && awk '$1 == "slots" { print $2 }' "$RULES")
    for c in ${classes:-heavy}; do
        n=$(slots_for "$c")
        echo "$c: $n slots"
        for ((k = 1; k <= n; k++)); do
            if flock -n "$RUN/$c.$k" true; then
                echo "  slot $k: free"
            else
                h=$(holder "$c.$k"); echo "  slot $k: ${h:-taken}"
            fi
        done
    done
    if [ -s "$RUN/paused" ]; then
        echo
        echo "Paused by autonice, waiting for a slot:"
        while read -r pid start class; do
            echo "  $pid [$class] $(ps -o args= -p "$pid" | cut -c1-100)"
        done < "$RUN/paused"
    fi
    exit 0
fi

class=heavy
case "$1" in
    -c) class=$2; shift 2 ;;
    -h|--help|"") sed -n '2,9p' "$0"; exit 2 ;;
esac
[ "$1" = "--" ] && shift
[ $# -gt 0 ] || { echo "jobq: no command given" >&2; exit 2; }

n=$(slots_for "$class")
waited=
while :; do
    for ((k = 1; k <= n; k++)); do
        exec 9>"$RUN/$class.$k"
        if flock -n 9; then
            [ -n "$waited" ] && echo "jobq: got $class slot $k after ${SECONDS}s" >&2
            # fd 9 holds the lock; the command inherits it, so the slot lives as long as it does.
            export JOBQ_SLOT="$class.$k"
            exec "$@"
        fi
    done
    exec 9>&-
    [ -n "$waited" ] || echo "jobq: all $n $class slots busy, waiting (jobq --status shows who)" >&2
    waited=1
    sleep 2
done
