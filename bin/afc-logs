#!/usr/bin/env -S python3 -I
"""afc-logs: the ACF chat log. Every thread of every agent (Claude, Codex, Gemini, Antigravity),
copied from the files each tool already keeps on disk into the project the thread ran in.
No model is asked anything: it reads files, so it costs no tokens.

  afc-logs run [--dry-run] [--force] [--no-redact]   collect what is new (the timer runs this)
  afc-logs status [--all]                            threads, entries and size per project
  afc-logs threads [--all] [--today] [--tool T]      list threads (this project, or every project)
  afc-logs search WORDS [--all] [--tool T] [--since YYYY-MM-DD] [--limit N]
  afc-logs show THREAD                               print one thread (id, or the start of one)

Where it goes, per project:   <project>/logs/acf/acf.db                   searchable database
                              <project>/logs/acf/<date>_<tool>_<words>.md one readable file per thread
"Project" is the fleet project the agent ran in (~/.config/agents/projects), else the nearest
folder above with a .git, else the folder itself. Threads run in the home folder, temp or scratch
folders go to ~/logs/acf/. A git project gets "logs/acf/" added to its .gitignore.

Kept: prompts, replies, thinking where the tool saved it, every tool call and its output, text
attachments; images as a one-line note. Left out: Claude's raw API dumps (api-request*), which
repeat the whole conversation each turn, and UI bookkeeping records.

Secrets in the text (API keys, tokens, passwords, private keys) are replaced by [redacted] on the
way in; the tools' own files are never changed. --no-redact turns that off.

Outside the projects it keeps only: ~/.config/agents/log-projects (the folders that have a log)
and ~/.cache/acf-logs/ (which source files were read how far; no chat text). A run skips itself
when the machine's CPU or RAM is at 85% or more, unless --force.
"""
import datetime, fcntl, glob, hashlib, json, os, re, sqlite3, subprocess, sys, time

HOME = os.path.expanduser("~")
sys.path.insert(0, os.path.join(HOME, ".local/lib/afc"))
from pb import pb_all, pb_fields, pb_get, pb_strings, pb_text  # noqa: E402

CFG = f"{HOME}/.config/agents"
CACHE = os.environ.get("AFC_LOGS_CACHE") or f"{HOME}/.cache/acf-logs"
LIST = os.environ.get("AFC_LOGS_LIST") or f"{CFG}/log-projects"
HOME_PROJECT = os.environ.get("AFC_LOGS_HOME") or HOME
SUB = "logs/acf"
BUSY = 85
NOT_PROJECTS = ("/tmp", "/run", "/var", "/proc", "/dev", f"{HOME}/.cache", f"{HOME}/.config",
                f"{HOME}/.local", f"{HOME}/.claude")

# ---------------------------------------------------------------------------------------------
# secrets

REDACT = True
_SECRET_PATTERNS = [
    re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?-----END [A-Z0-9 ]*PRIVATE KEY-----", re.S),
    re.compile(r"\bsk-(?:ant-|proj-|live-|test-)?[A-Za-z0-9_-]{16,}"),
    re.compile(r"\bAIza[0-9A-Za-z_-]{30,}"),
    re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}"),
    re.compile(r"\bgithub_pat_[A-Za-z0-9_]{30,}"),
    re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\bsbp_[a-f0-9]{30,}"),
    re.compile(r"\bre_[A-Za-z0-9]{8,}_[A-Za-z0-9]{16,}"),
    re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"),
    re.compile(r"(?i)(?<=bearer )[A-Za-z0-9._~+/=-]{20,}"),
]
# NAME=value / "name": "value" where the name says it is a secret: keep the name, hide the value
_SECRET_ASSIGN = re.compile(
    r"""(?ix)
    (\b[A-Z0-9_.-]*(?:api[_-]?key|secret|token|passw(?:or)?d|passwd|access[_-]?key|private[_-]?key|
       client[_-]?secret|auth[_-]?key|credential)s?[A-Z0-9_.-]*["']?\s*[:=]\s*["']?)
    ([^\s"',;}{)]{6,})""")
_URL_PASSWORD = re.compile(r"(\b[a-z][a-z0-9+.-]*://[^:\s/@]+:)([^@\s/]{3,})(@)")


def redact(text):
    if not REDACT or not text:
        return text
    for p in _SECRET_PATTERNS:
        text = p.sub("[redacted]", text)
    text = _SECRET_ASSIGN.sub(lambda m: m.group(1) + ("[redacted]" if m.group(2) != "[redacted]" else m.group(2)), text)
    text = _URL_PASSWORD.sub(r"\1[redacted]\3", text)
    return text


# ---------------------------------------------------------------------------------------------
# small helpers

def iso(ts):
    """Any timestamp (ISO text, epoch seconds or milliseconds) -> ISO UTC text, or ''."""
    if ts in (None, ""):
        return ""
    try:
        if isinstance(ts, (int, float)) or (isinstance(ts, str) and ts.replace(".", "", 1).isdigit()):
            t = float(ts)
            if t > 1e12:
                t /= 1000
            return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        s = str(ts).replace("Z", "+00:00")
        return datetime.datetime.fromisoformat(s).astimezone(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (ValueError, OverflowError, OSError):
        return ""


def local(ts):
    if not ts:
        return ""
    try:
        return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d %H:%M")
    except ValueError:
        return ts


def jdump(v):
    try:
        return json.dumps(v, ensure_ascii=False, indent=1)
    except (TypeError, ValueError):
        return str(v)


def slug(text, n=6):
    words = re.findall(r"[A-Za-z0-9]+", text or "")
    return "-".join(words[:n])[:60].strip("-").lower()


def read_list(path):
    out = []
    try:
        for line in open(path):
            line = line.strip()
            if line.startswith("# closed"):         # a project closed with Alt+Q: still a project
                line = line.split(":", 1)[-1].strip()
            if not line or line.startswith("#"):
                continue
            out.append(line.split())
    except OSError:
        pass
    return out


def expand(p):
    return os.path.realpath(os.path.expanduser(p)) if p else p


# ---------------------------------------------------------------------------------------------
# which project a folder belongs to

_fleet = None


def fleet_dirs():
    global _fleet
    if _fleet is None:
        dirs = []
        for parts in read_list(f"{CFG}/projects"):
            if len(parts) >= 2:
                d = expand(" ".join(parts[1:]).replace("\\$", "$"))
                if d and d != HOME:
                    dirs.append(d)
        _fleet = sorted(set(dirs), key=len, reverse=True)
    return _fleet


MARKERS = (".git", "CLAUDE.md", "AGENTS.md", "_ai")
_ws = {}


def is_project(d):
    return d in fleet_dirs() or any(os.path.exists(os.path.join(d, m)) for m in MARKERS)


def is_workspace(d):
    """A folder that holds several projects (like 1InteliPhi): 3 or more children with a marker."""
    if d not in _ws:
        n = 0
        try:
            for e in os.scandir(d):
                if e.is_dir(follow_symlinks=False) and any(os.path.exists(os.path.join(e.path, m)) for m in MARKERS):
                    n += 1
                    if n >= 3:
                        break
        except OSError:
            pass
        _ws[d] = n >= 3
    return _ws[d]


def worktree_main(d):
    """For a git worktree (its .git is a file that names <main>/.git/worktrees/<name>): the main
    checkout it belongs to. The fleet gives a split its own worktree (agents --pane wt-...), and
    what an agent says there belongs in the log of the project it was split from."""
    g = os.path.join(d, ".git")
    try:
        if os.path.isfile(g):
            line = open(g).readline().strip()
            if line.startswith("gitdir:") and "/.git/worktrees/" in line:
                return os.path.realpath(line[7:].strip().split("/.git/worktrees/")[0])
    except OSError:
        pass
    return None


def project_for(cwd):
    """The project folder a thread belongs to: walk up from where the agent ran to the first folder
    that is a fleet project or carries a project marker (.git, CLAUDE.md, AGENTS.md, _ai). If that
    folder is a workspace of several projects and the agent ran deeper, the project is the
    workspace's child on the way (1InteliPhi/PC-Health/_tools -> 1InteliPhi/PC-Health). Home,
    temp, cache and config folders, and folders that no longer exist, go to the home log."""
    if not cwd:
        return HOME_PROJECT
    cwd = os.path.realpath(cwd)
    if cwd == HOME or not cwd.startswith("/") or any(cwd == p or cwd.startswith(p + "/") for p in NOT_PROJECTS):
        return HOME_PROJECT
    if not os.path.isdir(cwd):
        return HOME_PROJECT
    d, child = cwd, None
    while d not in ("/", HOME) and len(d) > 1:
        main = worktree_main(d)
        if main and main != d and os.path.isdir(main):
            return project_for(main)
        if is_project(d):
            if child and is_workspace(d):
                return child
            return d
        child, d = d, os.path.dirname(d)
    return cwd if os.access(cwd, os.W_OK) else HOME_PROJECT


# ---------------------------------------------------------------------------------------------
# accounts and where each tool keeps its chats

def accounts(tool):
    """[(account name, home folder)] from the fleet's lists, commented-out lines included (their
    chats still exist), plus the tool's default folder."""
    file = {"claude": "accounts", "codex": "accounts-codex", "gemini": "accounts-gemini", "agy": "accounts-agy"}[tool]
    out, seen = [], set()
    try:
        lines = open(f"{CFG}/{file}").read().splitlines()
    except OSError:
        lines = []
    for line in lines:
        line = line.strip()
        if line.startswith("#"):
            line = line.split(":", 1)[-1].strip() if ":" in line else ""
        parts = line.split()
        if len(parts) >= 2 and not parts[0].startswith("#"):
            d = expand(parts[1])
            if d and d not in seen:
                seen.add(d); out.append((parts[0], d))
    default = {"claude": f"{HOME}/.claude", "codex": f"{HOME}/.codex", "gemini": HOME, "agy": HOME}[tool]
    if expand(default) not in seen:
        out.append(("main" if tool != "claude" else "default", expand(default)))
    return out


def sources():
    """Every chat file on disk: (tool, account, path, parent thread or None)."""
    found = []
    for acct, cfg in accounts("claude"):
        root = f"{cfg}/projects"
        for p in glob.glob(f"{root}/*/*.jsonl"):
            found.append(("claude", acct, p, None))
        for p in glob.glob(f"{root}/*/*/subagents/**/*.jsonl", recursive=True):
            parent = os.path.relpath(p, root).split("/")[1]
            found.append(("claude", acct, p, f"claude:{parent}"))
    for acct, home in accounts("codex"):
        for p in glob.glob(f"{home}/sessions/*/*/*/rollout-*.jsonl"):
            found.append(("codex", acct, p, None))
    for acct, home in accounts("gemini"):
        for p in glob.glob(f"{home}/.gemini/tmp/*/chats/*.json*"):
            found.append(("gemini", acct, p, None))
    for p in glob.glob(f"{HOME}/.gemini-homes/*/.gemini/tmp/*/chats/*.json*"):
        found.append(("gemini", p.split("/.gemini-homes/")[1].split("/")[0], p, None))
    for acct, home in accounts("agy"):
        for p in glob.glob(f"{home}/.gemini/antigravity-cli/conversations/*.db"):
            found.append(("agy", acct, p, None))
    uniq, seen = [], set()
    for s in found:
        r = os.path.realpath(s[2])
        if r not in seen:
            seen.add(r); uniq.append(s)
    return uniq


# ---------------------------------------------------------------------------------------------
# the per-project store

SCHEMA = """
CREATE TABLE IF NOT EXISTS threads (
  id TEXT PRIMARY KEY, tool TEXT, account TEXT, cwd TEXT, title TEXT, parent TEXT,
  first_ts TEXT, last_ts TEXT, models TEXT, cost_usd REAL, tokens_in INTEGER, tokens_out INTEGER,
  md_file TEXT, source TEXT);
CREATE TABLE IF NOT EXISTS entries (
  id INTEGER PRIMARY KEY, thread TEXT, ts TEXT, kind TEXT, who TEXT, model TEXT, text TEXT, hash TEXT);
CREATE INDEX IF NOT EXISTS entries_thread ON entries(thread, id);
CREATE INDEX IF NOT EXISTS entries_hash ON entries(thread, hash);
CREATE TABLE IF NOT EXISTS usage (
  thread TEXT, msg TEXT, model TEXT, input INTEGER, output INTEGER, cache_read INTEGER, cache_write INTEGER,
  PRIMARY KEY (thread, msg));
CREATE TABLE IF NOT EXISTS sources (path TEXT PRIMARY KEY, thread TEXT, offset INTEGER, size INTEGER, mtime REAL);
CREATE VIRTUAL TABLE IF NOT EXISTS entries_fts USING fts5(text, content='entries', content_rowid='id');
"""


class Store:
    def __init__(self, project, dry=False):
        self.project = project
        self.dir = os.path.join(project, SUB)
        self.dry = dry
        self.db = None
        self.md_handles = {}
        self.added = 0

    def open(self):
        if self.db is not None or self.dry:
            return self
        os.makedirs(self.dir, exist_ok=True)
        path = os.path.join(self.dir, "acf.db")
        new = not os.path.exists(path)
        self.db = sqlite3.connect(path, timeout=30)
        self.db.execute("PRAGMA journal_mode=DELETE")   # not WAL: unreliable on the NTFS drive
        self.db.execute("PRAGMA synchronous=NORMAL")
        self.db.executescript(SCHEMA)
        if new:
            try:
                os.chmod(path, 0o600)
            except OSError:
                pass
            ignore_in_git(self.project)
            remember_project(self.project)
        return self

    def source(self, path):
        if self.dry:
            return None
        r = self.open().db.execute("SELECT offset, size, mtime, thread FROM sources WHERE path=?", (path,)).fetchone()
        return r

    def set_source(self, path, thread, offset, size, mtime):
        if not self.dry:
            self.db.execute("INSERT OR REPLACE INTO sources VALUES (?,?,?,?,?)", (path, thread, offset, size, mtime))

    def thread(self, tid, **cols):
        """Create or update a thread row; only the given columns change."""
        if self.dry:
            return
        db = self.open().db
        if db.execute("SELECT 1 FROM threads WHERE id=?", (tid,)).fetchone() is None:
            db.execute("INSERT INTO threads (id) VALUES (?)", (tid,))
        for k, v in cols.items():
            if v is None:
                continue
            if k == "first_ts":
                db.execute("UPDATE threads SET first_ts=? WHERE id=? AND (first_ts IS NULL OR first_ts='' OR first_ts>?)", (v, tid, v))
            elif k == "last_ts":
                db.execute("UPDATE threads SET last_ts=? WHERE id=? AND (last_ts IS NULL OR last_ts<?)", (v, tid, v))
            elif k == "model":
                row = db.execute("SELECT models FROM threads WHERE id=?", (tid,)).fetchone()
                have = [m for m in (row[0] or "").split(", ") if m]
                if v and v not in have:
                    db.execute("UPDATE threads SET models=? WHERE id=?", (", ".join(have + [v]), tid))
            elif k == "title_if_empty":
                db.execute("UPDATE threads SET title=? WHERE id=? AND (title IS NULL OR title='')", (v, tid))
            else:
                db.execute(f"UPDATE threads SET {k}=? WHERE id=?", (v, tid))

    def usage(self, tid, msg, model, inp, out, cr, cw):
        if self.dry or not msg:
            return
        self.open().db.execute(
            """INSERT INTO usage VALUES (?,?,?,?,?,?,?) ON CONFLICT(thread, msg) DO UPDATE SET
               input=max(input, excluded.input), output=max(output, excluded.output),
               cache_read=max(cache_read, excluded.cache_read), cache_write=max(cache_write, excluded.cache_write)""",
            (tid, msg, model, inp or 0, out or 0, cr or 0, cw or 0))

    def add(self, tid, ts, kind, who, model, text, dedupe=False):
        """One entry. dedupe: skip when the same text is already in this thread (repeated system prompts)."""
        if text is None or text == "":
            return
        text = redact(text)
        h = hashlib.sha1(text.encode("utf-8", "replace")).hexdigest()[:16] if dedupe else None
        self.added += 1
        if self.dry:
            return
        db = self.open().db
        if dedupe and db.execute("SELECT 1 FROM entries WHERE thread=? AND hash=?", (tid, h)).fetchone():
            self.added -= 1
            return
        cur = db.execute("INSERT INTO entries (thread, ts, kind, who, model, text, hash) VALUES (?,?,?,?,?,?,?)",
                         (tid, ts, kind, who, model, text, h))
        db.execute("INSERT INTO entries_fts (rowid, text) VALUES (?,?)", (cur.lastrowid, text))
        if kind == "user" and not text.lstrip().startswith(NOT_A_PROMPT):
            first = next((l.strip() for l in text.splitlines() if l.strip() and not l.strip().startswith(NOTES)), "")
            if first:
                self.thread(tid, title_if_empty=first[:90])
        self.md(tid, ts).write(md_entry(ts, kind, who, model, text))

    def clear(self, tid):
        """Remove a thread's entries (for tools whose files are rewritten, not appended)."""
        if self.dry:
            return
        db = self.open().db
        db.execute("INSERT INTO entries_fts (entries_fts, rowid, text) SELECT 'delete', id, text FROM entries WHERE thread=?", (tid,))
        db.execute("DELETE FROM entries WHERE thread=?", (tid,))
        db.execute("DELETE FROM usage WHERE thread=?", (tid,))
        name = db.execute("SELECT md_file FROM threads WHERE id=?", (tid,)).fetchone()
        if name and name[0]:
            f = self.md_handles.pop(tid, None)
            if f:
                f.close()
            try:
                os.remove(os.path.join(self.dir, name[0]))
            except OSError:
                pass
            db.execute("UPDATE threads SET md_file=NULL WHERE id=?", (tid,))

    def md(self, tid, ts=""):
        f = self.md_handles.get(tid)
        if f:
            return f
        db = self.db
        if ts:
            self.thread(tid, first_ts=ts)
        row = db.execute("SELECT md_file, tool, account, cwd, title, first_ts, parent FROM threads WHERE id=?", (tid,)).fetchone()
        name = row[0] if row else None
        if not name:
            tool, first = (row[1] if row else "chat"), (row[5] if row else "")
            first_prompt = db.execute("SELECT text FROM entries WHERE thread=? AND kind='user' ORDER BY id LIMIT 1", (tid,)).fetchone()
            words = slug(row[4] if row and row[4] else (first_prompt[0] if first_prompt else "")) or tid.split(":")[-1][:8]
            date = local(first)[:10] if first else datetime.date.today().isoformat()
            base = f"{date}_{tool}_{words}"
            name = base + ".md"
            n = 2
            while os.path.exists(os.path.join(self.dir, name)) or db.execute(
                    "SELECT 1 FROM threads WHERE md_file=? AND id<>?", (name, tid)).fetchone():
                name = f"{base}-{n}.md"; n += 1
            db.execute("UPDATE threads SET md_file=? WHERE id=?", (name, tid))
            new = True
        else:
            new = not os.path.exists(os.path.join(self.dir, name))
        f = open(os.path.join(self.dir, name), "a", encoding="utf-8")
        if new and row:
            f.write(f"# {row[4] or tid}\n\n"
                    f"- thread: `{tid}`{f' (inside `{row[6]}`)' if row[6] else ''}\n"
                    f"- tool: {row[1]}, account: {row[2]}\n- folder: `{row[3] or ''}`\n"
                    f"- started: {local(row[5])}\n\n"
                    "Copied by afc-logs from the tool's own files; secrets replaced by [redacted]. "
                    "Model, tokens and cost: `afc-logs threads`.\n\n---\n")
        self.md_handles[tid] = f
        return f

    def retitle(self, tid):
        """A thread's file was named and headed by its id because no title was known yet. Once one
        is (Claude's own title, or the first real prompt), rename the file and fix its first line."""
        if self.dry or self.db is None:
            return
        row = self.db.execute("SELECT md_file, title, tool, first_ts FROM threads WHERE id=?", (tid,)).fetchone()
        if not row or not row[0] or not row[1]:
            return
        old = os.path.join(self.dir, row[0])
        try:
            with open(old, encoding="utf-8") as f:
                first = f.readline()
        except OSError:
            return
        if first.strip() == f"# {row[1]}" or not (first.strip() == f"# {tid}" or first.startswith(("# [image", "# [document"))):
            return
        f = self.md_handles.pop(tid, None)
        if f:
            f.close()
        base = f"{local(row[3])[:10]}_{row[2]}_{slug(row[1]) or tid.split(':')[-1][:8]}"
        name, n = base + ".md", 2
        while os.path.exists(os.path.join(self.dir, name)) and name != row[0]:
            name = f"{base}-{n}.md"; n += 1
        new = os.path.join(self.dir, name)
        tmp = new + ".tmp"
        with open(old, encoding="utf-8") as src, open(tmp, "w", encoding="utf-8") as dst:
            src.readline()
            dst.write(f"# {row[1]}\n")
            while True:
                chunk = src.read(1 << 20)
                if not chunk:
                    break
                dst.write(chunk)
        os.replace(tmp, new)
        if new != old:
            os.remove(old)
        self.db.execute("UPDATE threads SET md_file=? WHERE id=?", (name, tid))

    def commit(self):
        for f in self.md_handles.values():
            f.flush()
        if self.db is not None:
            self.db.commit()

    def close(self):
        for f in self.md_handles.values():
            f.close()
        self.md_handles = {}
        if self.db is not None:
            self.db.commit()
            self.db.close()
            self.db = None


NOT_A_PROMPT = ("<", "# AGENTS.md", "[result ", "[call ", "Caveat:", "[Request interrupted")
NOTES = ("[image", "[document", "[tool ")     # placeholders, not words: never a title
LABEL = {"user": "You", "assistant": "AI", "thinking": "Thinking", "tool_call": "Tool call",
         "tool_result": "Tool result", "system": "System", "attachment": "Attachment"}


def fence(text):
    run = max((len(m) for m in re.findall(r"`{3,}", text)), default=2)
    return "`" * (run + 1)


def md_entry(ts, kind, who, model, text):
    head = f"\n### {local(ts)} · {LABEL.get(kind, kind)}"
    if who:
        head += f" · {who}"
    if kind == "assistant" and model:
        head += f" ({model})"
    if kind in ("user", "assistant"):
        return f"{head}\n\n{text}\n"
    if kind == "thinking":
        return f"{head}\n\n" + "\n".join("> " + l for l in text.splitlines()) + "\n"
    f = fence(text)
    return f"{head}\n\n{f}\n{text}\n{f}\n"


def ignore_in_git(project):
    """If the project is in a git repository and logs/acf is not ignored, add it to .gitignore."""
    try:
        top = subprocess.run(["git", "-C", project, "rev-parse", "--show-toplevel"], capture_output=True,
                             text=True, timeout=10)
        if top.returncode != 0:
            return
        probe = subprocess.run(["git", "-C", project, "check-ignore", "-q", f"{SUB}/acf.db"], timeout=10)
        if probe.returncode == 0:
            return
        gi = os.path.join(project, ".gitignore")
        tail = ""
        if os.path.exists(gi):
            with open(gi, "rb") as f:
                f.seek(0, 2)
                if f.tell():
                    f.seek(-1, 2)
                    tail = "" if f.read(1) == b"\n" else "\n"
        with open(gi, "a") as f:
            f.write(f"{tail}# ACF chat log (afc-logs): transcripts may hold private text\n{SUB}/\n")
    except (OSError, subprocess.SubprocessError):
        pass


def remember_project(project):
    try:
        have = set(open(LIST).read().splitlines())
    except OSError:
        have = set()
    if project not in have:
        os.makedirs(os.path.dirname(LIST), exist_ok=True)
        with open(LIST, "a") as f:
            f.write(project + "\n")


# ---------------------------------------------------------------------------------------------
# readers. Each takes (store getter, source, previous state) and returns the new state.

def text_of(content):
    """Claude / Codex / Gemini content (str, or list of blocks) -> plain text, images noted."""
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    if isinstance(content, dict):
        content = [content]
    out = []
    for b in content:
        if isinstance(b, str):
            out.append(b); continue
        if not isinstance(b, dict):
            continue
        t = b.get("type")
        if "text" in b and isinstance(b["text"], str):
            out.append(b["text"])
        elif t == "image" or t == "input_image" or "inlineData" in b:
            src = b.get("source") or b.get("inlineData") or {}
            size = len(src.get("data", "") or "") * 3 // 4 if isinstance(src, dict) else 0
            out.append(f"[image{f' {size / 1e6:.1f} MB' if size else ''}]")
        elif t == "document":
            out.append(f"[document {((b.get('source') or {}).get('media_type') or '')}]")
        elif t == "tool_reference":
            out.append(f"[tool {b.get('tool_name') or b.get('name') or ''}]")
        else:
            out.append(jdump(b))
    return "\n".join(x for x in out if x)


def iter_lines(path, box):
    """Complete lines from box[0] on, one at a time (big files are never loaded whole); box[0]
    follows along, so afterwards it is where the next run starts. A last line still being
    written (no newline yet) is left for next time."""
    with open(path, "rb") as f:
        f.seek(box[0])
        for raw in f:
            if not raw.endswith(b"\n"):
                break
            box[0] += len(raw)
            yield raw.decode("utf-8", "replace")


class Span:
    """First and last time seen in a batch, written to the thread once at the end."""
    def __init__(self):
        self.first = self.last = ""

    def see(self, ts):
        if ts:
            if not self.first or ts < self.first:
                self.first = ts
            if ts > self.last:
                self.last = ts

    def save(self, st, tid):
        if self.first:
            st.thread(tid, first_ts=self.first, last_ts=self.last)


def head_cwd(path, keys=("cwd",), limit=400):
    """The first cwd a JSONL file mentions."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for i, line in enumerate(f):
                if i >= limit:
                    break
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                for src in (d, d.get("payload") if isinstance(d.get("payload"), dict) else {}):
                    for k in keys:
                        if src.get(k):
                            return src[k]
    except OSError:
        pass
    return None


def claude_read(st, src, tid, offset):
    tool, acct, path, parent = src
    box, span, cwd_set, labels = [offset], Span(), False, {}
    for line in iter_lines(path, box):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        t = d.get("type")
        ts = iso(d.get("timestamp"))
        if t == "ai-title" and d.get("aiTitle"):
            st.thread(tid, title=d["aiTitle"])
            continue
        if t == "cost-state" and d.get("totalCostUSD") is not None:
            st.thread(tid, cost_usd=float(d["totalCostUSD"]))
            continue
        if t in ("launched", "started", "result") and path.endswith("/journal.jsonl"):
            # a workflow's journal: which sub-agent started, and what each returned
            if t == "started":
                labels[d.get("agentId")] = d.get("label")
                st.add(tid, ts, "system", "workflow", None, f"agent {d.get('agentId')} started: {d.get('label')} ({d.get('phase') or ''})")
            elif t == "result":
                st.add(tid, ts, "assistant", labels.get(d.get("agentId")) or d.get("agentId"), None,
                       d["result"] if isinstance(d.get("result"), str) else jdump(d.get("result")))
            continue
        if t not in ("user", "assistant", "attachment", "system"):
            continue
        span.see(ts)
        if d.get("cwd") and not cwd_set:
            st.thread(tid, cwd=d["cwd"]); cwd_set = True
        if t == "attachment":
            st.add(tid, ts, "attachment", None, None, jdump(d.get("attachment")))
            continue
        if t == "system":
            body = d.get("content") or d.get("stopReason") or ""
            info = {k: d[k] for k in ("subtype", "level", "hookInfos", "hookErrors", "hookAdditionalContext") if d.get(k)}
            st.add(tid, ts, "system", d.get("subtype"), None, "\n".join(x for x in (body if isinstance(body, str) else jdump(body), jdump(info) if info else "") if x))
            continue
        m = d.get("message") or {}
        content = m.get("content")
        if t == "user":
            kind = "system" if d.get("isMeta") else "user"
            if isinstance(content, str):
                st.add(tid, ts, kind, None, None, content)
                continue
            plain = []
            for b in content or []:
                if isinstance(b, dict) and b.get("type") == "tool_result":
                    if plain:
                        st.add(tid, ts, kind, None, None, text_of(plain)); plain = []
                    out = text_of(b.get("content"))
                    if b.get("is_error"):
                        out = "[error] " + out
                    st.add(tid, ts, "tool_result", None, None, out or "(no output)")
                else:
                    plain.append(b)
            if plain:
                st.add(tid, ts, kind, None, None, text_of(plain))
            continue
        # assistant
        model = m.get("model")
        if model and model != "<synthetic>":
            st.thread(tid, model=model)
        u = m.get("usage") or {}
        if u:
            st.usage(tid, m.get("id") or d.get("requestId"), model, u.get("input_tokens"), u.get("output_tokens"),
                     u.get("cache_read_input_tokens"), u.get("cache_creation_input_tokens"))
        for b in content if isinstance(content, list) else [{"type": "text", "text": content or ""}]:
            bt = b.get("type")
            if bt == "text":
                st.add(tid, ts, "assistant", "Claude", model, b.get("text"))
            elif bt == "thinking" and (b.get("thinking") or "").strip():
                st.add(tid, ts, "thinking", None, model, b["thinking"])
            elif bt in ("tool_use", "server_tool_use"):
                st.add(tid, ts, "tool_call", b.get("name"), model, jdump(b.get("input")))
            elif bt not in ("thinking", "redacted_thinking"):
                st.add(tid, ts, "system", bt, model, jdump(b))
    span.save(st, tid)
    return box[0]


def codex_read(st, src, tid, offset):
    box, span = [offset], Span()
    model = None
    for line in iter_lines(src[2], box):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        t, p = d.get("type"), d.get("payload") or {}
        ts = iso(d.get("timestamp") or p.get("timestamp"))
        span.see(ts)
        if t == "session_meta":
            st.thread(tid, cwd=p.get("cwd"))
            continue
        if t == "turn_context":
            model = p.get("model") or model
            st.thread(tid, model=model, cwd=p.get("cwd"))
            continue
        if t == "event_msg" and p.get("type") == "token_count":
            tot = (p.get("info") or {}).get("total_token_usage") or {}
            if tot:
                st.thread(tid, tokens_in=tot.get("input_tokens"), tokens_out=tot.get("output_tokens"))
            continue
        if t == "event_msg" and p.get("type") == "thread_settings_applied":
            m = (p.get("thread_settings") or {}).get("model")
            if m:
                model = m; st.thread(tid, model=m)
            continue
        if t != "response_item":
            continue
        pt = p.get("type")
        if pt == "message":
            role = p.get("role")
            text = text_of(p.get("content"))
            if role == "assistant":
                st.add(tid, ts, "assistant", "Codex", model, text)
            elif role == "user":
                st.add(tid, ts, "user", None, None, text, dedupe=text.startswith(("# AGENTS.md", "<environment_context", "<permissions")))
            else:
                st.add(tid, ts, "system", role, None, text, dedupe=True)
        elif pt in ("function_call", "custom_tool_call", "local_shell_call", "tool_search_call", "web_search_call"):
            body = p.get("arguments") or p.get("input") or p.get("action") or p
            if isinstance(body, str):
                try:
                    body = jdump(json.loads(body))
                except ValueError:
                    pass
            st.add(tid, ts, "tool_call", p.get("name") or pt, model, body if isinstance(body, str) else jdump(body))
        elif pt in ("function_call_output", "custom_tool_call_output", "local_shell_call_output", "tool_search_output"):
            st.add(tid, ts, "tool_result", None, None, text_of(p.get("output")) or "(no output)")
        elif pt == "reasoning":
            summ = text_of([s for s in (p.get("summary") or []) if isinstance(s, dict)])
            if summ.strip():
                st.add(tid, ts, "thinking", None, model, summ)
        elif pt in ("additional_tools", "configuration_update"):
            continue
        else:
            st.add(tid, ts, "system", pt, None, jdump(p))
    span.save(st, tid)
    return box[0]


def gemini_messages(path):
    """A Gemini chat file -> (header dict, ordered list of messages), with its $patch edits applied."""
    header, msgs, order, notes = {}, {}, [], []
    try:
        raw = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return header, []
    if path.endswith(".json"):
        try:
            d = json.loads(raw)
        except ValueError:
            return header, []
        return {k: v for k, v in d.items() if k != "messages"}, d.get("messages") or []
    for line in raw.splitlines():
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if "$set" in d:
            header.update(d["$set"] if isinstance(d["$set"], dict) else {})
        elif "$patch" in d:
            for u in (d["$patch"] or {}).get("updates", []) if isinstance(d["$patch"], dict) else []:
                i = u.get("id")
                if i in msgs:
                    msgs[i].update(u)
                elif i:
                    msgs[i] = dict(u); order.append(i)
        elif "$rewindTo" in d:
            continue        # a rewind in the UI; the log keeps what was said
        elif "sessionId" in d and "type" not in d:
            header.update(d)
        elif d.get("id"):
            if d["id"] in msgs:
                msgs[d["id"]].update(d)
            else:
                msgs[d["id"]] = d; order.append(d["id"])
    return header, [msgs[i] for i in order]


def gemini_read(st, src, tid, _offset):
    header, msgs = gemini_messages(src[2])
    st.clear(tid)
    root = os.path.join(os.path.dirname(os.path.dirname(src[2])), ".project_root")
    try:
        cwd = open(root).read().strip()
    except OSError:
        cwd = None
    st.thread(tid, cwd=cwd, first_ts=iso(header.get("startTime")), last_ts=iso(header.get("lastUpdated")))
    tin = tout = 0
    span = Span()
    for m in msgs:
        ts = iso(m.get("timestamp"))
        span.see(ts)
        t, model = m.get("type"), m.get("model")
        if model:
            st.thread(tid, model=model)
        if t == "user":
            parts = m.get("content") if isinstance(m.get("content"), list) else [m.get("content")]
            said = [p for p in parts if not (isinstance(p, dict) and "functionResponse" in p)]
            for p in parts:
                if isinstance(p, dict) and "functionResponse" in p:
                    st.add(tid, ts, "tool_result", p["functionResponse"].get("name"), None, gemini_text([p]))
            if said:
                body = gemini_text(said)
                # Gemini opens every chat with its own context message in the user's name: not something you said
                if body.lstrip().startswith("<session_context>"):
                    st.add(tid, ts, "system", "start-up context", None, body)
                else:
                    st.add(tid, ts, "user", None, None, body)
        elif t == "gemini":
            for th in m.get("thoughts") or []:
                st.add(tid, ts, "thinking", None, model,
                       "\n".join(x for x in (th.get("subject"), th.get("description")) if x) if isinstance(th, dict) else str(th))
            st.add(tid, ts, "assistant", "Gemini", model, gemini_text(m.get("content")))
            for tc in m.get("toolCalls") or []:
                st.add(tid, ts, "tool_call", tc.get("name") or tc.get("displayName"), model, jdump(tc.get("args")))
            tk = m.get("tokens") or {}
            tin += (tk.get("input") or 0); tout += (tk.get("output") or 0) + (tk.get("thoughts") or 0)
        else:
            st.add(tid, ts, "system", t, None, gemini_text(m.get("content")))
    st.thread(tid, tokens_in=tin, tokens_out=tout)
    span.save(st, tid)
    return os.path.getsize(src[2])


def gemini_text(content):
    if isinstance(content, list):
        out = []
        for p in content:
            if isinstance(p, dict):
                if "text" in p:
                    out.append(p["text"])
                elif "functionCall" in p:
                    out.append(f"[call {p['functionCall'].get('name')}] {jdump(p['functionCall'].get('args'))}")
                elif "functionResponse" in p:
                    r = p["functionResponse"]
                    out.append(f"[result {r.get('name')}] {text_of((r.get('response') or {}).get('output')) or jdump(r.get('response'))}")
                elif "inlineData" in p:
                    out.append("[image]")
                else:
                    out.append(jdump(p))
            else:
                out.append(str(p))
        return "\n".join(x for x in out if x)
    return text_of(content)


_ID = re.compile(r"^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32}|bot-[0-9a-f-]{36}|call_\d+|[A-Za-z0-9_-]{22})$")


def agy_strings(buf, skip=("5",)):
    return [s for _, s in pb_strings(buf, skip) if not _ID.match(s.strip()) and len(s.strip()) > 1]


def agy_read(st, src, tid, _offset):
    """One Antigravity conversation database -> the thread, rebuilt. Field numbers by inspection
    (2026-11-13): step type 14 = your message (19.2), 15 = reply (20.1 text, 20.3 thinking, 20.7
    tool calls: .2 name, .3 arguments), 132 = tool output (140), 17 = error (24.3.1), others are
    dumped as their readable strings. Step time: metadata 1.1 (epoch seconds)."""
    path = src[2]
    store = os.path.dirname(os.path.dirname(path))
    conv = os.path.basename(path)[:-3]
    title = cwd = None
    try:
        s = sqlite3.connect(f"file:{store}/conversation_summaries.db?mode=ro", uri=True, timeout=2)
        r = s.execute("SELECT title, workspace_uris FROM conversation_summaries WHERE conversation_id=?", (conv,)).fetchone()
        s.close()
        if r:
            title = r[0]
            uris = json.loads(r[1] or "[]")
            if uris:
                cwd = uris[0].replace("file://", "")
    except (sqlite3.Error, ValueError):
        pass
    st.clear(tid)
    st.thread(tid, title=title, cwd=cwd)
    try:
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5)
        steps = db.execute("SELECT idx, step_type, step_payload, metadata FROM steps ORDER BY idx").fetchall()
        gens = db.execute("SELECT data FROM gen_metadata ORDER BY idx").fetchall()
        db.close()
    except sqlite3.Error:
        return os.path.getsize(path)
    model = None
    tin = tout = 0
    for (data,) in gens:
        top = pb_get(data, 1)
        if not isinstance(top, bytes):
            continue
        label = pb_text(pb_get(top, 21))
        if label:
            model = label
        u = pb_get(top, 4)
        if isinstance(u, bytes):
            f = {n: v for n, v in pb_fields(u) if isinstance(v, int)}
            tin += f.get(2, 0) + f.get(5, 0); tout += f.get(3, 0)
    if model:
        st.thread(tid, model=model)
    st.thread(tid, tokens_in=tin, tokens_out=tout)
    span = Span()
    for idx, stype, payload, meta in steps:
        ts = iso(pb_get(meta or b"", 1, 1))
        span.see(ts)
        payload = payload or b""
        if stype == 14:
            st.add(tid, ts, "user", None, None, pb_text(pb_get(payload, 19, 2)) or "\n".join(agy_strings(payload)))
        elif stype == 15:
            r = pb_get(payload, 20) or b""
            st.add(tid, ts, "thinking", None, model, pb_text(pb_get(r, 3)))
            st.add(tid, ts, "assistant", "Antigravity", model, pb_text(pb_get(r, 1)))
            for call in pb_all(r, 7):
                args = pb_text(pb_get(call, 3)) or ""
                try:
                    args = jdump(json.loads(args))
                except ValueError:
                    pass
                st.add(tid, ts, "tool_call", pb_text(pb_get(call, 2)), model, args)
        elif stype == 132:
            st.add(tid, ts, "tool_result", None, None, "\n".join(agy_strings(payload)) or "(no output)")
        elif stype == 17:
            st.add(tid, ts, "system", "error", None, pb_text(pb_get(payload, 24, 3, 1)) or "\n".join(agy_strings(payload)))
        else:
            txt = "\n".join(agy_strings(payload))
            if txt:
                st.add(tid, ts, "system", f"step {stype}", None, txt)
    span.save(st, tid)
    return os.path.getsize(path)


READ = {"claude": claude_read, "codex": codex_read, "gemini": gemini_read, "agy": agy_read}
APPEND = {"claude", "codex"}      # their files only grow; Gemini and Antigravity are re-read when changed


def thread_id(src):
    tool, _, path, parent = src
    base = os.path.basename(path)
    if tool == "claude":
        if parent is None:
            return f"claude:{base[:-6]}"
        name = base[:-6]
        if not name.startswith("agent-"):     # e.g. workflows/wf_x/journal.jsonl: one per workflow, not unique alone
            name = path.split("/subagents/", 1)[-1][:-6]
        return f"claude:{name}@{parent.split(':', 1)[1][:8]}"
    if tool == "codex":
        m = re.search(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", base)
        return f"codex:{m.group(1) if m else base}"
    if tool == "gemini":
        return f"gemini:{base.rsplit('.', 1)[0]}"
    return f"agy:{base[:-3]}"


def src_cwd(src):
    tool, _, path, parent = src
    if tool == "claude":
        cwd = head_cwd(path)
        if not cwd and parent:      # a workflow journal carries no folder: use its parent thread's
            session = path.split("/subagents/", 1)[0]
            cwd = head_cwd(session + ".jsonl")
        return cwd
    if tool == "codex":
        return head_cwd(path)
    if tool == "gemini":
        try:
            return open(os.path.join(os.path.dirname(os.path.dirname(path)), ".project_root")).read().strip()
        except OSError:
            return None
    store = os.path.dirname(os.path.dirname(path))
    try:
        s = sqlite3.connect(f"file:{store}/conversation_summaries.db?mode=ro", uri=True, timeout=2)
        r = s.execute("SELECT workspace_uris FROM conversation_summaries WHERE conversation_id=?",
                      (os.path.basename(path)[:-3],)).fetchone()
        s.close()
        uris = json.loads(r[0]) if r and r[0] else []
        return uris[0].replace("file://", "") if uris else None
    except (sqlite3.Error, ValueError):
        return None


# ---------------------------------------------------------------------------------------------
# run

def machine_busy():
    def cpu():
        with open("/proc/stat") as f:
            v = [int(x) for x in f.readline().split()[1:]]
        return sum(v[:3]) + sum(v[5:8]), sum(v[:8])
    b0, t0 = cpu(); time.sleep(1); b1, t1 = cpu()
    c = 100 * (b1 - b0) // max(t1 - t0, 1)
    mem = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":", 1); mem[k] = int(v.split()[0])
    r = 100 * (mem["MemTotal"] - mem["MemAvailable"]) // mem["MemTotal"]
    return (c, r) if c >= BUSY or r >= BUSY else None


def run(dry=False, force=False):
    os.makedirs(CACHE, exist_ok=True)
    lock = open(os.path.join(CACHE, "run.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("another afc-logs run is going; leaving it to that one")
        return 0
    if not force and not dry:
        busy = machine_busy()
        if busy:
            print(f"machine busy (CPU {busy[0]}%, RAM {busy[1]}%): skipped, next timer will try again")
            return 0
    state_file = os.path.join(CACHE, "state.json")
    try:
        state = json.load(open(state_file))
    except (OSError, ValueError):
        state = {}
    t0 = time.time()
    stores, per_tool, per_project = {}, {}, {}
    todo = []
    for src in sources():
        path = src[2]
        try:
            stt = os.stat(path)
        except OSError:
            continue
        prev = state.get(path)
        if prev and prev.get("size") == stt.st_size and prev.get("mtime") == stt.st_mtime:
            continue
        todo.append((src, stt, prev))
    todo.sort(key=lambda x: x[1].st_mtime)
    done = 0
    for src, stt, prev in todo:
        tool, acct, path, parent = src
        project = (prev or {}).get("project") or project_for(src_cwd(src))
        st = stores.get(project)
        if st is None:
            st = stores[project] = Store(project, dry)
        tid = thread_id(src)
        row = st.source(path)
        offset = row[0] if row and tool in APPEND else 0
        if tool in APPEND and row and stt.st_size < (row[1] or 0):
            offset = 0           # file was rewritten smaller: read it again from the start
        before = st.added
        st.thread(tid, tool=tool, account=acct, parent=parent, source=path)
        try:
            new_offset = READ[tool](st, src, tid, offset) if not dry else dry_count(src, offset)
        except (OSError, ValueError, sqlite3.Error) as e:
            print(f"  skipped {path}: {e}", file=sys.stderr)
            continue
        if dry:
            st.added += new_offset
        else:
            st.set_source(path, tid, new_offset, stt.st_size, stt.st_mtime)
            st.retitle(tid)
            st.commit()
            state[path] = {"size": stt.st_size, "mtime": stt.st_mtime, "project": project}
        n = st.added - before
        per_tool[tool] = per_tool.get(tool, 0) + n
        per_project.setdefault(project, [0, 0])
        per_project[project][0] += 1
        per_project[project][1] += n
        done += 1
        if not dry and done % 50 == 0:
            save_state(state_file, state)
            for s in stores.values():
                s.close()
    for s in stores.values():
        s.close()
    if not dry:
        save_state(state_file, state)
    took = time.time() - t0
    verb = "would add" if dry else "added"
    print(f"{'DRY RUN: ' if dry else ''}{done} changed source file(s), {verb} {sum(per_tool.values())} entries in {took:.1f}s")
    for t, n in sorted(per_tool.items()):
        print(f"  {t:7s} {n} entries")
    for p, (files, n) in sorted(per_project.items(), key=lambda x: -x[1][1]):
        print(f"  -> {os.path.join(p, SUB)}  ({files} file(s), {n} entries)")
    return 0


def dry_count(src, offset):
    """Rough count of records a dry run would turn into entries."""
    tool, _, path, _ = src
    if tool in APPEND:
        n = 0
        with open(path, "rb") as f:
            f.seek(offset)
            for line in f:
                if b'"type":"user"' in line or b'"type":"assistant"' in line or b'"response_item"' in line \
                        or b'"type": "user"' in line or b'"type": "assistant"' in line:
                    n += 1
        return n
    if tool == "gemini":
        return len(gemini_messages(path)[1])
    try:
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=2)
        n = db.execute("SELECT count(*) FROM steps").fetchone()[0]
        db.close()
        return n
    except sqlite3.Error:
        return 0


def save_state(path, state):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, path)


# ---------------------------------------------------------------------------------------------
# reading the log

def project_here():
    return project_for(os.getcwd())


def all_projects():
    try:
        return [p for p in open(LIST).read().splitlines() if p and os.path.exists(os.path.join(p, SUB, "acf.db"))]
    except OSError:
        return []


def open_db(project):
    path = os.path.join(project, SUB, "acf.db")
    if not os.path.exists(path):
        return None
    db = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=10)
    return db


def targets(args):
    return all_projects() if "--all" in args else [project_here()]


def opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def fmt_tokens(n):
    n = n or 0
    return f"{n / 1e6:.1f}M" if n >= 1e6 else f"{n / 1e3:.0f}k" if n >= 1e3 else str(n)


def cmd_status(args):
    projects = targets(args) if "--all" in args or os.path.exists(os.path.join(project_here(), SUB, "acf.db")) else all_projects()
    total = [0, 0, 0]
    for p in projects:
        db = open_db(p)
        if not db:
            print(f"{p}: no log yet"); continue
        th = db.execute("SELECT tool, count(*) FROM threads GROUP BY tool").fetchall()
        n = db.execute("SELECT count(*) FROM entries").fetchone()[0]
        size = sum(os.path.getsize(os.path.join(p, SUB, f)) for f in os.listdir(os.path.join(p, SUB)))
        last = db.execute("SELECT max(last_ts) FROM threads").fetchone()[0]
        print(f"{p}\n  {', '.join(f'{t} {c}' for t, c in th)} threads | {n} entries | {size / 1e6:.0f} MB | newest {local(last)}")
        total[0] += sum(c for _, c in th); total[1] += n; total[2] += size
        db.close()
    try:
        ran = time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(os.path.join(CACHE, "state.json"))))
    except OSError:
        ran = "never"
    print(f"\n{len(projects)} project(s): {total[0]} threads, {total[1]} entries, {total[2] / 1e6:.0f} MB. Last run: {ran}")
    return 0


def cmd_threads(args):
    tool = opt(args, "--tool")
    for p in targets(args):
        db = open_db(p)
        if not db:
            continue
        q = """SELECT t.id, t.tool, t.account, t.title, t.first_ts, t.last_ts, t.models, t.cost_usd,
                      coalesce(t.tokens_in, (SELECT sum(input+cache_read+cache_write) FROM usage u WHERE u.thread=t.id)),
                      coalesce(t.tokens_out, (SELECT sum(output) FROM usage u WHERE u.thread=t.id)),
                      (SELECT count(*) FROM entries e WHERE e.thread=t.id), t.parent
               FROM threads t WHERE 1=1"""
        par = []
        if tool:
            q += " AND t.tool=?"; par.append(tool)
        if "--today" in args:
            q += " AND t.last_ts>=?"; par.append(datetime.datetime.now().astimezone().replace(hour=0, minute=0, second=0).astimezone(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
        if "--subagents" not in args:
            q += " AND t.parent IS NULL"
        q += " ORDER BY t.last_ts DESC"
        rows = db.execute(q, par).fetchall()
        if not rows:
            continue
        print(f"== {p}")
        for r in rows:
            cost = f" ${r[7]:.2f}" if r[7] else ""
            print(f"  {local(r[5])}  {r[1]:6s} {r[0].split(':', 1)[1][:8]}  {(r[3] or '(untitled)')[:60]:60s} "
                  f"{(r[6] or '')[:30]}  in {fmt_tokens(r[8])} out {fmt_tokens(r[9])}{cost}  [{r[10]} entries]")
        db.close()
    return 0


def cmd_search(args):
    words = [a for i, a in enumerate(args) if not a.startswith("--") and (i == 0 or args[i - 1] not in ("--tool", "--since", "--limit"))]
    if not words:
        print("usage: afc-logs search WORDS [--all] [--tool T] [--since YYYY-MM-DD] [--limit N]"); return 2
    match = " ".join('"' + w.replace('"', '""') + '"' for w in words)
    tool, since, limit = opt(args, "--tool"), opt(args, "--since"), int(opt(args, "--limit", "30"))
    shown = 0
    for p in targets(args):
        db = open_db(p)
        if not db:
            continue
        q = """SELECT e.ts, t.tool, e.thread, t.title, e.kind, snippet(entries_fts, 0, '[', ']', ' … ', 18)
               FROM entries_fts JOIN entries e ON e.id = entries_fts.rowid JOIN threads t ON t.id = e.thread
               WHERE entries_fts MATCH ?"""
        par = [match]
        if tool:
            q += " AND t.tool=?"; par.append(tool)
        if since:
            q += " AND e.ts>=?"; par.append(since)
        q += " ORDER BY e.ts DESC LIMIT ?"; par.append(limit - shown)
        try:
            rows = db.execute(q, par).fetchall()
        except sqlite3.Error as e:
            print(f"{p}: {e}"); continue
        if rows:
            print(f"== {p}")
        for ts, t, th, title, kind, snip in rows:
            print(f"  {local(ts)}  {t:6s} {th.split(':', 1)[1][:8]}  {LABEL.get(kind, kind):11s} {snip.replace(chr(10), ' ')[:170]}")
            print(f"      in: {(title or '(untitled)')[:80]}")
        shown += len(rows)
        db.close()
        if shown >= limit:
            break
    if not shown:
        print("no match")
    return 0


def cmd_show(args):
    if not args:
        print("usage: afc-logs show THREAD"); return 2
    want = args[0]
    for p in all_projects() or [project_here()]:
        db = open_db(p)
        if not db:
            continue
        r = db.execute("SELECT id, md_file FROM threads WHERE id=? OR id LIKE ? ORDER BY last_ts DESC LIMIT 1",
                       (want, f"%:{want}%")).fetchone()
        if r:
            if r[1] and os.path.exists(os.path.join(p, SUB, r[1])):
                print(f"(file: {os.path.join(p, SUB, r[1])})\n")
                sys.stdout.write(open(os.path.join(p, SUB, r[1]), encoding="utf-8").read())
            else:
                for ts, kind, who, model, text in db.execute(
                        "SELECT ts, kind, who, model, text FROM entries WHERE thread=? ORDER BY id", (r[0],)):
                    sys.stdout.write(md_entry(ts, kind, who, model, text))
            return 0
        db.close()
    print(f"no thread matching {want}")
    return 1


def main(argv):
    global REDACT
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); return 0
    cmd, args = argv[0], argv[1:]
    if "--no-redact" in args:
        REDACT = False
    try:
        if cmd == "run":
            return run(dry="--dry-run" in args, force="--force" in args)
        if cmd == "status":
            return cmd_status(args)
        if cmd == "threads":
            return cmd_threads(args)
        if cmd == "search":
            return cmd_search(args)
        if cmd == "show":
            return cmd_show(args)
    except BrokenPipeError:
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
