[Unit]
Description=Capped CPU group for AI agents and builds (autonice moves them here)

[Slice]
# 100% = one core. The fleet gets at most this much of your 6 cores, no matter how much work it starts.
# Change the number and run: systemctl --user daemon-reload
# 2026-11-24: raised to 350% (3.5 cores) for an 8-agent fleet. Safe because smiusbdisplay.service
# runs at CPUWeight=20 (yields under contention) and agents stay at NI=10 + IOWeight=30.
CPUQuota=350%

# Memory: slow a runaway agent down at 12 GB, kill it alone at 13 GB — before
# it can eat the whole 24 GB and take the desktop down (OpenCode did this once).
# 2026-11-24: raised from 10/11 to 12/13 for 8 concurrent panes (leaves ~10 GB for desktop/Brave
# with global playwright-mcp disabled). Do not go higher without measuring what's left.
MemoryHigh=12G
MemoryMax=13G

# Swap: at most 1 GB. Without this the overflow past 8 GB went to swap instead,
# filled it, and froze the whole desktop (2026-10-22). Now a runaway agent hits
# 13 GB fast and is killed alone.
MemorySwapMax=1G

# Processes: at most 3500 (threads count too; 8 busy panes with builds/tests can cross 2500).
# Raised from 2500 on 2026-11-24 for the 8-agent fleet; still stops a runaway fork pile-up
# (like the 12,700 pile-up on 2026-11-21) well before filling RAM.
TasksMax=3500

# Disk: the fleet's reads and writes yield to the desktop's (default weight is 100). Added 2026-11-21.
# INERT until two root-side pieces are in place, because without them the kernel ignores it:
#   1. the io controller handed to the user session (/etc/systemd/system/user@.service.d/delegate-io.conf)
#   2. the BFQ disk scheduler on sda/sdb (mq-deadline has no weights)
# Both take effect after a reboot. Check: cat .../agents.slice/io.weight exists and reads 30.
IOWeight=30
