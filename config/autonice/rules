# autonice rules — background work gets lower CPU priority automatically.
#
# Format:  <priority>  <pattern>
#   priority: 0 = normal, 19 = lowest (only runs when nothing else needs the CPU)
#   pattern:  extended regex matched against the full command line
#
# Children inherit priority, so anything an agent starts (tests, builds)
# is lowered too. Things NOT listed here (desktop, Zed window, browser)
# keep normal priority. Edit freely; changes apply within a few seconds.

# --- Heavy jobs: tests, builds, installs -> lowest ---
19  node( .*)? --test
19  (^|/)(npm|pnpm|yarn|bun|npx)( |$)
19  (^|/)(jest|vitest|mocha|pytest|tsc|esbuild|webpack|rollup)( |$)
19  vite( .*)? build
19  (^|/)(cargo|rustc|make|cc1|cc1plus|ld|gcc|g\+\+|clang)( |$)
19  (^|/)pip3?( |$)
# Video / TTS / headless browser workers -> lowest CPU + idle-only disk
19  (^|/)(ffmpeg|ffprobe|piper|whisper)( |$)
19  ^[^ ]*(chrome|chromium)[^ ]* (.* )?--headless

# --- AI agents and background helpers -> low ---
10  claude-agent-acp
10  (^|/)claude( |$)
10  (^|/)(opencode|codex|gemini|goose|copilot|agy)( |$)
# Zed agent panel: Codex, Mistral Vibe, and Gemini when started as gemini.js
10  codex-acp
10  vibe-acp
10  /gemini\.js( |$)
10  s4_tunnel\.py

# --- Slot gate: heavy jobs WAIT their turn instead of all running at once ---
# The priority rules above only slow work down; everything still starts and
# sits in RAM. The gate caps how many run at once:
#   slots <class> <N>        at most N jobs of that class at a time
#   gate  <class> <pattern>  a match takes a slot; if none is free, autonice
#                            PAUSES it and resumes it when a slot frees
# Patterns match from the START of the command line (the program itself), so
# a command that merely mentions a test file or "next dev" is not caught.
# Only background work is gated; anything running in a terminal is left alone.
# Wait politely instead of being paused:  jobq <command>    (jobq -c dev ...)
# See who holds what:                      jobq --status
slots heavy 2
slots dev   3

# tests, e2e, builds, headless browsers
gate heavy  ^[^ ]*node( -[^ ]+)* --test( |$)
gate heavy  ^[^ ]*(node|bun)( -[^ ]+)* [^ ]*/@?(jest|vitest|mocha|playwright)([./][^ ]*)?( |$)
gate heavy  ^[^ ]*python[0-9.]*( -m)? [^ ]*pytest( |$)
gate heavy  ^[^ ]*(node|bun|tsx)( -[^ ]+)* [^ ]*e2e[^ /]*\.(mjs|cjs|js|ts)( |$)
gate heavy  ^[^ ]*node( -[^ ]+)* [^ ]*/(next|vite)([./][^ ]*)? build( |$)
gate heavy  ^[^ ]*node( -[^ ]+)* [^ ]*/(tsc|webpack|rollup)( |$)
gate heavy  ^[^ ]*cargo (build|test|run)( |$)
gate heavy  ^[^ ]*(chrome|chromium)[^ ]* (.* )?--headless

# dev servers (each one holds ~1 GB for as long as it runs)
gate dev    ^[^ ]*node( -[^ ]+)* [^ ]*/next([./][^ ]*)? dev( |$)
gate dev    ^[^ ]*node( -[^ ]+)* [^ ]*/vite(\.js)?( (dev|serve)( |$)| --|$)

# --- Idle stop: a dev server nobody uses is stopped ---
#   idle <class> <time>   a job of that gate class that did no work at all for
#                         that long is stopped (3h, 90m, 45s; a bare number is
#                         minutes). Work = any CPU use: a page load, a rebuild
#                         after a file change. A server at rest uses none.
#                         Servers started in a terminal are watched too.
# Remove the line to turn it off.  See the clocks:  autonice --status
idle dev 3h

# --- Duplicate stop: one dev server per project folder ---
#   single <class> <time> [port]   a second job of that gate class started in a
#                           folder that already has one is stopped once it has
#                           sat beside the first for that long (the wait lets a
#                           restart through). The first one stays, whatever
#                           port the second asks for. The stopped one is told
#                           why on its own output.
#                           With the word "port" after the time, a second
#                           server on a port of its own (-p 3217) is allowed.
# Keep the time on the line. Remove the line to turn it off.
single dev 10s

# --- Turn stop: an agent's dev server ends with the agent's reply ---
#   turn <class> <time>   a job of that gate class that a Claude agent in a
#                         fleet pane started is stopped once that agent's reply
#                         has ended for that long. It is kept while any agent
#                         at work sits in the same project folder, and while
#                         the agent waits for your permission. A server you
#                         start yourself (typed in a pane or a terminal) and
#                         one from outside the fleet are never touched.
#                         See whose is whose:  autonice --status
# Remove the line to turn it off.
turn dev 20s

# The express lane (agents-express.slice, Alt+E / agents --express): its jobs use these slots instead,
# so they never wait behind the fleet's jobs, but a tab on the lane still cannot run them all at once.
slots heavy-x 1
slots dev-x   1
